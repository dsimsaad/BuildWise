@{
    ViewData["Title"] = "Construction";
    Layout = "_ModuleLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/modules.css" asp-append-version="true">
    <style>
        .construction-board {
            display: grid;
            gap: 20px;
        }

        .construction-hero {
            background: linear-gradient(135deg, #FFFFFF 0%, #F8FBFF 64%, #F0FDFA 100%);
            border: 1px solid #D6E3F5;
            border-radius: 8px;
            box-shadow: 0 10px 30px -26px rgba(15, 23, 42, 0.5), 0 1px 4px rgba(29, 78, 216, 0.05);
            padding: 22px;
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(260px, 340px);
            gap: 22px;
            align-items: center;
        }

        .construction-eyebrow {
            color: #64748B;
            font-size: 0.78rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-bottom: 6px;
        }

        .construction-title {
            margin: 0;
            color: #0F172A;
            font-size: 1.65rem;
            line-height: 1.15;
            font-weight: 800;
        }

        .construction-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 14px;
        }

        .construction-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.82);
            border: 1px solid #D6E3F5;
            color: #475569;
            padding: 6px 9px;
            font-size: 0.78rem;
            font-weight: 700;
        }

        .overall-progress-panel {
            border: 1px solid #BFDBFE;
            background: rgba(255, 255, 255, 0.9);
            border-radius: 8px;
            padding: 16px;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
        }

        .overall-progress-number {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 14px;
            margin-bottom: 12px;
        }

        .overall-progress-number strong {
            color: #0F172A;
            font-size: 2rem;
            line-height: 1;
        }

        .overall-progress-number span {
            color: #64748B;
            font-size: 0.78rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .construction-progress-track {
            height: 10px;
            background: #E2E8F0;
            border-radius: 999px;
            overflow: hidden;
        }

        .construction-progress-fill {
            height: 100%;
            width: 0;
            border-radius: inherit;
            background: linear-gradient(90deg, #2563EB, #14B8A6);
            transition: width 0.35s ease;
        }

        .construction-stats {
            display: grid;
            grid-template-columns: repeat(6, minmax(0, 1fr));
            gap: 14px;
        }

        .construction-stat {
            background: #FFFFFF;
            border: 1px solid #D6E3F5;
            border-radius: 8px;
            padding: 15px 16px;
            box-shadow: 0 8px 24px -22px rgba(15, 23, 42, 0.42), 0 1px 4px rgba(29, 78, 216, 0.04);
            min-width: 0;
            position: relative;
            overflow: hidden;
        }

        .construction-stat::before {
            content: "";
            position: absolute;
            inset: 0 0 auto 0;
            height: 3px;
            background: #2563EB;
        }

        .construction-stat:nth-child(2)::before { background: #14B8A6; }
        .construction-stat:nth-child(3)::before { background: #8B5CF6; }
        .construction-stat:nth-child(4)::before { background: #10B981; }
        .construction-stat:nth-child(5)::before { background: #EF4444; }
        .construction-stat:nth-child(6)::before { background: #F59E0B; }

        .construction-stat span,
        .construction-stat strong {
            position: relative;
        }

        .construction-stat span {
            display: block;
            color: #64748B;
            font-size: 0.72rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-bottom: 8px;
            white-space: nowrap;
        }

        .construction-stat strong {
            display: block;
            color: #0F172A;
            font-size: 1.35rem;
            line-height: 1.1;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .construction-layout {
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            gap: 18px;
            align-items: start;
        }

        .phase-stack {
            display: grid;
            gap: 14px;
        }

        .phase-panel {
            background: #FFFFFF;
            border: 1px solid #D6E3F5;
            border-radius: 8px;
            box-shadow: 0 8px 24px -22px rgba(15, 23, 42, 0.42), 0 1px 4px rgba(29, 78, 216, 0.04);
            overflow: hidden;
            transition: border-color 0.16s ease, box-shadow 0.16s ease, transform 0.16s ease;
        }

        .phase-panel.is-dragging {
            opacity: 0.68;
            transform: scale(0.995);
        }

        .phase-panel.is-drag-over {
            border-color: #2563EB;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08), 0 12px 28px -22px rgba(37, 99, 235, 0.48);
        }

        .phase-panel.is-order-saving {
            border-color: #BFDBFE;
        }

        .phase-panel-header {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 16px;
            padding: 16px 18px;
            border-bottom: 1px solid #E2E8F0;
            background: linear-gradient(180deg, #FFFFFF 0%, #F8FBFF 100%);
        }

        .phase-title-row {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
        }

        .phase-priority {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            background: #EFF6FF;
            color: #1D4ED8;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            flex: 0 0 auto;
        }

        .phase-drag-handle {
            width: 38px;
            height: 32px;
            border: 1px solid #BFDBFE;
            border-radius: 8px;
            background: #EFF6FF;
            color: #1D4ED8;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: grab;
            flex: 0 0 auto;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.75);
            transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
            touch-action: none;
        }

        .phase-drag-handle:hover,
        .phase-drag-handle:focus {
            color: #1E40AF;
            border-color: #93C5FD;
            background: #DBEAFE;
            box-shadow: 0 4px 12px rgba(29, 78, 216, 0.12);
            outline: none;
        }

        .phase-drag-handle svg {
            width: 15px;
            height: 15px;
        }

        .phase-drag-handle:active {
            cursor: grabbing;
        }

        .phase-title {
            color: #0F172A;
            font-size: 1rem;
            font-weight: 800;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .phase-subline {
            margin-top: 8px;
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            color: #64748B;
            font-size: 0.78rem;
            font-weight: 600;
        }

        .phase-panel-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 8px;
            flex-wrap: wrap;
        }

        .phase-progress {
            min-width: 190px;
            margin-top: 12px;
        }

        .phase-progress-label {
            display: flex;
            justify-content: space-between;
            color: #64748B;
            font-size: 0.76rem;
            font-weight: 800;
            margin-bottom: 6px;
        }

        .task-table-wrap {
            overflow-x: auto;
        }

        .task-table {
            width: 100%;
            border-collapse: collapse;
        }

        .task-table th {
            text-align: left;
            color: #94A3B8;
            font-size: 0.7rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            padding: 11px 16px;
            border-bottom: 1px solid #F1F5F9;
            white-space: nowrap;
        }

        .task-table td {
            padding: 13px 16px;
            border-bottom: 1px solid #F8FAFC;
            color: #334155;
            font-size: 0.85rem;
            vertical-align: middle;
        }

        .task-table tr:last-child td {
            border-bottom: 0;
        }

        .task-name-cell strong {
            display: block;
            color: #0F172A;
            font-size: 0.9rem;
            margin-bottom: 3px;
        }

        .task-name-cell small {
            display: block;
            color: #64748B;
            max-width: 340px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .task-actions-row {
            display: flex;
            gap: 6px;
            align-items: center;
            justify-content: flex-end;
            white-space: nowrap;
        }

        .mini-action {
            border: 1px solid #E2E8F0;
            background: #FFFFFF;
            color: #334155;
            border-radius: 6px;
            padding: 6px 9px;
            font-size: 0.74rem;
            font-weight: 800;
            cursor: pointer;
        }

        .mini-action:hover {
            background: #F8FAFC;
        }

        .mini-action.primary {
            color: #1D4ED8;
            border-color: #BFDBFE;
            background: #EFF6FF;
        }

        .mini-action.success {
            color: #047857;
            border-color: #A7F3D0;
            background: #ECFDF5;
        }

        .mini-action.danger {
            color: #B91C1C;
            border-color: #FECACA;
            background: #FEF2F2;
        }

        .timeline-panel {
            background: #FFFFFF;
            border: 1px solid #D6E3F5;
            border-radius: 8px;
            padding: 18px;
            box-shadow: 0 8px 24px -22px rgba(15, 23, 42, 0.42), 0 1px 4px rgba(29, 78, 216, 0.04);
        }

        .timeline-head {
            display: flex;
            justify-content: space-between;
            gap: 14px;
            align-items: center;
            margin-bottom: 14px;
        }

        .timeline-head h2 {
            margin: 0;
            color: #0F172A;
            font-size: 1rem;
            font-weight: 800;
        }

        .timeline-summary {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 10px;
            margin-bottom: 16px;
        }

        .timeline-summary-card {
            border: 1px solid #E2E8F0;
            border-radius: 8px;
            background: #F8FBFF;
            padding: 11px 12px;
            min-width: 0;
        }

        .timeline-summary-card span {
            display: block;
            color: #64748B;
            font-size: 0.68rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-bottom: 6px;
        }

        .timeline-summary-card strong {
            display: block;
            color: #0F172A;
            font-size: 0.88rem;
            line-height: 1.25;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .timeline-viewport {
            position: relative;
        }

        .timeline-scale {
            display: grid;
            grid-template-columns: 220px 1fr;
            gap: 12px;
            color: #94A3B8;
            font-size: 0.72rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-bottom: 10px;
        }

        .timeline-scale-dates {
            display: flex;
            justify-content: space-between;
            gap: 10px;
        }

        .timeline-today {
            position: absolute;
            top: 28px;
            bottom: 0;
            width: 2px;
            background: #F97316;
            border-radius: 999px;
            pointer-events: none;
            opacity: 0.9;
        }

        .timeline-today span {
            position: absolute;
            top: -24px;
            left: 50%;
            transform: translateX(-50%);
            background: #FFF7ED;
            color: #C2410C;
            border: 1px solid #FED7AA;
            border-radius: 999px;
            padding: 3px 7px;
            font-size: 0.66rem;
            font-weight: 800;
            white-space: nowrap;
        }

        .timeline-row {
            display: grid;
            grid-template-columns: minmax(150px, 220px) 1fr;
            gap: 12px;
            align-items: center;
            margin-bottom: 11px;
        }

        .timeline-label {
            min-width: 0;
        }

        .timeline-label strong {
            display: block;
            color: #0F172A;
            font-size: 0.82rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .timeline-label span {
            display: block;
            color: #64748B;
            font-size: 0.72rem;
            margin-top: 2px;
        }

        .timeline-label .timeline-meta {
            color: #94A3B8;
            font-size: 0.68rem;
        }

        .timeline-track {
            height: 24px;
            border-radius: 6px;
            background: #F1F5F9;
            overflow: hidden;
            position: relative;
        }

        .timeline-bar {
            height: 100%;
            min-width: 4px;
            border-radius: 6px;
            background: #2563EB;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            color: #FFFFFF;
            font-size: 0.68rem;
            font-weight: 800;
            padding-right: 7px;
            overflow: hidden;
            white-space: nowrap;
        }

        .timeline-bar.is-complete { background: #10B981; }
        .timeline-bar.is-overdue { background: #EF4444; }
        .timeline-bar.is-pending { background: #94A3B8; }

        .construction-empty {
            background: #FFFFFF;
            border: 1px solid #E2E8F0;
            border-radius: 8px;
            padding: 34px 22px;
            text-align: center;
            box-shadow: 0 1px 4px rgba(15, 23, 42, 0.05);
        }

        .construction-empty h2 {
            color: #0F172A;
            font-size: 1.15rem;
            margin: 0 0 8px;
        }

        .construction-empty p {
            color: #64748B;
            margin: 0 0 18px;
        }

        .construction-modal {
            display: none;
            position: fixed;
            z-index: 1000;
            inset: 0;
            background: rgba(15, 23, 42, 0.46);
            backdrop-filter: blur(3px);
            padding: 18px;
        }

        .construction-modal.is-open {
            display: block;
        }

        .construction-modal-body {
            background: #FFFFFF;
            margin: 5vh auto;
            padding: 24px;
            border-radius: 8px;
            width: min(560px, 100%);
            max-height: 90vh;
            overflow: auto;
            border: 1px solid #D6E3F5;
            box-shadow: 0 18px 36px rgba(15, 23, 42, 0.18);
        }

        .construction-modal-body h2 {
            color: #0F172A;
            font-size: 1.15rem;
            font-weight: 800;
            margin: 0 0 18px;
        }

        .inline-error {
            display: none;
            margin: 0 0 14px;
            padding: 10px 12px;
            border-radius: 6px;
            background: #FEF2F2;
            color: #991B1B;
            font-size: 0.86rem;
            font-weight: 700;
        }

        @@media (max-width: 1280px) {
            .construction-stats {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }

            .construction-layout {
                grid-template-columns: 1fr;
            }

        }

        @@media (max-width: 800px) {
            .construction-hero,
            .phase-panel-header,
            .timeline-row,
            .timeline-scale,
            .timeline-summary {
                grid-template-columns: 1fr;
            }

            .construction-stats {
                grid-template-columns: 1fr;
            }

            .phase-panel-actions,
            .task-actions-row {
                justify-content: flex-start;
            }
        }
    </style>
}

<div class="module-header">
    <div class="module-title">
        <h1>Construction</h1>
        <p>@ViewBag.ProjectName</p>
    </div>
    <div class="entity-actions">
        <button type="button" class="btn-secondary" onclick="quickSetup()">Quick Setup</button>
        <a asp-action="AddPhase" class="btn-create">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Add Phase
        </a>
    </div>
</div>

<div class="construction-board">
    <section class="construction-hero">
        <div>
            <div class="construction-eyebrow">Active Project</div>
            <h2 class="construction-title">@ViewBag.ProjectName</h2>
            <div class="construction-meta">
                <span class="construction-chip">@ViewBag.PropertyCount Properties</span>
                <span class="construction-chip">@(ViewBag.IsProjectCompleted == true ? "Completed Project" : "Open Project")</span>
                <span class="construction-chip" id="hero-health">Loading</span>
            </div>
        </div>
        <div class="overall-progress-panel">
            <div class="overall-progress-number">
                <span>Project Progress</span>
                <strong id="overall-progress-text">0%</strong>
            </div>
            <div class="construction-progress-track">
                <div class="construction-progress-fill" id="overall-progress-bar"></div>
            </div>
        </div>
    </section>

    <section class="construction-stats">
        <div class="construction-stat"><span>Phases</span><strong id="stat-phases">0</strong></div>
        <div class="construction-stat"><span>Tasks</span><strong id="stat-tasks">0</strong></div>
        <div class="construction-stat"><span>In Progress</span><strong id="stat-progress">0</strong></div>
        <div class="construction-stat"><span>Completed</span><strong id="stat-completed">0</strong></div>
        <div class="construction-stat"><span>Overdue</span><strong id="stat-overdue">0</strong></div>
        <div class="construction-stat"><span>Est. Cost</span><strong id="stat-cost">PKR 0</strong></div>
    </section>

    <section class="construction-layout">
        <div class="phase-stack" id="phases-container"></div>
    </section>

    <section class="timeline-panel">
        <div class="timeline-head">
            <h2>Timeline</h2>
            <span class="badge badge-info" id="timeline-count">0 scheduled</span>
        </div>
        <div id="timeline-container"></div>
    </section>
</div>

<div id="phaseModal" class="construction-modal">
    <div class="construction-modal-body">
        <h2 id="phase-modal-title">Edit Phase</h2>
        <div id="phase-error" class="inline-error"></div>
        <form id="phase-form">
            <input type="hidden" id="phase-id">
            <div class="form-grid">
                <div class="form-group">
                    <label>Phase Type</label>
                    <select id="phase-type-id" class="form-control" required></select>
                </div>
                <div class="form-group full-width" id="custom-phase-group">
                    <label>Custom Phase Name</label>
                    <input type="text" id="phase-custom-name" class="form-control" placeholder="Boundary wall">
                </div>
                <div class="form-group">
                    <label>Start Date</label>
                    <input type="date" id="phase-start" class="form-control">
                </div>
                <div class="form-group full-width">
                    <label>Notes</label>
                    <textarea id="phase-notes" class="form-control" rows="3"></textarea>
                </div>
                <div class="form-group full-width">
                    <label style="display:flex; gap:8px; align-items:center;">
                        <input type="checkbox" id="phase-completed">
                        Mark phase complete
                    </label>
                </div>
            </div>
            <div class="form-actions">
                <button type="button" class="btn-secondary" onclick="closePhaseModal()">Cancel</button>
                <button type="submit" class="btn-primary">Save Phase</button>
            </div>
        </form>
    </div>
</div>

<div id="taskModal" class="construction-modal">
    <div class="construction-modal-body">
        <h2 id="task-modal-title">Add Task</h2>
        <div id="task-error" class="inline-error"></div>
        <form id="task-form">
            <input type="hidden" id="task-id">
            <input type="hidden" id="task-phase-id">
            <div class="form-grid">
                <div class="form-group full-width">
                    <label>Task Name</label>
                    <input type="text" id="task-name" class="form-control" required>
                </div>
                <div class="form-group">
                    <label>Status</label>
                    <select id="task-status-id" class="form-control"></select>
                </div>
                <div class="form-group">
                    <label>Estimated Cost (PKR)</label>
                    <input type="number" id="task-cost" class="form-control" min="0" step="0.01">
                </div>
                <div class="form-group">
                    <label>Start Date</label>
                    <input type="date" id="task-start" class="form-control">
                </div>
                <div class="form-group">
                    <label>Deadline</label>
                    <input type="date" id="task-end" class="form-control">
                </div>
                <div class="form-group full-width">
                    <label>Description</label>
                    <textarea id="task-description" class="form-control" rows="3"></textarea>
                </div>
            </div>
            <div class="form-actions">
                <button type="button" class="btn-secondary" onclick="closeTaskModal()">Cancel</button>
                <button type="submit" class="btn-primary">Save Task</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const phaseTypes = @Html.Raw(Json.Serialize(ViewBag.PhaseTypes));
        const taskStatuses = @Html.Raw(Json.Serialize(ViewBag.TaskStatuses));
        let currentPhases = [];

        function escapeHtml(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function formatDate(value) {
            if (!value) return '-';
            return new Date(`${value}T00:00:00`).toLocaleDateString(undefined, { month: 'short', day: '2-digit', year: 'numeric' });
        }

        function formatShortDate(value) {
            if (!value) return '-';
            return new Date(`${value}T00:00:00`).toLocaleDateString(undefined, { month: 'short', day: '2-digit' });
        }

        function phaseDateText(phase) {
            const start = phase.startDate ? `Started ${formatDate(phase.startDate)}` : 'Start date not set';
            if (phase.isCompleted) {
                return phase.endDate ? `${start} | Completed ${formatDate(phase.endDate)}` : `${start} | Completed`;
            }
            return start;
        }

        function formatMoney(value) {
            return formatPKR(Number(value || 0));
        }

        function statusId(name) {
            const found = taskStatuses.find(s => String(s.statusName).toLowerCase() === String(name).toLowerCase());
            return found ? Number(found.statusId) : null;
        }

        function isCompletedTask(task) {
            return Number(task.statusId) === 3 || String(task.status).toLowerCase() === 'completed';
        }

        function setError(id, message) {
            const el = document.getElementById(id);
            el.textContent = message || '';
            el.style.display = message ? 'block' : 'none';
        }

        function populateLookups() {
            const phaseSelect = document.getElementById('phase-type-id');
            phaseSelect.innerHTML = phaseTypes
                .map(p => `<option value="${p.phaseTypeId}">${String(p.phaseName).toLowerCase() === 'custom' ? 'Custom phase name' : escapeHtml(p.phaseName)}</option>`)
                .join('');

            const statusSelect = document.getElementById('task-status-id');
            statusSelect.innerHTML = taskStatuses.map(s => `<option value="${s.statusId}">${escapeHtml(s.statusName)}</option>`).join('');

            phaseSelect.addEventListener('change', toggleCustomPhase);
            toggleCustomPhase();
        }

        async function loadConstructionData() {
            const res = await fetch('/Construction/GetProgressData', { cache: 'no-store' });
            const data = await res.json();
            currentPhases = data.phases || [];

            const overallProgress = Math.max(0, Math.min(100, Number(data.overallProgress || 0)));
            document.getElementById('overall-progress-text').textContent = `${overallProgress.toFixed(0)}%`;
            document.getElementById('overall-progress-bar').style.width = `${overallProgress}%`;

            const allTasks = currentPhases.flatMap(p => p.tasks.map(t => ({ ...t, phaseName: p.phaseName })));
            const completed = allTasks.filter(isCompletedTask).length;
            const inProgress = allTasks.filter(t => String(t.status).toLowerCase() === 'in progress').length;
            const overdue = allTasks.filter(t => t.isOverdue).length;
            const estimatedCost = allTasks.reduce((sum, t) => sum + Number(t.estimatedCost || 0), 0);

            document.getElementById('stat-phases').textContent = currentPhases.length;
            document.getElementById('stat-tasks').textContent = allTasks.length;
            document.getElementById('stat-progress').textContent = inProgress;
            document.getElementById('stat-completed').textContent = completed;
            document.getElementById('stat-overdue').textContent = overdue;
            document.getElementById('stat-cost').textContent = formatMoney(estimatedCost);
            document.getElementById('hero-health').textContent = overdue > 0 ? `${overdue} overdue` : `${Math.max(0, allTasks.length - completed)} open tasks`;

            renderPhases(currentPhases);
            renderTimeline(currentPhases);
        }

        function renderPhases(phases) {
            const container = document.getElementById('phases-container');
            if (!phases.length) {
                container.innerHTML = `
                    <div class="construction-empty">
                        <h2>No phases yet</h2>
                        <p>Start with a standard construction sequence or add your own phase.</p>
                        <button type="button" class="btn-primary" onclick="quickSetup()">Quick Setup</button>
                        <a class="btn-secondary" href="/Construction/AddPhase" style="margin-left:8px;">Add Phase</a>
                    </div>`;
                return;
            }

            container.innerHTML = phases.map((p, index) => `
                <section class="phase-panel js-phase-panel" data-phase-id="${p.phaseId}">
                    <div class="phase-panel-header">
                        <div>
                            <div class="phase-title-row">
                                <button type="button" class="phase-drag-handle" draggable="true" title="Drag to reorder priority" aria-label="Drag ${escapeHtml(p.phaseName)} to reorder priority">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                        <circle cx="9" cy="6" r="1"></circle><circle cx="15" cy="6" r="1"></circle>
                                        <circle cx="9" cy="12" r="1"></circle><circle cx="15" cy="12" r="1"></circle>
                                        <circle cx="9" cy="18" r="1"></circle><circle cx="15" cy="18" r="1"></circle>
                                    </svg>
                                </button>
                                <span class="phase-priority" title="Priority ${index + 1}">${index + 1}</span>
                                <div class="phase-title">${escapeHtml(p.phaseName)}</div>
                                <span class="badge ${p.isCompleted ? 'badge-success' : 'badge-info'}">${p.isCompleted ? 'Complete' : 'Open'}</span>
                            </div>
                            <div class="phase-subline">
                                <span>${phaseDateText(p)}</span>
                                <span>${p.tasks.length} task${p.tasks.length === 1 ? '' : 's'}</span>
                                ${p.notes ? `<span>${escapeHtml(p.notes)}</span>` : ''}
                            </div>
                            <div class="phase-progress">
                                <div class="phase-progress-label">
                                    <span>${Number(p.progress).toFixed(0)}% complete</span>
                                    <span>${p.tasks.filter(isCompletedTask).length}/${p.tasks.length}</span>
                                </div>
                                <div class="construction-progress-track">
                                    <div class="construction-progress-fill" style="width:${Math.min(100, Number(p.progress || 0))}%"></div>
                                </div>
                            </div>
                        </div>
                        <div class="phase-panel-actions">
                            <button class="mini-action primary" onclick="openAddTask(${p.phaseId})">Add Task</button>
                            <button type="button" class="btn-icon btn-edit" onclick="openEditPhase(${p.phaseId})" title="Edit phase" aria-label="Edit ${escapeHtml(p.phaseName)}">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                            </button>
                            <button type="button" class="btn-icon btn-delete" onclick="deletePhase(${p.phaseId})" title="Delete phase" aria-label="Delete ${escapeHtml(p.phaseName)}">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path></svg>
                            </button>
                        </div>
                    </div>
                    ${renderTaskTable(p)}
                </section>
            `).join('');
            bindPhaseReorder();
        }

        function renderTaskTable(phase) {
            if (!phase.tasks.length) {
                return `<div class="construction-empty" style="border:0; box-shadow:none; border-radius:0;">
                    <h2>No tasks in this phase</h2>
                    <p>Add the work items that make this phase measurable.</p>
                    <button type="button" class="btn-primary" onclick="openAddTask(${phase.phaseId})">Add Task</button>
                </div>`;
            }

            return `
                <div class="task-table-wrap">
                    <table class="task-table">
                        <thead>
                            <tr>
                                <th>Task</th>
                                <th>Status</th>
                                <th>Dates</th>
                                <th>Cost</th>
                                <th style="text-align:right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${phase.tasks.map(t => renderTaskRow(t)).join('')}
                        </tbody>
                    </table>
                </div>`;
        }

        function renderTaskRow(task) {
            const canStart = String(task.status).toLowerCase() === 'pending' && statusId('In Progress');
            const canComplete = !isCompletedTask(task) && statusId('Completed');
            return `
                <tr>
                    <td class="task-name-cell">
                        <strong>${escapeHtml(task.taskName)}</strong>
                        ${task.description ? `<small>${escapeHtml(task.description)}</small>` : ''}
                    </td>
                    <td><span class="badge ${statusBadge(task)}">${task.isOverdue ? 'Overdue' : escapeHtml(task.status)}</span></td>
                    <td>${formatShortDate(task.startDate)} - ${formatShortDate(task.endDate)}</td>
                    <td>${formatMoney(task.estimatedCost)}</td>
                    <td>
                        <div class="task-actions-row">
                            ${canStart ? `<button class="mini-action primary" onclick="setTaskStatus(${task.taskId}, 'In Progress')">Start</button>` : ''}
                            ${canComplete ? `<button class="mini-action success" onclick="setTaskStatus(${task.taskId}, 'Completed')">Done</button>` : ''}
                            <button type="button" class="btn-icon btn-edit" onclick="openEditTask(${task.taskId})" title="Edit task" aria-label="Edit ${escapeHtml(task.taskName)}">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                            </button>
                            <button type="button" class="btn-icon btn-delete" onclick="deleteTask(${task.taskId})" title="Delete task" aria-label="Delete ${escapeHtml(task.taskName)}">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path></svg>
                            </button>
                        </div>
                    </td>
                </tr>`;
        }

        let draggedPhaseId = null;
        let lastSavedOrder = '';
        let phaseOrderBeforeDrag = [];
        let pointerPhaseId = null;
        let pointerDragActive = false;

        function getPhaseOrderFromDom() {
            return Array.from(document.querySelectorAll('.js-phase-panel'))
                .map(panel => Number(panel.dataset.phaseId))
                .filter(Boolean);
        }

        function clearPhaseDragState() {
            document.querySelectorAll('.js-phase-panel').forEach(panel => {
                panel.classList.remove('is-dragging', 'is-drag-over', 'is-order-saving');
            });
        }

        function updatePhasePriorityLabels() {
            document.querySelectorAll('.js-phase-panel').forEach((panel, index) => {
                const priority = panel.querySelector('.phase-priority');
                if (!priority) return;

                priority.textContent = index + 1;
                priority.title = `Priority ${index + 1}`;
            });
        }

        function syncCurrentPhaseOrder(orderedIds) {
            const phaseMap = new Map(currentPhases.map(phase => [phase.phaseId, phase]));
            currentPhases = orderedIds
                .map((id, index) => {
                    const phase = phaseMap.get(id);
                    return phase ? { ...phase, sequence: index + 1 } : null;
                })
                .filter(Boolean);
        }

        function restoreSavedPhaseOrder() {
            renderPhases(currentPhases);
            renderTimeline(currentPhases);
            phaseOrderBeforeDrag = [];
        }

        async function persistPhaseOrder(orderedIds) {
            const orderKey = orderedIds.join(',');
            if (!orderedIds.length || orderKey === lastSavedOrder) return;

            const previous = [...currentPhases];
            const movedPanels = Array.from(document.querySelectorAll('.js-phase-panel'));
            syncCurrentPhaseOrder(orderedIds);
            updatePhasePriorityLabels();
            renderTimeline(currentPhases);
            movedPanels.forEach(panel => panel.classList.add('is-order-saving'));

            let result;
            try {
                result = await postJson('/Construction/ReorderPhases', { phaseIds: orderedIds });
            } catch {
                result = { success: false, message: 'Unable to save phase priority.' };
            }
            movedPanels.forEach(panel => panel.classList.remove('is-order-saving'));
            if (!result.success) {
                currentPhases = previous;
                renderPhases(currentPhases);
                renderTimeline(currentPhases);
                alert(result.message || 'Unable to save phase priority.');
                return;
            }

            lastSavedOrder = orderKey;
            phaseOrderBeforeDrag = [];
        }

        function bindPhaseReorder() {
            const container = document.getElementById('phases-container');
            lastSavedOrder = currentPhases.map(phase => phase.phaseId).join(',');

            container.ondragover = event => {
                if (draggedPhaseId) event.preventDefault();
            };

            container.ondrop = event => {
                if (!draggedPhaseId) return;

                event.preventDefault();
                const orderedIds = getPhaseOrderFromDom();
                draggedPhaseId = null;
                clearPhaseDragState();
                persistPhaseOrder(orderedIds);
            };

            document.querySelectorAll('.js-phase-panel').forEach(panel => {
                const handle = panel.querySelector('.phase-drag-handle');
                handle?.addEventListener('pointerdown', event => {
                    if (event.pointerType === 'mouse') return;

                    pointerPhaseId = Number(panel.dataset.phaseId);
                    phaseOrderBeforeDrag = getPhaseOrderFromDom();
                    pointerDragActive = false;
                    handle.setPointerCapture?.(event.pointerId);
                    event.preventDefault();
                });

                handle?.addEventListener('pointermove', event => {
                    if (!pointerPhaseId || event.pointerType === 'mouse') return;

                    const dragging = document.querySelector(`.js-phase-panel[data-phase-id="${pointerPhaseId}"]`);
                    if (!dragging) return;

                    pointerDragActive = true;
                    dragging.classList.add('is-dragging');

                    const target = document.elementFromPoint(event.clientX, event.clientY)?.closest('.js-phase-panel');
                    if (!target || target === dragging || !container.contains(target)) return;

                    document.querySelectorAll('.js-phase-panel.is-drag-over').forEach(item => item.classList.remove('is-drag-over'));
                    target.classList.add('is-drag-over');
                    const rect = target.getBoundingClientRect();
                    const insertAfter = event.clientY > rect.top + rect.height / 2;
                    container.insertBefore(dragging, insertAfter ? target.nextSibling : target);
                    updatePhasePriorityLabels();
                });

                handle?.addEventListener('pointerup', event => {
                    if (!pointerPhaseId || event.pointerType === 'mouse') return;

                    const orderedIds = getPhaseOrderFromDom();
                    pointerPhaseId = null;
                    handle.releasePointerCapture?.(event.pointerId);
                    clearPhaseDragState();

                    if (pointerDragActive) {
                        pointerDragActive = false;
                        persistPhaseOrder(orderedIds);
                    } else {
                        phaseOrderBeforeDrag = [];
                    }
                });

                handle?.addEventListener('pointercancel', event => {
                    if (!pointerPhaseId || event.pointerType === 'mouse') return;
                    pointerPhaseId = null;
                    handle.releasePointerCapture?.(event.pointerId);
                    if (pointerDragActive) restoreSavedPhaseOrder();
                    pointerDragActive = false;
                    clearPhaseDragState();
                });

                panel.addEventListener('dragstart', event => {
                    if (!event.target.closest('.phase-drag-handle')) {
                        event.preventDefault();
                        return;
                    }

                    draggedPhaseId = Number(panel.dataset.phaseId);
                    phaseOrderBeforeDrag = getPhaseOrderFromDom();
                    panel.classList.add('is-dragging');
                    event.dataTransfer.effectAllowed = 'move';
                    event.dataTransfer.setData('text/plain', String(draggedPhaseId));
                });

                panel.addEventListener('dragend', () => {
                    if (draggedPhaseId && phaseOrderBeforeDrag.length && getPhaseOrderFromDom().join(',') !== phaseOrderBeforeDrag.join(',')) {
                        restoreSavedPhaseOrder();
                    }
                    draggedPhaseId = null;
                    clearPhaseDragState();
                    phaseOrderBeforeDrag = [];
                });

                panel.addEventListener('dragover', event => {
                    if (!draggedPhaseId) return;

                    const dragging = document.querySelector(`.js-phase-panel[data-phase-id="${draggedPhaseId}"]`);
                    if (!dragging || dragging === panel) return;

                    event.preventDefault();
                    document.querySelectorAll('.js-phase-panel.is-drag-over').forEach(item => item.classList.remove('is-drag-over'));
                    panel.classList.add('is-drag-over');

                    const rect = panel.getBoundingClientRect();
                    const insertAfter = event.clientY > rect.top + rect.height / 2;
                    panel.parentElement.insertBefore(dragging, insertAfter ? panel.nextSibling : panel);
                    updatePhasePriorityLabels();
                });

                panel.addEventListener('dragleave', () => {
                    panel.classList.remove('is-drag-over');
                });

                panel.addEventListener('drop', event => {
                    if (!draggedPhaseId) return;

                    event.preventDefault();
                    const orderedIds = getPhaseOrderFromDom();
                    draggedPhaseId = null;
                    clearPhaseDragState();
                    persistPhaseOrder(orderedIds);
                });
            });
        }

        function statusBadge(task) {
            if (task.isOverdue) return 'badge-danger';
            switch (String(task.status).toLowerCase()) {
                case 'completed': return 'badge-success';
                case 'in progress': return 'badge-info';
                case 'on hold': return 'badge-warning';
                case 'cancelled': return 'badge-danger';
                default: return 'badge-warning';
            }
        }

        function renderTimeline(phases) {
            const container = document.getElementById('timeline-container');
            const allTasks = phases.flatMap(p => p.tasks
                .map(t => ({ ...t, phaseName: p.phaseName })));
            const tasks = phases.flatMap(p => p.tasks
                .filter(t => t.startDate && t.endDate)
                .map(t => ({ ...t, phaseName: p.phaseName })));
            document.getElementById('timeline-count').textContent = `${tasks.length} scheduled`;

            if (!tasks.length) {
                container.innerHTML = '<div class="construction-empty" style="box-shadow:none;"><h2>No scheduled work</h2><p>Add start and deadline dates to tasks to build the timeline.</p></div>';
                return;
            }

            const dayMs = 86400000;
            const parseDay = value => new Date(`${value}T00:00:00`);
            const toDateKey = date => `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            const starts = tasks.map(t => new Date(`${t.startDate}T00:00:00`));
            const ends = tasks.map(t => new Date(`${t.endDate}T00:00:00`));
            const min = new Date(Math.min(...starts));
            const max = new Date(Math.max(...ends));
            const totalDays = Math.max(1, Math.round((max - min) / dayMs) + 1);
            const openTasks = tasks.filter(t => !isCompletedTask(t));
            const activeTasks = openTasks.filter(t => parseDay(t.startDate) <= today && parseDay(t.endDate) >= today);
            const overdueTasks = openTasks.filter(t => t.isOverdue);
            const nextTask = openTasks
                .filter(t => parseDay(t.endDate) >= today)
                .sort((a, b) => parseDay(a.endDate) - parseDay(b.endDate))[0];
            const todayInRange = today >= min && today <= max;
            const todayLeft = todayInRange ? Math.max(0, Math.min(100, ((today - min) / dayMs) / totalDays * 100)) : null;

            const rows = tasks
                .sort((a, b) => new Date(`${a.startDate}T00:00:00`) - new Date(`${b.startDate}T00:00:00`))
                .map(t => {
                    const start = parseDay(t.startDate);
                    const end = parseDay(t.endDate);
                    const left = Math.max(0, ((start - min) / dayMs) / totalDays * 100);
                    const width = Math.max(4, (Math.round((end - start) / dayMs) + 1) / totalDays * 100);
                    const statusClass = isCompletedTask(t) ? 'is-complete' : t.isOverdue ? 'is-overdue' : String(t.status).toLowerCase() === 'pending' ? 'is-pending' : '';
                    const duration = Math.max(1, Math.round((end - start) / dayMs) + 1);
                    return `
                        <div class="timeline-row">
                            <div class="timeline-label">
                                <strong>${escapeHtml(t.taskName)}</strong>
                                <span>${escapeHtml(t.phaseName)}</span>
                                <span class="timeline-meta">${formatShortDate(t.startDate)} - ${formatShortDate(t.endDate)} | ${duration} day${duration === 1 ? '' : 's'}</span>
                            </div>
                            <div class="timeline-track">
                                <div class="timeline-bar ${statusClass}" style="width:${Math.min(100 - left, width)}%; margin-left:${Math.min(96, left)}%;">
                                    ${escapeHtml(t.status)}
                                </div>
                            </div>
                        </div>`;
                }).join('');

            container.innerHTML = `
                <div class="timeline-summary">
                    <div class="timeline-summary-card"><span>Schedule Window</span><strong>${formatShortDate(toDateKey(min))} - ${formatShortDate(toDateKey(max))}</strong></div>
                    <div class="timeline-summary-card"><span>Active Now</span><strong>${activeTasks.length} task${activeTasks.length === 1 ? '' : 's'}</strong></div>
                    <div class="timeline-summary-card"><span>Next Deadline</span><strong>${nextTask ? `${escapeHtml(nextTask.taskName)} (${formatShortDate(nextTask.endDate)})` : 'No upcoming deadline'}</strong></div>
                    <div class="timeline-summary-card"><span>Delayed</span><strong>${overdueTasks.length} task${overdueTasks.length === 1 ? '' : 's'}</strong></div>
                </div>
                <div class="timeline-viewport">
                    <div class="timeline-scale">
                        <span>Work item</span>
                        <div class="timeline-scale-dates"><span>${formatShortDate(toDateKey(min))}</span><span>${formatShortDate(toDateKey(max))}</span></div>
                    </div>
                    ${todayInRange ? `<div class="timeline-today" style="left:${Math.min(98, Math.max(2, todayLeft))}%;"><span>Today</span></div>` : ''}
                    ${rows}
                </div>`;
        }

        function toggleCustomPhase() {
            const selected = phaseTypes.find(p => Number(p.phaseTypeId) === Number(document.getElementById('phase-type-id').value));
            const isCustom = selected && String(selected.phaseName).toLowerCase() === 'custom';
            document.getElementById('custom-phase-group').style.display = isCustom ? 'block' : 'none';
            document.getElementById('phase-custom-name').required = !!isCustom;
            if (!isCustom) {
                document.getElementById('phase-custom-name').value = '';
            }
        }

        function openEditPhase(phaseId) {
            const phase = currentPhases.find(p => p.phaseId === phaseId);
            if (!phase) return;
            document.getElementById('phase-id').value = phase.phaseId;
            document.getElementById('phase-type-id').value = phase.phaseTypeId;
            document.getElementById('phase-custom-name').value = phase.phaseName;
            document.getElementById('phase-start').value = phase.startDate || '';
            document.getElementById('phase-notes').value = phase.notes || '';
            document.getElementById('phase-completed').checked = !!phase.isCompleted;
            document.getElementById('phase-modal-title').textContent = 'Edit Phase';
            setError('phase-error', '');
            toggleCustomPhase();
            document.getElementById('phaseModal').classList.add('is-open');
        }

        function closePhaseModal() {
            document.getElementById('phaseModal').classList.remove('is-open');
        }

        document.getElementById('phase-form').addEventListener('submit', async (event) => {
            event.preventDefault();
            const phaseId = Number(document.getElementById('phase-id').value);
            if (phaseId <= 0) {
                setError('phase-error', 'Open the Add Phase page to create a new phase.');
                return;
            }

            const payload = {
                phaseId,
                phaseTypeId: Number(document.getElementById('phase-type-id').value),
                customPhaseName: document.getElementById('phase-custom-name').value,
                sequence: 0,
                startDate: document.getElementById('phase-start').value || null,
                endDate: null,
                isCompleted: document.getElementById('phase-completed').checked,
                notes: document.getElementById('phase-notes').value
            };

            const result = await postJson('/Construction/UpdatePhase', payload);
            if (!result.success) {
                setError('phase-error', result.message || 'Unable to save phase.');
                return;
            }

            closePhaseModal();
            loadConstructionData();
        });

        function openAddTask(phaseId) {
            document.getElementById('task-form').reset();
            document.getElementById('task-id').value = 0;
            document.getElementById('task-phase-id').value = phaseId;
            document.getElementById('task-modal-title').textContent = 'Add Task';
            setError('task-error', '');
            document.getElementById('taskModal').classList.add('is-open');
        }

        function openEditTask(taskId) {
            const task = currentPhases.flatMap(p => p.tasks).find(t => t.taskId === taskId);
            if (!task) return;
            document.getElementById('task-id').value = task.taskId;
            document.getElementById('task-phase-id').value = task.phaseId;
            document.getElementById('task-name').value = task.taskName;
            document.getElementById('task-status-id').value = task.statusId;
            document.getElementById('task-cost').value = task.estimatedCost || 0;
            document.getElementById('task-start').value = task.startDate || '';
            document.getElementById('task-end').value = task.endDate || '';
            document.getElementById('task-description').value = task.description || '';
            document.getElementById('task-modal-title').textContent = 'Edit Task';
            setError('task-error', '');
            document.getElementById('taskModal').classList.add('is-open');
        }

        function closeTaskModal() {
            document.getElementById('taskModal').classList.remove('is-open');
        }

        document.getElementById('task-form').addEventListener('submit', async (event) => {
            event.preventDefault();
            const taskId = Number(document.getElementById('task-id').value);
            const payload = {
                taskId,
                phaseId: Number(document.getElementById('task-phase-id').value),
                taskName: document.getElementById('task-name').value,
                description: document.getElementById('task-description').value,
                statusId: Number(document.getElementById('task-status-id').value),
                startDate: document.getElementById('task-start').value || null,
                endDate: document.getElementById('task-end').value || null,
                estimatedCost: Number(document.getElementById('task-cost').value || 0)
            };

            const result = await postJson(taskId > 0 ? '/Construction/UpdateTask' : '/Construction/AddTask', payload);
            if (!result.success) {
                setError('task-error', result.message || 'Unable to save task.');
                return;
            }

            closeTaskModal();
            loadConstructionData();
        });

        async function setTaskStatus(taskId, statusName) {
            const task = currentPhases.flatMap(p => p.tasks).find(t => t.taskId === taskId);
            const newStatusId = statusId(statusName);
            if (!task || !newStatusId) return;

            const result = await postJson('/Construction/UpdateTask', {
                taskId: task.taskId,
                phaseId: task.phaseId,
                taskName: task.taskName,
                description: task.description,
                statusId: newStatusId,
                startDate: task.startDate,
                endDate: task.endDate,
                estimatedCost: Number(task.estimatedCost || 0)
            });

            if (!result.success) {
                alert(result.message || 'Unable to update task.');
                return;
            }

            loadConstructionData();
        }

        async function quickSetup() {
            if (!confirm('Create the standard construction phase sequence for this project?')) return;
            const result = await postForm('/Construction/QuickSetup');
            if (!result.success) {
                alert(result.message || 'Unable to create phases.');
                return;
            }

            loadConstructionData();
        }

        async function deletePhase(id) {
            if (!confirm('Delete this phase and its tasks?')) return;
            const result = await postForm(`/Construction/DeletePhase?id=${id}`);
            if (!result.success) {
                alert(result.message || 'Unable to delete phase.');
            }
            loadConstructionData();
        }

        async function deleteTask(id) {
            if (!confirm('Delete this task?')) return;
            const result = await postForm(`/Construction/DeleteTask?id=${id}`);
            if (!result.success) {
                alert(result.message || 'Unable to delete task.');
            }
            loadConstructionData();
        }

        async function postJson(url, payload) {
            const res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            return res.ok ? await res.json() : { success: false, message: 'Request failed.' };
        }

        async function postForm(url) {
            const res = await fetch(url, { method: 'POST' });
            return res.ok ? await res.json() : { success: false, message: 'Request failed.' };
        }

        document.querySelectorAll('.construction-modal').forEach(modal => {
            modal.addEventListener('click', event => {
                if (event.target === modal) {
                    modal.classList.remove('is-open');
                }
            });
        });

        populateLookups();
        loadConstructionData();
    </script>
}
