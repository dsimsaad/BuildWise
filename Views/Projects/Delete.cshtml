@model BuildWise.Models.Project

@{
    ViewData["Title"] = "Delete Project";
    Layout = "_ModuleLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/modules.css">
}

<div class="module-header">
    <div class="module-title">
        <h1>Delete Project</h1>
        <p>Are you sure you want to delete this project? This action cannot be undone.</p>
    </div>
</div>

<div class="scaffold-detail-card" style="border-left: 4px solid #EF4444;">
    <dl>
        <dt>Project Name</dt>
        <dd><strong>@Html.DisplayFor(model => model.ProjectName)</strong></dd>

        <dt>Description</dt>
        <dd>@Html.DisplayFor(model => model.Description)</dd>

        <dt>Start Date</dt>
        <dd>@(Model.StartDate.ToString("MMM dd, yyyy"))</dd>

        <dt>Expected End Date</dt>
        <dd>@(Model.ExpectedEndDate.HasValue ? Model.ExpectedEndDate.Value.ToString("MMM dd, yyyy") : "—")</dd>

        <dt>Total Budget</dt>
        <dd>PKR @Html.DisplayFor(model => model.TotalBudget)</dd>

        <dt>Status</dt>
        <dd>
            @if (Model.IsCompleted) {
                <span class="badge badge-success">Completed</span>
            } else {
                <span class="badge badge-warning">In Progress</span>
            }
        </dd>
    </dl>

    <form asp-action="Delete" style="margin-top: 24px; padding-top: 16px; border-top: 1px solid #F1F5F9;">
        <input type="hidden" asp-for="ProjectId" />
        <div style="display: flex; gap: 12px; align-items: center;">
            <button type="submit" class="btn-primary" style="background: #EF4444;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path></svg>
                Delete Project
            </button>
            <a asp-action="Index" class="back-link">← Back to List</a>
        </div>
    </form>
</div>
