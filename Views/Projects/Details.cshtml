@model BuildWise.Models.Project

@{
    ViewData["Title"] = "Project Details";
    Layout = "_ModuleLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/modules.css">
}

<div class="module-header">
    <div class="module-title">
        <h1>Project Details</h1>
        <p>View complete information about this project.</p>
    </div>
</div>

<div class="scaffold-detail-card">
    <dl>
        <dt>Project Name</dt>
        <dd>@Html.DisplayFor(model => model.ProjectName)</dd>

        <dt>Description</dt>
        <dd>@Html.DisplayFor(model => model.Description)</dd>

        <dt>Start Date</dt>
        <dd>@(Model.StartDate.ToString("MMM dd, yyyy"))</dd>

        <dt>Expected End Date</dt>
        <dd>@(Model.ExpectedEndDate.HasValue ? Model.ExpectedEndDate.Value.ToString("MMM dd, yyyy") : "—")</dd>

        <dt>Actual End Date</dt>
        <dd>@(Model.ActualEndDate.HasValue ? Model.ActualEndDate.Value.ToString("MMM dd, yyyy") : "—")</dd>

        <dt>Total Budget</dt>
        <dd>PKR @Html.DisplayFor(model => model.TotalBudget)</dd>

        <dt>Status</dt>
        <dd>
            @if (Model.IsCompleted) {
                <span class="badge badge-success">Completed</span>
            } else {
                <span class="badge badge-warning">In Progress</span>
            }
        </dd>

        <dt>Created At</dt>
        <dd>@(Model.CreatedAt.ToString("MMM dd, yyyy h:mm tt"))</dd>

        <dt>Updated At</dt>
        <dd>@(Model.UpdatedAt.ToString("MMM dd, yyyy h:mm tt"))</dd>

        <dt>Property</dt>
        <dd>@(Model.Property?.PropertyName ?? "—")</dd>

        <dt>User</dt>
        <dd>@(Model.User?.FullName ?? "—")</dd>
    </dl>

    <div style="display: flex; gap: 12px; margin-top: 24px; padding-top: 16px; border-top: 1px solid #F1F5F9;">
        <a asp-action="Edit" asp-route-id="@Model?.ProjectId" class="btn-primary" style="text-decoration: none;">Edit</a>
        <a asp-action="Index" class="back-link">← Back to List</a>
    </div>
</div>
