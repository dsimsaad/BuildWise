@model BuildWise.Models.Project
@using System.Globalization

@{
    ViewData["Title"] = "Project Details";
    Layout = "_ModuleLayout";
    var pkrCulture = new CultureInfo("en-IN");
    string FormatPkr(decimal value)
    {
        var abs = Math.Abs(value);
        static string Trimmed(decimal amount) => amount.ToString(amount < 10 && amount % 1 != 0 ? "0.##" : "0.#", CultureInfo.InvariantCulture);
        if (abs >= 10000000) return $"PKR {Trimmed(value / 10000000)}Cr";
        if (abs >= 100000) return $"PKR {Trimmed(value / 100000)}L";
        return $"PKR {value.ToString("N0", new CultureInfo("en-IN"))}";
    }

    var projectBudget = Model.TotalBudget > 0 ? Model.TotalBudget : (Model.Budget?.TotalBudget ?? 0m);
    var projectExpenses = Model.Expenses?.Sum(e => e.Amount) ?? 0m;
    var projectTasks = Model.Phases?.SelectMany(ph => ph.Tasks).ToList() ?? new List<BuildWise.Models.Task>();
    var projectProgress = projectTasks.Any()
        ? Math.Round(projectTasks.Count(t => t.StatusId == 3) * 100m / projectTasks.Count, 0)
        : (Model.IsCompleted ? 100m : 0m);
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/modules.css" asp-append-version="true">
}

<div class="module-header">
    <div class="module-title">
        <h1>Project Details</h1>
        <p>View complete information about this project.</p>
    </div>
</div>

<div class="scaffold-detail-card">
    <dl>
        <dt>Project Name</dt>
        <dd>@Html.DisplayFor(model => model.ProjectName)</dd>

        <dt>Description</dt>
        <dd>@Html.DisplayFor(model => model.Description)</dd>

        <dt>Start Date</dt>
        <dd>@(Model.StartDate.ToString("MMM dd, yyyy"))</dd>

        <dt>Total Budget</dt>
        <dd>@FormatPkr(Model.TotalBudget)</dd>

        <dt>Status</dt>
        <dd>
            @if (Model.IsCompleted) {
                <span class="badge badge-success">Completed</span>
            } else {
                <span class="badge badge-warning">In Progress</span>
            }
        </dd>

        <dt>Created At</dt>
        <dd>@(Model.CreatedAt.ToString("MMM dd, yyyy h:mm tt"))</dd>

        @if (Model.IsCompleted)
        {
            <dt>Completed At</dt>
            <dd>@(Model.ActualEndDate.HasValue ? Model.ActualEndDate.Value.ToString("MMM dd, yyyy") : "—")</dd>
        }

        <dt>User</dt>
        <dd>@(Model.User?.FullName ?? "—")</dd>
    </dl>

    <div style="display: flex; gap: 12px; margin-top: 24px; padding-top: 16px; border-top: 1px solid #F1F5F9;">
        <a asp-action="Edit" asp-route-id="@Model?.ProjectId" class="btn-primary" style="text-decoration: none;">Edit</a>
        <a asp-controller="Properties" asp-action="Create" asp-route-projectId="@Model!.ProjectId" class="btn-create">Create Property</a>
        <a asp-controller="Materials" asp-action="Index" class="btn-secondary">Manage Materials</a>
        <a asp-action="Index" class="back-link">← Back to List</a>
    </div>
</div>

<div class="module-card" style="margin-top: 24px;">
    <div class="card-header">
        <h2>Properties in this Project</h2>
        <span class="badge badge-info">@(Model.Properties?.Count ?? 0)</span>
    </div>
    <div class="card-body">
        @if (Model.Properties != null && Model.Properties.Any())
        {
            <div class="entity-grid">
                @foreach (var property in Model.Properties.OrderBy(p => p.PropertyName))
                {
                    <article class="entity-card">
                        <div class="entity-card-header">
                            <div>
                                <h2 class="entity-card-title">@property.PropertyName</h2>
                                <div class="entity-card-subtitle">@property.Location@(string.IsNullOrWhiteSpace(property.City) ? "" : ", " + property.City)</div>
                            </div>
                            <span class="badge badge-info">@(property.Status?.StatusName ?? "Unspecified")</span>
                        </div>

                        <ul class="entity-meta">
                            <li><span>Type</span><strong>@(property.Type?.TypeName ?? "-")</strong></li>
                            <li><span>Area</span><strong>@property.AreaSize @property.AreaUnit?.UnitName</strong></li>
                            <li><span>Budget</span><strong>@FormatPkr(projectBudget)</strong></li>
                            <li><span>Expenses</span><strong>@FormatPkr(projectExpenses)</strong></li>
                            <li><span>Progress</span><strong>@projectProgress.ToString("0")%</strong></li>
                        </ul>

                        <div class="entity-actions">
                            <a asp-controller="Properties" asp-action="Details" asp-route-id="@property.PropertyId" class="btn-icon btn-view" title="Details" aria-label="View @property.PropertyName details">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                            </a>
                            <a asp-controller="Properties" asp-action="Edit" asp-route-id="@property.PropertyId" class="btn-icon btn-edit" title="Edit" aria-label="Edit @property.PropertyName">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="empty-state" style="box-shadow:none; padding:28px 18px;">
                <h2>No properties in this project</h2>
                <p>Create a property to track a site under this project.</p>
                <a asp-controller="Properties" asp-action="Create" asp-route-projectId="@Model.ProjectId" class="btn-primary">Create Property for this Project</a>
            </div>
        }
    </div>
</div>
