@model IEnumerable<BuildWise.Models.Project>

@{
    ViewData["Title"] = "Projects";
    Layout = "_ModuleLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/modules.css" asp-append-version="true">
}

<div class="module-header">
    <div class="module-title">
        <h1>Projects</h1>
        <p>Manage and track all your construction projects.</p>
    </div>
    <a asp-action="Create" class="btn-create cssbuttons-io-button">
        New Project
        <div class="icon">
            <svg height="24" width="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M0 0h24v24H0z" fill="none"></path>
                <path d="M16.172 11l-5.364-5.364 1.414-1.414L20 12l-7.778 7.778-1.414-1.414L16.172 13H4v-2z" fill="currentColor"></path>
            </svg>
        </div>
    </a>
</div>

<div class="summary-grid">
    <div class="sum-card">
        <div class="sum-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
        </div>
        <div class="sum-info">
            <h3>Total Projects</h3>
            <p>@Model.Count()</p>
        </div>
    </div>
    <div class="sum-card">
        <div class="sum-icon" style="background:#DCFCE7; color:#10B981;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </div>
        <div class="sum-info">
            <h3>Completed</h3>
            <p>@Model.Count(p => p.IsCompleted)</p>
        </div>
    </div>
    <div class="sum-card">
        <div class="sum-icon" style="background:#FEF3C7; color:#F59E0B;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        </div>
        <div class="sum-info">
            <h3>In Progress</h3>
            <p>@Model.Count(p => !p.IsCompleted)</p>
        </div>
    </div>
</div>

<div class="module-card">
    <div class="card-header">
        <h2>All Projects</h2>
        <span class="badge badge-info">@Model.Count() records</span>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th>Project Name</th>
                        <th>Description</th>
                        <th>Start Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td><strong>@Html.DisplayFor(modelItem => item.ProjectName)</strong></td>
                        <td style="max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@Html.DisplayFor(modelItem => item.Description)</td>
                        <td>@(item.StartDate.ToString("MMM dd, yyyy"))</td>
                        <td>
                            @if (item.IsCompleted) {
                                <span class="badge badge-success">Completed</span>
                            } else {
                                <span class="badge badge-warning">In Progress</span>
                            }
                        </td>
                        <td>
                            <div class="action-btns">
                                <a asp-action="Edit" asp-route-id="@item.ProjectId" class="btn-icon btn-edit" title="Edit" aria-label="Edit @item.ProjectName">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.ProjectId" class="btn-icon btn-view" title="Details" aria-label="View @item.ProjectName details">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.ProjectId" class="btn-icon btn-delete" title="Delete" aria-label="Delete @item.ProjectName">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path></svg>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
