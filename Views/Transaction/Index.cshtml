@{
    ViewData["Title"] = "Transaction Ledger";
    Layout = "_ModuleLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/modules.css" asp-append-version="true">
    <style>
        .desc-cell {
            max-width: 350px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-size: 0.875rem;
            color: var(--text-muted);
            vertical-align: middle;
        }

        .modern-table td {
            vertical-align: middle;
        }

        .ledger-filter-bar {
            display: grid;
            grid-template-columns: repeat(5, minmax(132px, 1fr)) 104px 104px minmax(178px, auto);
            align-items: end;
        }

        .ledger-filter-bar .filter-group {
            min-width: 0;
        }

        .ledger-filter-bar .btn-primary,
        .ledger-filter-bar .btn-secondary {
            width: 104px;
        }

        .ledger-filter-bar .btn-report {
            width: auto;
            min-width: 178px;
            background: #EFF6FF;
            color: #1D4ED8;
            border-color: #BFDBFE;
            box-shadow: 0 4px 12px rgba(29, 78, 216, 0.08);
            white-space: nowrap;
        }

        .ledger-filter-bar .btn-report:hover {
            background: #DBEAFE;
            color: #1E40AF;
        }

        @@media (max-width: 1180px) {
            .ledger-filter-bar {
                grid-template-columns: repeat(3, minmax(150px, 1fr));
            }

            .ledger-filter-bar .btn-primary,
            .ledger-filter-bar .btn-secondary,
            .ledger-filter-bar .btn-report {
                width: 100%;
            }
        }

        @@media (max-width: 760px) {
            .ledger-filter-bar {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 10px;
                padding: 14px;
                align-items: stretch;
            }

            .ledger-filter-bar .filter-group {
                width: 100%;
            }

            .ledger-filter-bar .filter-group:nth-child(5) {
                grid-column: span 2;
            }

            .ledger-filter-bar .form-control {
                min-height: 38px;
                font-size: 0.78rem;
            }

            .ledger-filter-bar .btn-primary,
            .ledger-filter-bar .btn-secondary,
            .ledger-filter-bar .btn-report {
                width: 100%;
                min-width: 0;
                min-height: 38px;
            }

            .ledger-filter-bar .btn-report {
                grid-column: span 2;
            }

            .ledger-table-card .card-body {
                padding: 12px;
            }

            .ledger-table-card .table-responsive {
                overflow-x: hidden;
            }

            .ledger-table-card .modern-table {
                min-width: 0;
                border-collapse: separate;
                border-spacing: 0 10px;
            }

            .ledger-table-card .modern-table thead {
                display: none;
            }

            .ledger-table-card .modern-table,
            .ledger-table-card .modern-table tbody,
            .ledger-table-card .modern-table tr,
            .ledger-table-card .modern-table td {
                display: block;
                width: 100%;
            }

            .ledger-table-card .modern-table tr {
                border: 1px solid #D6E3F5;
                border-radius: 8px;
                background: #FFFFFF;
                box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
                overflow: hidden;
            }

            .ledger-table-card .modern-table td {
                display: grid;
                grid-template-columns: minmax(96px, 38%) minmax(0, 1fr);
                gap: 10px;
                align-items: start;
                padding: 10px 12px;
                border-bottom: 1px solid #EEF2F7;
                white-space: normal;
                overflow-wrap: anywhere;
            }

            .ledger-table-card .modern-table td:last-child {
                border-bottom: 0;
            }

            .ledger-table-card .modern-table td::before {
                content: attr(data-label);
                color: #64748B;
                font-size: 0.68rem;
                font-weight: 800;
                letter-spacing: 0.04em;
                text-transform: uppercase;
            }

            .ledger-table-card .desc-cell {
                max-width: none;
                white-space: normal;
                overflow: visible;
                text-overflow: clip;
            }
        }

        @@media (max-width: 420px) {
            .ledger-filter-bar {
                grid-template-columns: 1fr;
            }

            .ledger-filter-bar .filter-group:nth-child(5) {
                grid-column: auto;
            }
        }
    </style>
}

<div class="module-header">
    <div class="module-title">
        <h1>Automatic Ledger</h1>
        <p>A historical record of every financial change in the system.</p>
    </div>
</div>

<div class="summary-grid">
    <div class="sum-card">
        <div class="sum-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg></div>
        <div class="sum-info">
            <h3>Total Logs</h3>
            <p id="stat-count">0</p>
        </div>
    </div>
    <div class="sum-card">
        <div class="sum-icon" style="background:#eff6ff; color:#2563eb;"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg></div>
        <div class="sum-info">
            <h3>Total Value Recorded</h3>
            <p id="stat-amount">PKR 0</p>
        </div>
    </div>
</div>

<div class="filter-bar ledger-filter-bar">
    <div class="filter-group">
        <label>Category</label>
        <select id="filter-category" class="form-control" onchange="loadTransactions()">
            <option value="">All Categories</option>
            <option value="Cement">Cement</option>
            <option value="Steel">Steel</option>
            <option value="Bricks">Bricks</option>
            <option value="Sand">Sand</option>
            <option value="Labour">Labour</option>
            <option value="Plumbing">Plumbing</option>
            <option value="Electrical">Electrical</option>
            <option value="Paint">Paint</option>
            <option value="Equipment">Equipment</option>
            <option value="Miscellaneous">Miscellaneous</option>
        </select>
    </div>
    <div class="filter-group">
        <label>Type</label>
        <select id="filter-type" class="form-control" onchange="loadTransactions()">
            <option value="">All Types</option>
            <option value="Added">Added</option>
            <option value="Updated">Updated</option>
            <option value="Deleted">Deleted</option>
            <option value="Returned">Returned</option>
        </select>
    </div>
    <div class="filter-group">
        <label>Range</label>
        <select id="filter-range" class="form-control" onchange="selectPresetRange()">
            <option value="month">This Month</option>
            <option value="year">This Year</option>
            <option value="all">All Time</option>
            <option value="custom">Custom Dates</option>
        </select>
    </div>
    <div class="filter-group">
        <label>From Date</label>
        <input type="date" id="filter-from" class="form-control">
    </div>
    <div class="filter-group">
        <label>To Date</label>
        <input type="date" id="filter-to" class="form-control">
    </div>
    <button class="btn-primary" id="transaction-filter-action" onclick="handleFilterAction()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"></path></svg>
        <span>Filter</span>
    </button>
    <button class="btn-secondary" id="transaction-reset-action" onclick="resetFilters()" style="display:none;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"></path><path d="M3 4v6h6"></path></svg>
        Reset
    </button>
    <a class="btn-secondary btn-report" id="download-transaction-report" href="/Transaction/DownloadReport">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="M7 10l5 5 5-5"></path><path d="M12 15V3"></path></svg>
        Download Report
    </a>
</div>

<div class="module-card ledger-table-card">
    <div class="card-header">
        <h2>Historical Transaction Log</h2>
        <span class="badge badge-info">Read Only</span>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th>Date & Time</th>
                        <th>Type</th>
                        <th>Category</th>
                        <th>Amount</th>
                        <th>Budget Effect</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody id="transaction-list">
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Custom dates only apply after the user chooses the custom range or opens a shared report link.
        let customDateFilterActive = false;

        async function loadTransactions() {
            const category = document.getElementById('filter-category').value;
            const type = document.getElementById('filter-type').value;
            const range = document.getElementById('filter-range').value;
            const from = document.getElementById('filter-from').value;
            const to = document.getElementById('filter-to').value;

            const params = new URLSearchParams({ category, type, range });
            if (customDateFilterActive && from) params.set('fromDate', from);
            if (customDateFilterActive && to) params.set('toDate', to);

            const res = await fetch(`/Transaction/GetTransactions?${params.toString()}`);
            const data = await res.json();

            document.getElementById('stat-count').innerText = data.totalCount;
            document.getElementById('stat-amount').innerText = formatPKR(data.totalAmount);
            updateFilterAction();
            updateReportLink();

            const list = document.getElementById('transaction-list');
            list.innerHTML = data.transactions.map(t => {
                let badgeClass = 'badge-info';
                if (t.transactionType === 'Added') badgeClass = 'badge-success';
                if (t.transactionType === 'Deleted') badgeClass = 'badge-danger';
                if (t.transactionType === 'Updated') badgeClass = 'badge-warning';
                if (t.transactionType === 'Returned') badgeClass = 'badge-info';

                return `
                    <tr>
                        <td data-label="Date & Time"><small>${new Date(t.transactionDate).toLocaleString()}</small></td>
                        <td data-label="Type"><span class="badge ${badgeClass}">${t.transactionType}</span></td>
                        <td data-label="Category"><strong>${t.category}</strong></td>
                        <td data-label="Amount">${formatPKR(t.amount)}</td>
                        <td data-label="Budget Effect" style="color:var(--text-muted)">${t.budgetEffect}% effect</td>
                        <td data-label="Description" class="desc-cell" title="${t.description || ''}">${t.description || '-'}</td>
                    </tr>
                `;
            }).join('');
        }

        function selectPresetRange() {
            const range = document.getElementById('filter-range').value;
            customDateFilterActive = false;
            if (range !== 'custom') {
                document.getElementById('filter-from').value = "";
                document.getElementById('filter-to').value = "";
                loadTransactions();
                return;
            }

            updateFilterAction();
        }

        function applyFiltersFromQuery() {
            const params = new URLSearchParams(window.location.search);
            const category = params.get('category');
            const type = params.get('type');
            const fromDate = params.get('fromDate');
            const toDate = params.get('toDate');
            const range = params.get('range');

            if (category) {
                const categorySelect = document.getElementById('filter-category');
                // Report links can contain categories that are not in the static dropdown options.
                if (![...categorySelect.options].some(option => option.value === category)) {
                    categorySelect.add(new Option(category, category));
                }
                categorySelect.value = category;
            }
            if (type) document.getElementById('filter-type').value = type;
            if (range) document.getElementById('filter-range').value = range;
            if (fromDate || toDate) {
                document.getElementById('filter-range').value = 'custom';
                customDateFilterActive = true;
                if (fromDate) document.getElementById('filter-from').value = fromDate;
                if (toDate) document.getElementById('filter-to').value = toDate;
            }
        }

        function handleFilterAction() {
            customDateFilterActive = document.getElementById('filter-range').value === 'custom';
            loadTransactions();
        }

        function resetFilters() {
            document.getElementById('filter-category').value = "";
            document.getElementById('filter-type').value = "";
            document.getElementById('filter-range').value = "month";
            document.getElementById('filter-from').value = "";
            document.getElementById('filter-to').value = "";
            customDateFilterActive = false;
            loadTransactions();
        }

        function updateFilterAction() {
            const resetButton = document.getElementById('transaction-reset-action');
            const category = document.getElementById('filter-category').value;
            const type = document.getElementById('filter-type').value;
            const range = document.getElementById('filter-range').value;
            const from = document.getElementById('filter-from').value;
            const to = document.getElementById('filter-to').value;
            const isFiltered = !!category || !!type || range !== 'month' || customDateFilterActive || !!from || !!to;
            resetButton.style.display = isFiltered ? 'inline-flex' : 'none';
        }

        function updateReportLink() {
            const params = new URLSearchParams({
                category: document.getElementById('filter-category').value,
                type: document.getElementById('filter-type').value,
                range: document.getElementById('filter-range').value
            });
            const from = document.getElementById('filter-from').value;
            const to = document.getElementById('filter-to').value;
            // Keep the PDF download using the same filters currently shown on screen.
            if (customDateFilterActive && from) params.set('fromDate', from);
            if (customDateFilterActive && to) params.set('toDate', to);
            document.getElementById('download-transaction-report').href = `/Transaction/DownloadReport?${params.toString()}`;
        }

        applyFiltersFromQuery();
        loadTransactions();
    </script>
}
