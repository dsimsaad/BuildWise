@model IEnumerable<BuildWise.Models.Property>

@{
    ViewData["Title"] = "My Properties";
    Layout = "_ModuleLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My Properties</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add New Property
    </a>
</div>

<div class="row">
    @if (!Model.Any())
    {
        <div class="col-12 text-center text-muted py-5">
            <i class="bi bi-house-door display-4"></i>
            <p class="mt-3">You don't have any properties yet.</p>
            <a asp-action="Create" class="btn btn-outline-primary">Add Your First Property</a>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <h5 class="card-title text-primary fw-bold">@item.PropertyName</h5>
                            <span class="badge bg-info text-dark">@item.Type?.TypeName</span>
                        </div>
                        <h6 class="card-subtitle mb-2 text-muted">
                            <i class="bi bi-geo-alt"></i> @item.Location, @item.City
                        </h6>
                        <ul class="list-unstyled mt-3 mb-0">
                            <li><strong>Area:</strong> @item.AreaSize @item.AreaUnit?.UnitName</li>
                            <li><strong>Status:</strong> @item.Status?.StatusName</li>
                            <li><strong>Added:</strong> @item.CreatedAt.ToString("MMM dd, yyyy")</li>
                        </ul>
                    </div>
                    <div class="card-footer bg-transparent border-0 text-end">
                        <a asp-action="Details" asp-route-id="@item.PropertyId" class="btn btn-sm btn-outline-info">Details</a>
                        <a asp-action="Edit" asp-route-id="@item.PropertyId" class="btn btn-sm btn-outline-secondary">Edit</a>
                    </div>
                </div>
            </div>
        }
    }
</div>
