@model IEnumerable<BuildWise.Models.Property>

@{
    ViewData["Title"] = "Properties";
    Layout = "_ModuleLayout";
    bool isProjectScoped = ViewBag.IsProjectScoped == true;
    string? activeProjectName = ViewBag.ActiveProjectName as string;
    int? selectedProjectId = ViewBag.SelectedProjectId is int projectId ? projectId : null;
    var completedProperties = Model.Count(p => string.Equals(p.Status?.StatusName, "Completed", StringComparison.OrdinalIgnoreCase));
    var openProperties = Model.Count() - completedProperties;

    string StatusBadgeClass(string? statusName)
    {
        var normalized = (statusName ?? "").Trim().ToLowerInvariant();
        return normalized switch
        {
            "completed" => "badge-success",
            "under construction" => "badge-warning",
            "on hold" => "badge-danger",
            "planned" => "badge-info",
            _ => "badge-info"
        };
    }
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/modules.css" asp-append-version="true">
}

<div class="module-header">
    <div class="module-title">
        <h1>@(isProjectScoped ? $"Properties - {activeProjectName}" : "Properties")</h1>
        <p>@(isProjectScoped ? "Showing land, buildings, and sites linked to the active project." : "Manage land, buildings, and sites linked to your projects.")</p>
    </div>
    <a asp-action="Create" asp-route-projectId="@selectedProjectId" class="btn-create">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Add Property
    </a>
</div>

<div class="summary-grid">
    <div class="sum-card">
        <div class="sum-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18"></path><path d="M5 21V8l7-5 7 5v13"></path><path d="M9 21v-6h6v6"></path></svg>
        </div>
        <div class="sum-info">
            <h3>Total Properties</h3>
            <p>@Model.Count()</p>
        </div>
    </div>
    <div class="sum-card">
        <div class="sum-icon" style="background:#DCFCE7; color:#10B981;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20V10"></path><path d="M18 20V4"></path><path d="M6 20v-6"></path></svg>
        </div>
        <div class="sum-info">
            <h3>Linked to Projects</h3>
            <p>@Model.Count(p => p.ProjectId.HasValue)</p>
        </div>
    </div>
    <div class="sum-card">
        <div class="sum-icon" style="background:#FEF3C7; color:#F59E0B;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </div>
        <div class="sum-info">
            <h3>Completed</h3>
            <p>@completedProperties</p>
        </div>
    </div>
    <div class="sum-card">
        <div class="sum-icon" style="background:#EFF6FF; color:#1D4ED8;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 8v4l3 2"></path></svg>
        </div>
        <div class="sum-info">
            <h3>Open / Pending</h3>
            <p>@openProperties</p>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18"></path><path d="M5 21V8l7-5 7 5v13"></path><path d="M9 21v-6h6v6"></path></svg>
        <h2>No properties yet</h2>
        <p>@(isProjectScoped ? "Add a property for this project so the site record stays connected." : "Add your first property so projects can be linked to a real site.")</p>
        <a asp-action="Create" asp-route-projectId="@selectedProjectId" class="btn-primary">Add Property</a>
    </div>
}
else
{
    <div class="module-card">
        <div class="card-header">
            <h2>@(isProjectScoped ? "Project Properties" : "All Properties")</h2>
            <span class="badge badge-info">@Model.Count() records</span>
        </div>
        <div class="card-body" style="padding: 0;">
            <div class="table-responsive">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>Property Name</th>
                            <th>Project</th>
                            <th>Location</th>
                            <th>Type</th>
                            <th>Area</th>
                            <th>Status</th>
                            <th>Added</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.PropertyName</strong></td>
                            <td>@(item.Project?.ProjectName ?? "Unassigned")</td>
                            <td style="max-width: 220px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@item.Location@(string.IsNullOrWhiteSpace(item.City) ? "" : ", " + item.City)</td>
                            <td>@(item.Type?.TypeName ?? "-")</td>
                            <td>@item.AreaSize @item.AreaUnit?.UnitName</td>
                            <td><span class="badge @StatusBadgeClass(item.Status?.StatusName)">@(item.Status?.StatusName ?? "-")</span></td>
                            <td>@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                <div class="action-btns">
                                    <a asp-action="Edit" asp-route-id="@item.PropertyId" class="btn-icon btn-edit" title="Edit" aria-label="Edit @item.PropertyName">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.PropertyId" class="btn-icon btn-view" title="Details" aria-label="View @item.PropertyName details">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                    </a>
                                    <form asp-action="Delete" method="post" class="inline-delete-form" onsubmit="return confirm('Are you sure you want to delete this property?');">
                                        <input type="hidden" name="id" value="@item.PropertyId" />
                                        <button type="submit" class="btn-icon btn-delete" title="Delete" aria-label="Delete @item.PropertyName">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
