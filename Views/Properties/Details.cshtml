@model BuildWise.Models.Property

@{
    ViewData["Title"] = "Property Details";
    Layout = "_ModuleLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/modules.css">
}

<div class="module-header">
    <div class="module-title">
        <h1>@Model.PropertyName</h1>
        <p>@Model.Location@(string.IsNullOrWhiteSpace(Model.City) ? "" : ", " + Model.City)</p>
    </div>
    <div class="entity-actions">
        <a asp-action="Index" class="btn-secondary">Back</a>
        <a asp-action="Edit" asp-route-id="@Model.PropertyId" class="btn-primary">Edit Property</a>
    </div>
</div>

<div class="detail-grid">
    <div class="module-card">
        <div class="card-header">
            <h2>Property Information</h2>
            <span class="badge badge-info">@Model.Type?.TypeName</span>
        </div>
        <div class="card-body">
            <div class="detail-list">
                <div class="detail-row">
                    <span>Status</span>
                    <strong>@Model.Status?.StatusName</strong>
                </div>
                <div class="detail-row">
                    <span>Area</span>
                    <strong>@Model.AreaSize @Model.AreaUnit?.UnitName</strong>
                </div>
                <div class="detail-row">
                    <span>Location</span>
                    <strong>@Model.Location</strong>
                </div>
                <div class="detail-row">
                    <span>City</span>
                    <strong>@(string.IsNullOrWhiteSpace(Model.City) ? "-" : Model.City)</strong>
                </div>
                <div class="detail-row">
                    <span>Added</span>
                    <strong>@Model.CreatedAt.ToString("MMM dd, yyyy")</strong>
                </div>
                <div class="detail-row">
                    <span>Notes</span>
                    <strong>@(string.IsNullOrWhiteSpace(Model.Notes) ? "-" : Model.Notes)</strong>
                </div>
            </div>
        </div>
    </div>

    <div class="module-card">
        <div class="card-header">
            <h2>Associated Projects</h2>
            <span class="badge badge-info">@(Model.Projects?.Count ?? 0)</span>
        </div>
        <div class="card-body">
            @if (Model.Projects != null && Model.Projects.Any())
            {
                <div class="detail-list">
                    @foreach (var project in Model.Projects)
                    {
                        <div class="detail-row" style="grid-template-columns: 1fr auto;">
                            <strong>@project.ProjectName</strong>
                            <a asp-controller="Projects" asp-action="Details" asp-route-id="@project.ProjectId" class="btn-secondary">Open</a>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state" style="box-shadow:none; padding:28px 18px;">
                    <h2>No linked projects</h2>
                    <p>Start a project to connect it with this property.</p>
                    <a asp-controller="Projects" asp-action="Create" class="btn-primary">New Project</a>
                </div>
            }
        </div>
    </div>
</div>
