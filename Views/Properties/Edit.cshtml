@model BuildWise.Models.Property

@{
    ViewData["Title"] = "Edit Property";
    Layout = "_ModuleLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/modules.css">
}

<div class="module-header">
    <div class="module-title">
        <h1>Edit Property</h1>
        <p>Update the details for @Model.PropertyName.</p>
    </div>
    <a asp-action="Index" class="btn-secondary">Back to Properties</a>
</div>

<div class="module-card">
    <div class="card-header">
        <h2>Property Details</h2>
    </div>
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="PropertyId" />

            <div class="form-grid">
                <div class="form-group full-width">
                    <label asp-for="PropertyName">Property Name</label>
                    <input asp-for="PropertyName" class="form-control" />
                    <span asp-validation-for="PropertyName" class="text-danger"></span>
                </div>

                <div class="form-group full-width">
                    <label asp-for="ProjectId">Project</label>
                    <select asp-for="ProjectId" class="form-control" asp-items="ViewBag.ProjectId">
                        <option value="">No project selected</option>
                    </select>
                    <span asp-validation-for="ProjectId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TypeId">Property Type</label>
                    <select asp-for="TypeId" class="form-control" asp-items="ViewBag.TypeId"></select>
                    <span asp-validation-for="TypeId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="StatusId">Status</label>
                    <select asp-for="StatusId" class="form-control" asp-items="ViewBag.StatusId"></select>
                    <span asp-validation-for="StatusId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Location">Location</label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="City">City</label>
                    <input asp-for="City" class="form-control" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="AreaSize">Area Size</label>
                    <input asp-for="AreaSize" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="AreaSize" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="AreaUnitId">Area Unit</label>
                    <select asp-for="AreaUnitId" class="form-control" asp-items="ViewBag.AreaUnitId"></select>
                    <span asp-validation-for="AreaUnitId" class="text-danger"></span>
                </div>

                <div class="form-group full-width">
                    <label asp-for="Notes">Notes</label>
                    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>
            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn-secondary">Cancel</a>
                <button type="submit" class="btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
