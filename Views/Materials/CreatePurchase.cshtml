@model BuildWise.Models.MaterialPurchase

@{
    var isEdit = Model?.PurchaseId > 0;
    var pageTitle = isEdit ? "Edit Material Purchase" : "Log Material Purchase";
    var formAction = isEdit ? "EditPurchase" : "CreatePurchase";
    var purchaseDate = Model?.PurchaseDate == default ? DateTime.Today.ToString("yyyy-MM-dd") : Model!.PurchaseDate.ToString("yyyy-MM-dd");
    ViewData["Title"] = pageTitle;
    Layout = "_ModuleLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/modules.css" asp-append-version="true">
}

<div class="module-header">
    <div class="module-title">
        <h1>@pageTitle</h1>
        <p>@(isEdit ? "Update quantity, date, and cost for this purchase." : "Record material quantity, date, and cost for the active project.")</p>
    </div>
    <a asp-action="Index" class="btn-secondary">Back to Purchases</a>
</div>

<div class="module-card">
    <div class="card-header">
        <h2>Purchase Details</h2>
    </div>
    <div class="card-body">
        <form asp-action="@formAction" asp-route-id="@(isEdit ? (int?)Model!.PurchaseId : null)" method="post">
            @if (isEdit)
            {
                <input asp-for="PurchaseId" type="hidden" />
            }
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="MaterialId">Material</label>
                    <select asp-for="MaterialId" class="form-control" asp-items="ViewBag.MaterialId">
                        <option value="">Select material</option>
                    </select>
                    <span asp-validation-for="MaterialId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Quantity">Quantity</label>
                    <input asp-for="Quantity" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="UnitId">Unit</label>
                    <select asp-for="UnitId" class="form-control" asp-items="ViewBag.UnitId"></select>
                    <span asp-validation-for="UnitId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="UnitPrice">Unit Price (PKR)</label>
                    <input asp-for="UnitPrice" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="UnitPrice" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PurchaseDate">Purchase Date</label>
                    <input asp-for="PurchaseDate" class="form-control" type="date" value="@purchaseDate" />
                    <span asp-validation-for="PurchaseDate" class="text-danger"></span>
                </div>

                <div class="form-group full-width">
                    <label asp-for="Notes">Notes</label>
                    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>
            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn-secondary">Cancel</a>
                <button type="submit" class="btn-primary">@(isEdit ? "Save Changes" : "Log Purchase")</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
