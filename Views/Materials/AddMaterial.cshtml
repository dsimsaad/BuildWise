@model BuildWise.Models.Material

@{
    var isEdit = Model?.MaterialId > 0;
    var pageTitle = isEdit ? "Edit Material" : "Add Material";
    var formAction = isEdit ? "EditMaterial" : "AddMaterial";
    ViewData["Title"] = pageTitle;
    Layout = "_ModuleLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/modules.css" asp-append-version="true">
}

<div class="module-header">
    <div class="module-title">
        <h1>@pageTitle</h1>
        <p>@(isEdit ? "Update this custom catalog material." : "Create a reusable material type for purchase entries.")</p>
    </div>
    <a asp-action="Catalog" class="btn-secondary">Back to Catalog</a>
</div>

<div class="module-card">
    <div class="card-header">
        <h2>Material Details</h2>
    </div>
    <div class="card-body">
        <form asp-action="@formAction" asp-route-id="@(isEdit ? (int?)Model!.MaterialId : null)" method="post">
            @if (isEdit)
            {
                <input asp-for="MaterialId" type="hidden" />
            }
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="MaterialName">Material Name</label>
                    <input asp-for="MaterialName" class="form-control" placeholder="e.g. Portland Cement" />
                    <span asp-validation-for="MaterialName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="DefaultUnitId">Default Unit</label>
                    <select asp-for="DefaultUnitId" class="form-control" asp-items="ViewBag.DefaultUnitId">
                        <option value="">Select unit</option>
                    </select>
                    <span asp-validation-for="DefaultUnitId" class="text-danger"></span>
                </div>

                <div class="form-group full-width">
                    <label asp-for="Description">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>

            <div class="form-actions">
                <a asp-action="Catalog" class="btn-secondary">Cancel</a>
                <button type="submit" class="btn-primary">@(isEdit ? "Save Changes" : "Add Material")</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
