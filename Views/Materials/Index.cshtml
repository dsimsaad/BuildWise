@model IEnumerable<BuildWise.Models.MaterialPurchase>

@{
    ViewData["Title"] = "Material Purchases";
    Layout = "_ModuleLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-box-seam"></i> Material Purchases for Current Project</h2>
    <div>
        <a asp-action="Catalog" class="btn btn-outline-info me-2">Manage Material Catalog</a>
        <a asp-action="CreatePurchase" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Log Purchase
        </a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-cart-x display-4"></i>
                <p class="mt-3">No material purchases recorded for this project yet.</p>
                <a asp-action="CreatePurchase" class="btn btn-outline-primary">Log First Purchase</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Material</th>
                            <th>Supplier</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Total Cost</th>
                            <th>Invoice #</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.PurchaseDate.ToString("MMM dd, yyyy")</td>
                                <td><span class="fw-bold text-primary">@item.Material?.MaterialName</span></td>
                                <td>@(item.Supplier?.SupplierName ?? "Unknown Supplier")</td>
                                <td>@item.Quantity @item.Unit?.UnitName</td>
                                <td>@item.UnitPrice.ToString("C")</td>
                                <td><span class="badge bg-success">@((item.TotalCost ?? 0).ToString("C"))</span></td>
                                <td>@item.InvoiceNumber</td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a asp-action="LogUsage" asp-route-purchaseId="@item.PurchaseId" class="btn btn-sm btn-outline-success"><i class="bi bi-arrow-right-circle"></i> Log Usage</a>
                                        <form asp-action="DeletePurchase" method="post" onsubmit="return confirm('Delete this purchase? This affects project costs.');">
                                            <input type="hidden" name="id" value="@item.PurchaseId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
