@model IEnumerable<BuildWise.Models.MaterialPurchase>
@using System.Globalization

@{
    ViewData["Title"] = "Material Purchases";
    Layout = "_ModuleLayout";
    var totalCost = Model.Sum(m => m.TotalCost ?? 0);
    var materialTypeCount = Model.Select(m => m.MaterialId).Distinct().Count();
    var avgUnitPrice = Model.Any() ? Model.Average(m => m.UnitPrice) : 0;
    var inventory = Model
        .GroupBy(m => new
        {
            m.MaterialId,
            MaterialName = m.Material?.MaterialName ?? "Unknown Material",
            UnitName = m.Unit?.UnitName ?? ""
        })
        .Select(g => new
        {
            g.Key.MaterialName,
            g.Key.UnitName,
            Purchased = g.Sum(x => x.Quantity),
            Used = g.Sum(x => x.MaterialUsages.Sum(u => u.QuantityUsed)),
            AverageUnitPrice = g.Average(x => x.UnitPrice),
            Cost = g.Sum(x => x.TotalCost ?? 0),
            Purchases = g.Count()
        })
        .Select(x => new
        {
            x.MaterialName,
            x.UnitName,
            x.Purchased,
            x.Used,
            Available = Math.Max(0, x.Purchased - x.Used),
            x.AverageUnitPrice,
            x.Cost,
            x.Purchases
        })
        .OrderBy(x => x.MaterialName)
        .ToList();
    var pkrCulture = new CultureInfo("en-IN");
    string FormatPkr(decimal value)
    {
        var abs = Math.Abs(value);
        static string Trimmed(decimal amount) => amount.ToString(amount < 10 && amount % 1 != 0 ? "0.##" : "0.#", CultureInfo.InvariantCulture);
        if (abs >= 10000000) return $"PKR {Trimmed(value / 10000000)}Cr";
        if (abs >= 100000) return $"PKR {Trimmed(value / 100000)}L";
        return $"PKR {value.ToString("N0", new CultureInfo("en-IN"))}";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/modules.css">
    <style>
        .material-table-card .card-header {
            padding: 14px 22px;
            background: #FFFFFF;
        }

        .material-table-card .card-body {
            padding: 0;
        }

        .material-table-card .table-responsive {
            border-top: 1px solid #DCE8F7;
        }

        .material-table-card .modern-table th {
            padding-top: 11px;
            padding-bottom: 11px;
        }

        .material-message {
            margin-bottom: 18px;
            justify-content: flex-start;
        }

        .btn-return {
            background: #ECFDF5;
            color: #047857;
        }

        .btn-return:disabled {
            opacity: 0.45;
            cursor: not-allowed;
            transform: none;
        }

        .return-modal {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 2400;
            background: rgba(15, 23, 42, 0.48);
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .return-modal.is-open {
            display: flex;
        }

        .return-dialog {
            width: min(440px, 100%);
            background: #FFFFFF;
            border: 1px solid #DCE8F7;
            border-radius: 3px;
            box-shadow: 0 24px 70px rgba(15, 23, 42, 0.26);
        }

        .return-dialog-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 16px;
            padding: 18px 20px;
            border-bottom: 1px solid #E2E8F0;
        }

        .return-dialog-header h2 {
            margin: 0 0 4px;
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-main);
        }

        .return-dialog-header p {
            margin: 0;
            color: var(--text-muted);
            font-size: 0.82rem;
        }

        .return-close {
            border: none;
            background: #F8FAFC;
            color: #64748B;
            width: 30px;
            height: 30px;
            border-radius: 3px;
            cursor: pointer;
            font-size: 1.1rem;
            line-height: 1;
        }

        .return-dialog-body {
            padding: 20px;
        }

        .return-meta {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
            margin-bottom: 16px;
        }

        .return-meta-item {
            background: #F8FAFC;
            border: 1px solid #E2E8F0;
            border-radius: 3px;
            padding: 10px;
        }

        .return-meta-item span {
            display: block;
            font-size: 0.68rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-bottom: 4px;
        }

        .return-meta-item strong {
            display: block;
            color: var(--text-main);
            font-size: 0.86rem;
        }
    </style>
}

<div class="module-header">
    <div class="module-title">
        <h1>Material Purchases</h1>
        <p>Track project material purchases, quantities, and costs.</p>
    </div>
    <div class="entity-actions">
        <a asp-action="Catalog" class="btn-secondary">Material Catalog</a>
        <a asp-action="CreatePurchase" class="btn-create">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Log Purchase
        </a>
    </div>
</div>

@if (TempData["MaterialMessage"] != null)
{
    <div class="badge badge-success material-message">@TempData["MaterialMessage"]</div>
}
@if (TempData["MaterialError"] != null)
{
    <div class="badge badge-danger material-message">@TempData["MaterialError"]</div>
}

<div class="summary-grid">
    <div class="sum-card">
        <div class="sum-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><path d="M3.3 7 12 12l8.7-5"></path><path d="M12 22V12"></path></svg>
        </div>
        <div class="sum-info">
            <h3>Purchases</h3>
            <p>@Model.Count()</p>
        </div>
    </div>
    <div class="sum-card">
        <div class="sum-icon" style="background:#DCFCE7; color:#10B981;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1v22"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
        </div>
        <div class="sum-info">
            <h3>Total Cost</h3>
            <p>@FormatPkr(totalCost)</p>
        </div>
    </div>
    <div class="sum-card">
        <div class="sum-icon" style="background:#FEF3C7; color:#F59E0B;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
        </div>
        <div class="sum-info">
            <h3>Material Types</h3>
            <p>@materialTypeCount</p>
        </div>
    </div>
    <div class="sum-card">
        <div class="sum-icon" style="background:#E0F2FE; color:#0284C7;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7 12 3 4 7l8 4 8-4Z"></path><path d="M4 7v10l8 4 8-4V7"></path></svg>
        </div>
        <div class="sum-info">
            <h3>Avg Unit Price</h3>
            <p>@FormatPkr(avgUnitPrice)</p>
        </div>
    </div>
</div>

<div class="module-card material-table-card" style="margin-bottom:24px;">
    <div class="card-header">
        <h2>Project Inventory</h2>
        <span class="badge badge-info">@inventory.Count material types</span>
    </div>
    <div class="card-body" style="padding:0;">
        @if (!inventory.Any())
        {
            <div class="empty-state" style="border:none; box-shadow:none; border-radius:0;">
                <h2>No materials logged</h2>
                <p>Log purchases to build project inventory.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>Material</th>
                            <th>Purchased</th>
                            <th>Used</th>
                            <th>Available</th>
                            <th>Avg Unit Price</th>
                            <th>Total Cost</th>
                            <th>Purchases</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in inventory)
                        {
                            <tr>
                                <td><strong>@item.MaterialName</strong></td>
                                <td>@item.Purchased.ToString("N2") @item.UnitName</td>
                                <td>@item.Used.ToString("N2") @item.UnitName</td>
                                <td><strong>@item.Available.ToString("N2") @item.UnitName</strong></td>
                                <td>@FormatPkr(item.AverageUnitPrice)</td>
                                <td><strong>@FormatPkr(item.Cost)</strong></td>
                                <td>@item.Purchases</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="module-card material-table-card">
    <div class="card-header">
        <h2>Project Purchases</h2>
        <span class="badge badge-info">@Model.Count() records</span>
    </div>
    <div class="card-body" style="padding:0;">
        @if (!Model.Any())
        {
            <div class="empty-state" style="border:none; box-shadow:none; border-radius:0;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"></path></svg>
                <h2>No material purchases yet</h2>
                <p>Log the first purchase for the active project.</p>
                <a asp-action="CreatePurchase" class="btn-primary">Log Purchase</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Material</th>
                            <th>Quantity</th>
                            <th>Used</th>
                            <th>Available</th>
                            <th>Unit Price</th>
                            <th>Total Cost</th>
                            <th>Notes</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var usedQuantity = item.MaterialUsages.Sum(u => u.QuantityUsed);
                            var availableQuantity = Math.Max(0, item.Quantity - usedQuantity);
                            var canReturn = availableQuantity > 0;
                            <tr>
                                <td>@item.PurchaseDate.ToString("MMM dd, yyyy")</td>
                                <td><strong>@item.Material?.MaterialName</strong></td>
                                <td>@item.Quantity @item.Unit?.UnitName</td>
                                <td>@usedQuantity.ToString("N2") @item.Unit?.UnitName</td>
                                <td><strong>@availableQuantity.ToString("N2") @item.Unit?.UnitName</strong></td>
                                <td>@FormatPkr(item.UnitPrice)</td>
                                <td><strong>@FormatPkr(item.TotalCost ?? 0)</strong></td>
                                <td>@(string.IsNullOrWhiteSpace(item.Notes) ? "-" : item.Notes)</td>
                                <td>
                                    <div class="action-btns">
                                        <button type="button"
                                                class="btn-icon btn-return js-return-purchase"
                                                title="Return unused material"
                                                data-purchase-id="@item.PurchaseId"
                                                data-material="@item.Material?.MaterialName"
                                                data-unit="@item.Unit?.UnitName"
                                                data-available="@availableQuantity"
                                                data-unit-price="@item.UnitPrice"
                                                @(canReturn ? "" : "disabled")>
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 14 4 9l5-5"></path><path d="M4 9h11a5 5 0 0 1 0 10h-4"></path></svg>
                                        </button>
                                        <form asp-action="DeletePurchase" method="post" class="inline-delete-form" onsubmit="return confirm('Delete this purchase? This affects project costs.');">
                                            <input type="hidden" name="id" value="@item.PurchaseId" />
                                            <button type="submit" class="btn-icon btn-delete" title="Delete">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path></svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="return-modal" id="returnModal" aria-hidden="true">
    <div class="return-dialog">
        <div class="return-dialog-header">
            <div>
                <h2>Return Material</h2>
                <p id="returnMaterialName">Select unused quantity to return.</p>
            </div>
            <button type="button" class="return-close" data-return-close aria-label="Close">&times;</button>
        </div>
        <form asp-action="ReturnPurchase" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="returnPurchaseId" />
            <div class="return-dialog-body">
                <div class="return-meta">
                    <div class="return-meta-item">
                        <span>Available</span>
                        <strong id="returnAvailable">0</strong>
                    </div>
                    <div class="return-meta-item">
                        <span>Refund Value</span>
                        <strong id="returnAmount">PKR 0</strong>
                    </div>
                </div>

                <div class="form-group">
                    <label for="returnQuantity">Quantity to Return</label>
                    <input id="returnQuantity" name="returnQuantity" class="form-control" type="number" min="0.001" step="0.001" required />
                </div>

                <div class="form-group">
                    <label for="returnNotes">Notes</label>
                    <textarea id="returnNotes" name="returnNotes" class="form-control" rows="3" placeholder="Optional supplier or return reference"></textarea>
                </div>

                <div class="form-actions" style="margin-top:18px;">
                    <button type="button" class="btn-secondary" data-return-close>Cancel</button>
                    <button type="submit" class="btn-primary">Confirm Return</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const returnModal = document.getElementById('returnModal');
        const returnPurchaseId = document.getElementById('returnPurchaseId');
        const returnMaterialName = document.getElementById('returnMaterialName');
        const returnAvailable = document.getElementById('returnAvailable');
        const returnAmount = document.getElementById('returnAmount');
        const returnQuantity = document.getElementById('returnQuantity');
        const returnNotes = document.getElementById('returnNotes');
        let activeUnitPrice = 0;
        let activeUnit = '';

        function formatQty(value) {
            return Number(value || 0).toLocaleString('en-IN', { maximumFractionDigits: 3 });
        }

        function refreshReturnAmount() {
            const quantity = Number(returnQuantity.value || 0);
            returnAmount.textContent = formatPKR(quantity * activeUnitPrice);
        }

        document.querySelectorAll('.js-return-purchase').forEach(button => {
            button.addEventListener('click', () => {
                const available = Number(button.dataset.available || 0);
                activeUnitPrice = Number(button.dataset.unitPrice || 0);
                activeUnit = button.dataset.unit || '';

                returnPurchaseId.value = button.dataset.purchaseId;
                returnMaterialName.textContent = button.dataset.material || 'Return material';
                returnAvailable.textContent = `${formatQty(available)} ${activeUnit}`;
                returnQuantity.max = available;
                returnQuantity.value = available;
                returnNotes.value = '';
                refreshReturnAmount();

                returnModal.classList.add('is-open');
                returnModal.setAttribute('aria-hidden', 'false');
                returnQuantity.focus();
            });
        });

        returnQuantity?.addEventListener('input', refreshReturnAmount);

        document.querySelectorAll('[data-return-close]').forEach(button => {
            button.addEventListener('click', () => {
                returnModal.classList.remove('is-open');
                returnModal.setAttribute('aria-hidden', 'true');
            });
        });

        returnModal?.addEventListener('click', event => {
            if (event.target === returnModal) {
                returnModal.classList.remove('is-open');
                returnModal.setAttribute('aria-hidden', 'true');
            }
        });

        document.addEventListener('keydown', event => {
            if (event.key === 'Escape' && returnModal.classList.contains('is-open')) {
                returnModal.classList.remove('is-open');
                returnModal.setAttribute('aria-hidden', 'true');
            }
        });
    </script>
}
