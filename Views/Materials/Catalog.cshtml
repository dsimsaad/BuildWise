@model IEnumerable<BuildWise.Models.Material>

@{
    ViewData["Title"] = "My Material Catalog";
    Layout = "_ModuleLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-collection"></i> My Material Catalog</h2>
    <a asp-action="AddMaterial" class="btn btn-primary">
        <i class="bi bi-plus"></i> Add New Material Type
    </a>
</div>

<div class="row">
    @if (!Model.Any())
    {
        <div class="col-12 text-center text-muted py-5">
            <i class="bi bi-box display-4"></i>
            <p class="mt-3">Your material catalog is empty.</p>
            <p class="small">Add custom materials like Cement, Steel, or Bricks to start logging purchases.</p>
            <a asp-action="AddMaterial" class="btn btn-outline-primary mt-2">Add First Material</a>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="col-md-3 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <h5 class="card-title text-primary">@item.MaterialName</h5>
                        <h6 class="card-subtitle mb-2 text-muted">Unit: @item.DefaultUnit?.UnitName</h6>
                        <p class="card-text small">@item.Description</p>
                    </div>
                </div>
            </div>
        }
    }
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Project Purchases</a>
</div>
