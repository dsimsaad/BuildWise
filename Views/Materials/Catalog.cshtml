@model IEnumerable<BuildWise.Models.Material>

@{
    ViewData["Title"] = "Material Catalog";
    Layout = "_ModuleLayout";
    var currentUserId = ViewBag.CurrentUserId as int? ?? 0;
    var customCount = Model.Count(m => m.UserId == currentUserId);
    var defaultCount = Model.Count(m => m.UserId != currentUserId);
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/modules.css" asp-append-version="true">
}

@if (TempData["MaterialMessage"] != null)
{
    <div class="badge badge-success" style="margin-bottom:18px;">@TempData["MaterialMessage"]</div>
}
@if (TempData["MaterialError"] != null)
{
    <div class="badge badge-danger" style="margin-bottom:18px;">@TempData["MaterialError"]</div>
}

<div class="module-header">
    <div class="module-title">
        <h1>Material Catalog</h1>
        <p>Maintain reusable material types for project purchases.</p>
    </div>
    <div class="entity-actions">
        <a asp-action="Index" class="btn-secondary">Back to Purchases</a>
        <a asp-action="AddMaterial" class="btn-create">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Add Material
        </a>
    </div>
</div>

<div class="summary-grid">
    <div class="sum-card">
        <div class="sum-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
        </div>
        <div class="sum-info">
            <h3>Total Materials</h3>
            <p>@Model.Count()</p>
        </div>
    </div>
    <div class="sum-card">
        <div class="sum-icon" style="background:#DCFCE7; color:#10B981;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </div>
        <div class="sum-info">
            <h3>Active</h3>
            <p>@Model.Count(m => m.IsActive)</p>
        </div>
    </div>
    <div class="sum-card">
        <div class="sum-icon" style="background:#EFF6FF; color:#1D4ED8;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
        </div>
        <div class="sum-info">
            <h3>Custom</h3>
            <p>@customCount</p>
        </div>
    </div>
    <div class="sum-card">
        <div class="sum-icon" style="background:#FEF3C7; color:#F59E0B;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7 12 3 4 7l8 4 8-4Z"></path><path d="M4 7v10l8 4 8-4V7"></path></svg>
        </div>
        <div class="sum-info">
            <h3>Default</h3>
            <p>@defaultCount</p>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
        <h2>No materials in catalog</h2>
        <p>Add common materials like cement, steel, bricks, or paint.</p>
        <a asp-action="AddMaterial" class="btn-primary">Add Material</a>
    </div>
}
else
{
    <div class="entity-grid">
        @foreach (var item in Model)
        {
            var isCustom = item.UserId == currentUserId;
            <article class="entity-card">
                <div class="entity-card-header">
                    <div>
                        <h2 class="entity-card-title">@item.MaterialName</h2>
                        <div class="entity-card-subtitle">Default unit: @item.DefaultUnit?.UnitName</div>
                    </div>
                    <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap; justify-content:flex-end;">
                        <span class="badge @(isCustom ? "badge-info" : "badge-warning")">@(isCustom ? "Custom" : "Default")</span>
                        <span class="badge @(item.IsActive ? "badge-success" : "badge-danger")">@(item.IsActive ? "Active" : "Inactive")</span>
                    </div>
                </div>
                <p style="margin:0; color:var(--text-muted); font-size:0.875rem;">
                    @(string.IsNullOrWhiteSpace(item.Description) ? "No description added." : item.Description)
                </p>
                @if (isCustom)
                {
                    <div class="entity-actions" style="margin-top:16px;">
                        <a asp-action="EditMaterial" asp-route-id="@item.MaterialId" class="btn-secondary">Edit</a>
                        <form asp-action="ToggleMaterialActive" method="post" style="margin:0;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.MaterialId" />
                            <input type="hidden" name="isActive" value="@(!item.IsActive)" />
                            <button type="submit" class="@(item.IsActive ? "btn-danger" : "btn-primary")">@(item.IsActive ? "Deactivate" : "Activate")</button>
                        </form>
                    </div>
                }
            </article>
        }
    </div>
}
