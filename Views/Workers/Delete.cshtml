@model BuildWise.Models.Worker
@using System.Globalization

@{
    ViewData["Title"] = "Delete Worker";
    Layout = "_ModuleLayout";
    var pkrCulture = new CultureInfo("en-IN");
    string FormatPkr(decimal value) => $"PKR {value.ToString("N0", pkrCulture)}";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/modules.css">
}

<div class="module-header">
    <div class="module-title">
        <h1>Delete Worker</h1>
        <p>Are you sure you want to remove this worker? This action cannot be undone.</p>
    </div>
</div>

<div class="scaffold-detail-card" style="border-left: 4px solid #EF4444;">
    <dl>
        <dt>Full Name</dt>
        <dd><strong>@Html.DisplayFor(model => model.FullName)</strong></dd>

        <dt>Phone</dt>
        <dd>@Html.DisplayFor(model => model.Phone)</dd>

        <dt>CNIC</dt>
        <dd>@Html.DisplayFor(model => model.Cnic)</dd>

        <dt>Daily Wage</dt>
        <dd>@FormatPkr(Model.DailyWage)</dd>

        <dt>Skill Type</dt>
        <dd>@Html.DisplayFor(model => model.SkillType)</dd>

        <dt>Status</dt>
        <dd>
            @if (Model.IsActive) {
                <span class="badge badge-success">Active</span>
            } else {
                <span class="badge badge-danger">Inactive</span>
            }
        </dd>

        <dt>Contractor</dt>
        <dd>@(Model.Contractor?.FullName ?? "Independent Worker")</dd>
    </dl>

    <form asp-action="Delete" style="margin-top: 24px; padding-top: 16px; border-top: 1px solid #F1F5F9;">
        <input type="hidden" asp-for="WorkerId" />
        <div style="display: flex; gap: 12px; align-items: center;">
            <button type="submit" class="btn-primary" style="background: #EF4444;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path></svg>
                Delete Worker
            </button>
            <a asp-action="Index" class="back-link">← Back to List</a>
        </div>
    </form>
</div>
