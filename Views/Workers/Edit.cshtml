@model BuildWise.Models.Worker

@{
    ViewData["Title"] = "Edit Worker";
    Layout = "_ModuleLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/modules.css">
}

<div class="module-header">
    <div class="module-title">
        <h1>Edit Worker</h1>
        <p>Update worker details below.</p>
    </div>
</div>

<div class="scaffold-form-card">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger" style="color: #EF4444; font-size: 0.8125rem; margin-bottom: 16px;"></div>
        <input type="hidden" asp-for="WorkerId" />
        <div class="form-group">
            <label asp-for="ContractorId">Contractor</label>
            <select asp-for="ContractorId" class="form-control" asp-items="ViewBag.ContractorId"></select>
            <span asp-validation-for="ContractorId" class="text-danger" style="font-size: 0.75rem; color: #EF4444;"></span>
        </div>
        <div class="form-group">
            <label asp-for="FullName">Full Name</label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger" style="font-size: 0.75rem; color: #EF4444;"></span>
        </div>
        <div class="form-group">
            <label asp-for="Phone">Phone</label>
            <input asp-for="Phone" class="form-control" />
            <span asp-validation-for="Phone" class="text-danger" style="font-size: 0.75rem; color: #EF4444;"></span>
        </div>
        <div class="form-group">
            <label asp-for="Cnic">CNIC</label>
            <input asp-for="Cnic" class="form-control" />
            <span asp-validation-for="Cnic" class="text-danger" style="font-size: 0.75rem; color: #EF4444;"></span>
        </div>
        <div class="form-group">
            <label asp-for="DailyWage">Daily Wage (RS.)</label>
            <input asp-for="DailyWage" class="form-control" />
            <span asp-validation-for="DailyWage" class="text-danger" style="font-size: 0.75rem; color: #EF4444;"></span>
        </div>
        <div class="form-group">
            <label asp-for="SkillType">Skill Type</label>
            <input asp-for="SkillType" class="form-control" />
            <span asp-validation-for="SkillType" class="text-danger" style="font-size: 0.75rem; color: #EF4444;"></span>
        </div>
        <input type="hidden" asp-for="CreatedAt" />
        <div class="form-group" style="display: flex; align-items: center; gap: 8px;">
            <input class="form-check-input" asp-for="IsActive" style="width: 16px; height: 16px; accent-color: #1D4ED8;" />
            <label asp-for="IsActive" style="margin: 0; font-size: 0.875rem;">Active</label>
        </div>
        <div style="display: flex; gap: 12px; margin-top: 24px;">
            <button type="submit" class="btn-primary">Save Changes</button>
            <a asp-action="Index" class="back-link">← Back to List</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
