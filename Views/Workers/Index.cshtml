@model IEnumerable<BuildWise.Models.Worker>
@using System.Globalization

@{
    ViewData["Title"] = "Workers";
    Layout = "_ModuleLayout";
    var pkrCulture = new CultureInfo("en-IN");
    string FormatPkr(decimal value) => $"PKR {value.ToString("N0", pkrCulture)}";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/modules.css">
}

<div class="module-header">
    <div class="module-title">
        <h1>Workers</h1>
        <p>Manage your workforce and contractor assignments.</p>
    </div>
    <a asp-action="Create" class="btn-create">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Add Worker
    </a>
</div>

<div class="summary-grid">
    <div class="sum-card">
        <div class="sum-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
        </div>
        <div class="sum-info">
            <h3>Total Workers</h3>
            <p>@Model.Count()</p>
        </div>
    </div>
    <div class="sum-card">
        <div class="sum-icon" style="background:#DCFCE7; color:#10B981;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </div>
        <div class="sum-info">
            <h3>Active</h3>
            <p>@Model.Count(w => w.IsActive)</p>
        </div>
    </div>
    <div class="sum-card">
        <div class="sum-icon" style="background:#FEF2F2; color:#EF4444;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
        </div>
        <div class="sum-info">
            <h3>Inactive</h3>
            <p>@Model.Count(w => !w.IsActive)</p>
        </div>
    </div>
</div>

<div class="module-card">
    <div class="card-header">
        <h2>All Workers</h2>
        <span class="badge badge-info">@Model.Count() records</span>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th>Full Name</th>
                        <th>Phone</th>
                        <th>CNIC</th>
                        <th>Daily Wage</th>
                        <th>Skill</th>
                        <th>Status</th>
                        <th>Contractor</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td><strong>@Html.DisplayFor(modelItem => item.FullName)</strong></td>
                        <td>@Html.DisplayFor(modelItem => item.Phone)</td>
                        <td>@Html.DisplayFor(modelItem => item.Cnic)</td>
                        <td>@FormatPkr(item.DailyWage)</td>
                        <td><span class="badge badge-info">@Html.DisplayFor(modelItem => item.SkillType)</span></td>
                        <td>
                            @if (item.IsActive) {
                                <span class="badge badge-success">Active</span>
                            } else {
                                <span class="badge badge-danger">Inactive</span>
                            }
                        </td>
                        <td>@(item.Contractor?.FullName ?? "—")</td>
                        <td>
                            <div class="action-btns">
                                <a asp-action="Edit" asp-route-id="@item.WorkerId" class="btn-icon btn-edit" title="Edit">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.WorkerId" class="btn-icon" style="background:#F1F5F9; color:#64748B;" title="Details">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.WorkerId" class="btn-icon btn-delete" title="Delete">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path></svg>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
