@model BuildWise.Models.Worker
@using System.Globalization

@{
    ViewData["Title"] = "Worker Details";
    Layout = "_ModuleLayout";
    var pkrCulture = new CultureInfo("en-IN");
    string FormatPkr(decimal value)
    {
        var abs = Math.Abs(value);
        static string Trimmed(decimal amount) => amount.ToString(amount < 10 && amount % 1 != 0 ? "0.##" : "0.#", CultureInfo.InvariantCulture);
        if (abs >= 10000000) return $"PKR {Trimmed(value / 10000000)}Cr";
        if (abs >= 100000) return $"PKR {Trimmed(value / 100000)}L";
        return $"PKR {value.ToString("N0", new CultureInfo("en-IN"))}";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/modules.css">
}

<div class="module-header">
    <div class="module-title">
        <h1>Worker Details</h1>
        <p>View complete information about this worker.</p>
    </div>
</div>

<div class="scaffold-detail-card">
    <dl>
        <dt>Full Name</dt>
        <dd><strong>@Html.DisplayFor(model => model.FullName)</strong></dd>

        <dt>Phone</dt>
        <dd>@Html.DisplayFor(model => model.Phone)</dd>

        <dt>CNIC</dt>
        <dd>@Html.DisplayFor(model => model.Cnic)</dd>

        <dt>Daily Wage</dt>
        <dd>@FormatPkr(Model.DailyWage)</dd>

        <dt>Skill Type</dt>
        <dd><span class="badge badge-info">@Html.DisplayFor(model => model.SkillType)</span></dd>

        <dt>Created At</dt>
        <dd>@(Model.CreatedAt.ToString("MMM dd, yyyy"))</dd>

        <dt>Status</dt>
        <dd>
            @if (Model.IsActive) {
                <span class="badge badge-success">Active</span>
            } else {
                <span class="badge badge-danger">Inactive</span>
            }
        </dd>

        <dt>Contractor</dt>
        <dd>@(Model.Contractor?.FullName ?? "Independent Worker")</dd>
    </dl>

    <div style="display: flex; gap: 12px; margin-top: 24px; padding-top: 16px; border-top: 1px solid #F1F5F9;">
        <a asp-action="Edit" asp-route-id="@Model?.WorkerId" class="btn-primary" style="text-decoration: none;">Edit</a>
        <a asp-action="Index" class="back-link">← Back to List</a>
    </div>
</div>
