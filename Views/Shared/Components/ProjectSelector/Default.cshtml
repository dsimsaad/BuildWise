@model IEnumerable<BuildWise.Models.Project>
@{
    int? selectedId = ViewBag.SelectedProjectId;
    bool isOverallMode = ViewBag.IsOverallMode == true;
    var activeProject = Model.FirstOrDefault(p => p.ProjectId == selectedId);
    var activeTag = (string?)ViewBag.ActiveProjectTag ?? "Default";
}

<div class="project-selector-wrapper">
    <div class="project-selector-trigger" onclick="toggleProjectDropdown()">
        <div class="project-selector-info">
            <span class="value">@(isOverallMode ? "Overall Stats" : activeProject?.ProjectName ?? "No Project")</span>
            <span class="project-tag">@activeTag</span>
        </div>
        <svg class="chevron" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
    </div>

    <div id="projectDropdown" class="project-dropdown">
        @foreach (var proj in Model)
        {
            <div class="project-dropdown-row @(selectedId == proj.ProjectId ? "active" : "")">
                <form asp-controller="ProjectContext" asp-action="SetActiveProject" method="post" class="project-option-form">
                    <input type="hidden" name="projectId" value="@proj.ProjectId" />
                    <button type="submit" class="dropdown-item @(selectedId == proj.ProjectId ? "active" : "")">
                        <span class="dot" style="background: @(proj.IsCompleted ? "#10B981" : "#1D4ED8");"></span>
                        @proj.ProjectName
                    </button>
                </form>
                <div class="project-row-actions">
                    <a href="/Projects/Edit/@proj.ProjectId" title="Edit Project" class="project-action-link edit">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                    </a>
                    <a href="/Projects/Delete/@proj.ProjectId" title="Delete Project" class="project-action-link delete">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    </a>
                </div>
            </div>
        }

        <div class="dropdown-footer">
            <a href="/Projects/Create" class="add-project-btn">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                Add New Project
            </a>
        </div>
    </div>
</div>

<script>
    function toggleProjectDropdown() {
        const dd = document.getElementById('projectDropdown');
        dd.classList.toggle('show');
    }

    // Close when clicking outside
    window.addEventListener('click', function(e) {
        if (!document.querySelector('.project-selector-wrapper').contains(e.target)) {
            document.getElementById('projectDropdown').classList.remove('show');
        }
    });
</script>

<style>
    .project-selector-wrapper {
        position: relative;
        margin-right: 10px;
    }

    .project-selector-trigger {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 8px 12px;
        background: #FFFFFF;
        border: 1px solid var(--dash-border);
        border-radius: 3px;
        cursor: pointer;
        transition: all 0.2s;
        min-width: 220px;
        max-width: 240px;
    }

    .project-selector-trigger:hover {
        background: #F1F5F9;
        border-color: var(--dash-primary);
    }

    .project-selector-info {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-width: 0;
    }

    .project-selector-info .value {
        font-size: 0.84rem;
        font-weight: 600;
        color: var(--dash-navy);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .project-tag {
        margin-top: 2px;
        font-size: 0.64rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #1E40AF;
        background: #EFF6FF;
        border: 1px solid #DBEAFE;
        border-radius: 3px;
        display: inline-flex;
        width: fit-content;
        padding: 2px 8px;
    }

    .project-dropdown {
        display: none;
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        width: 280px;
        max-height: 320px;
        overflow-y: auto;
        background: white;
        border: 1px solid var(--dash-border);
        border-radius: 3px;
        box-shadow: var(--dash-shadow-md);
        z-index: 1100;
        padding: 8px;
        animation: fadeIn 0.2s ease;
    }

    .project-dropdown.show { display: block; }

    .project-dropdown-row {
        display: flex;
        align-items: center;
        border: 1px solid transparent;
        border-radius: 3px;
        margin-bottom: 3px;
        transition: background 0.15s ease, border-color 0.15s ease;
    }

    .project-dropdown-row:hover {
        background: #F8FAFC;
        border-color: #DBEAFE;
    }

    .project-dropdown-row.active {
        background: #EFF6FF;
        border-color: #1D4ED8;
    }

    .project-option-form {
        flex: 1;
        min-width: 0;
        margin: 0;
    }

    .dropdown-item {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border: none;
        background: transparent;
        border-radius: 0;
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--dash-text-main);
        cursor: pointer;
        text-align: left;
        transition: all 0.2s;
    }

    .dropdown-item:hover {
        background: transparent;
        color: var(--dash-primary);
    }

    .dropdown-item.active {
        background: transparent;
        color: var(--dash-primary);
        font-weight: 600;
    }

    .dropdown-item .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .project-row-actions {
        display: flex;
        align-items: center;
        gap: 4px;
        padding-right: 6px;
    }

    .project-action-link {
        width: 28px;
        height: 28px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid transparent;
        border-radius: 3px;
        color: #64748B;
        transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }

    .project-action-link:hover {
        background: #FFFFFF;
        border-color: #BFDBFE;
        color: #1D4ED8;
    }

    .project-action-link.delete {
        color: #EF4444;
    }

    .project-action-link.delete:hover {
        border-color: #FECACA;
        color: #DC2626;
    }

    .dropdown-footer {
        margin-top: 8px;
        padding: 8px 0 0;
        border-top: 1px solid var(--dash-border);
        display: flex;
        justify-content: center;
    }

    .add-project-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        max-width: 240px;
        padding: 10px;
        background: var(--dash-primary);
        color: white;
        text-align: center;
        text-decoration: none;
        border-radius: 3px;
        font-size: 0.8125rem;
        font-weight: 600;
        transition: opacity 0.2s;
    }

    .add-project-btn:hover {
        opacity: 0.9;
        color: white;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@media (max-width: 760px) {
        .project-selector-wrapper {
            margin-right: 0;
            width: 100%;
        }

        .project-selector-trigger {
            width: 100%;
            min-width: 0;
            max-width: none;
            min-height: 38px;
            padding: 7px 10px;
        }

        .project-selector-info {
            max-width: 100%;
        }

        .project-selector-info .value {
            max-width: 100%;
            font-size: 0.8rem;
        }

        .project-tag {
            max-width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-size: 0.58rem;
            padding: 2px 6px;
        }

        .project-dropdown {
            position: fixed;
            top: 58px;
            left: 12px;
            right: 12px;
            width: auto;
            max-height: min(420px, calc(100vh - 150px));
            border-radius: 8px;
            z-index: 2600;
        }

        .dropdown-item {
            min-height: 42px;
        }

        .project-action-link {
            width: 34px;
            height: 34px;
        }
    }
</style>
