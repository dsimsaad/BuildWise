<!-- Contact section -->
<section class="contact-section">
  <div class="contact-wrapper">
    <div class="contact-info reveal">
      <span class="contact-eyebrow">Get in Touch</span>
      <h1>Contact Us</h1>
      <p>We are available for questions, feedback, or collaboration opportunities. Let us know how we can help!</p>

      <div class="details-card">
        <h3>Contact Details</h3>

        <div class="detail-item">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <div class="detail-text">
            <strong>Phone</strong>
            <a href="tel:+923360714515">+923360714515</a>
          </div>
        </div>

        <div class="detail-item">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <div class="detail-text">
            <strong>Email</strong>
            <a href="mailto:buildwise.help@gmail.com">buildwise.help@gmail.com</a>
          </div>
        </div>
      </div>
    </div>

    <div class="contact-form-card reveal">
      <h2>Send us a message</h2>
      <form class="contact-form" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value="4752468f-734c-4d7c-8b63-3d8e6c4bcc03">
        <input type="hidden" name="from_name" value="BuildWise Contact Form">
        <input type="checkbox" name="botcheck" style="display:none;">
        <div class="form-row">
          <div class="input-group">
            <label>First Name</label>
            <input type="text" name="first_name" placeholder="First Name" required>
          </div>
          <div class="input-group">
            <label>Last Name</label>
            <input type="text" name="last_name" placeholder="Last Name" required>
          </div>
        </div>
        <div class="input-group">
          <label>Email</label>
          <input type="email" name="email" placeholder="you@example.com" required>
        </div>
        <div class="input-group">
          <label>Subject</label>
          <input type="text" name="subject" placeholder="How can we help?" required>
        </div>
        <div class="input-group">
          <label>Message</label>
          <textarea name="message" placeholder="Type your message here..." required></textarea>
        </div>
        <button type="submit" class="btn-submit">Send Message &nbsp;→</button>
      </form>
    </div>
  </div>
</section>
