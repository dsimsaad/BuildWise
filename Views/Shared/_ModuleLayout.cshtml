<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BuildWise</title>
    <link rel="stylesheet" href="~/assets/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/dashboard.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="dash-container">
        <!-- ══════════════ SIDEBAR ══════════════ -->
        <aside class="dash-sidebar">
            <div class="sidebar-header">
                <div class="logo-box">BW</div>
                <span class="logo-text">Build<span style="color: var(--dash-primary);">Wise</span></span>
            </div>

            <nav class="sidebar-nav">
                <a href="/Home/Dashboard" class="sidebar-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Dashboard" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="3" width="8" height="6" rx="2"/><rect x="13" y="3" width="8" height="10" rx="2"/><rect x="3" y="11" width="10" height="10" rx="2"/><rect x="15" y="15" width="6" height="6" rx="2"/></svg>
                    <span>Dashboard</span>
                </a>
                <a href="/Workers" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Workers" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4zm-1.5 2.5l1.5 3 1.5-3h-3z"/></svg>
                    <span>Workers</span>
                </a>
                <a href="/Budget" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Budget" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 6V4c0-1.1-.9-2-2-2h-4c-1.1 0-2 .9-2 2v2H4v2h2v11c0 1.66 1.34 3 3 3h6c1.66 0 3-1.34 3-3V8h2V6h-4zm-4 11c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/></svg>
                    <span>Budget & Expenses</span>
                </a>
                <a href="/Transaction" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Transaction" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12h-4l-3 9-6-18-3 9h-4v2h6l3-9 6 18 3-9h4z"/></svg>
                    <span>Transactions</span>
                </a>
                <a href="/Advisor" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Advisor" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M21 16.5v-9L12 2.5l-9 5v9l9 5 9-5zM12 15a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/></svg>
                    <span>Cost Advisor</span>
                </a>
                <a href="/Construction" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Construction" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 21H5c-1.1 0-2-.9-2-2V5c0-1.1.9-2 2-2h11l5 5v11c0 1.1-.9 2-2 2zm-4-12h4l-4-4v4zM5 19h14V11h-6V5H5v14z"/></svg>
                    <span>Construction</span>
                </a>
            </nav>
        </aside>

        <!-- ══════════════ MAIN AREA ══════════════ -->
        <main class="dash-main">
            <!-- Topbar -->
            <header class="dash-topbar">
                <div style="flex: 1;">
                    @await Component.InvokeAsync("ProjectSelector")
                </div>

                <div class="topbar-right">
                    <div class="user-profile">
                        <div class="user-avatar" style="display:flex;align-items:center;justify-content:center;background:#EFF6FF;">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="22" height="22" fill="#1D4ED8">
                                <path d="M256 288c79.5 0 144-64.5 144-144S335.5 0 256 0 112 64.5 112 144s64.5 144 144 144zm128 32h-55.1c-22.2 10.2-46.9 16-72.9 16s-50.6-5.8-72.9-16H128C57.3 320 0 377.3 0 448v16c0 26.5 21.5 48 48 48h416c26.5 0 48-21.5 48-48v-16c0-70.7-57.3-128-128-128z"/>
                            </svg>
                        </div>
                        <div class="user-info">
                            <h4>@(User.Identity?.Name ?? "BuildWise User")</h4>
                            <p>Project Manager</p>
                        </div>

                        <!-- Dropdown Menu -->
                        <div class="profile-menu">
                            <button class="profile-menu-item">
                                <svg data-name="Layer 2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16"><path d="m1.5 13v1a.5.5 0 0 0 .3379.4731 18.9718 18.9718 0 0 0 6.1621 1.0269 18.9629 18.9629 0 0 0 6.1621-1.0269.5.5 0 0 0 .3379-.4731v-1a6.5083 6.5083 0 0 0 -4.461-6.1676 3.5 3.5 0 1 0 -4.078 0 6.5083 6.5083 0 0 0 -4.461 6.1676zm4-9a2.5 2.5 0 1 1 2.5 2.5 2.5026 2.5026 0 0 1 -2.5-2.5zm2.5 3.5a5.5066 5.5066 0 0 1 5.5 5.5v.6392a18.08 18.08 0 0 1 -11 0v-.6392a5.5066 5.5066 0 0 1 5.5-5.5z"></path></svg>
                                Public profile
                            </button>
                            <form asp-controller="Account" asp-action="Logout" method="post" style="width: 100%;">
                                <button type="submit" class="profile-menu-item" style="width: 100%; border: none; background: none; text-align: left; color: #EF4444 !important;">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                                    Logout
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Content Area -->
            <div class="dash-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
