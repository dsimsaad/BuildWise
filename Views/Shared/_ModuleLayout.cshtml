<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BuildWise</title>
    <link rel="icon" type="image/png" href="~/assets/images/logo-72.png" asp-append-version="true" />
    <link rel="shortcut icon" type="image/png" href="~/assets/images/logo-72.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/dashboard.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    @RenderSection("Styles", required: false)
</head>
<body class="dashboard-body">
    <div class="dash-container">
        <!-- ══════════════ SIDEBAR ══════════════ -->
        <aside class="dash-sidebar">
            <div class="sidebar-header">
                <a href="/Home/Dashboard" class="sidebar-brand-link">
                    <img src="~/assets/images/logo-72.png" alt="BuildWise Logo" width="36" height="36" decoding="async" asp-append-version="true" />
                    <span class="logo-text">Build<span style="color: var(--dash-primary);">Wise</span></span>
                </a>
            </div>

            <nav class="sidebar-nav">
                @{
                    var controller = ViewContext.RouteData.Values["Controller"]?.ToString();
                    var action = ViewContext.RouteData.Values["Action"]?.ToString();
                }

                <a href="/Home/Dashboard" class="sidebar-link @(action == "Dashboard" ? "active" : "")">
                    <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="8" rx="1.5"></rect><rect x="14" y="3" width="7" height="5" rx="1.5"></rect><rect x="14" y="12" width="7" height="9" rx="1.5"></rect><rect x="3" y="15" width="7" height="6" rx="1.5"></rect></svg>
                    <span>Dashboard</span>
                </a>
                
                <div class="nav-group-title">Management</div>
                
                <a href="/Properties" class="sidebar-link @(controller == "Properties" ? "active" : "")">
                    <svg viewBox="0 0 24 24"><path d="M3 21h18"></path><path d="M5 21V8l7-5 7 5v13"></path><path d="M9 21v-6h6v6"></path></svg>
                    <span>Properties</span>
                </a>
                <a href="/Budget" class="sidebar-link @(controller == "Budget" ? "active" : "")">
                    <svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="2"></rect><path d="M3 10h18"></path><circle cx="16.5" cy="14" r="1.5"></circle></svg>
                    <span>Budget & Expenses</span>
                </a>
                <a href="/Materials" class="sidebar-link @(controller == "Materials" ? "active" : "")">
                    <svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><path d="M3.3 7 12 12l8.7-5"></path><path d="M12 22V12"></path></svg>
                    <span>Materials</span>
                </a>
                <a href="/Workers" class="sidebar-link @(controller == "Workers" ? "active" : "")">
                    <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"></path><circle cx="9.5" cy="7" r="3"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 4.13a3 3 0 0 1 0 5.74"></path></svg>
                    <span>Workers</span>
                </a>
                <a href="/Projects" class="sidebar-link @(controller == "Projects" ? "active" : "")">
                    <svg viewBox="0 0 24 24"><path d="M3 21h18"></path><path d="M5 21V7h6v14"></path><path d="M13 21V3h6v18"></path></svg>
                    <span>Projects</span>
                </a>
                <a href="/Transaction" class="sidebar-link @(controller == "Transaction" ? "active" : "")">
                    <svg viewBox="0 0 24 24"><path d="M7 7h10"></path><path d="M7 12h10"></path><path d="M11 17h6"></path><path d="M4 7h.01"></path><path d="M4 12h.01"></path><path d="M8 17h.01"></path></svg>
                    <span>Transactions</span>
                </a>

                <div class="nav-group-title">Analysis</div>
                
                <a href="/Construction" class="sidebar-link @(controller == "Construction" ? "active" : "")">
                    <svg viewBox="0 0 24 24"><path d="M3 21h18"></path><path d="M5 21V9l7-5 7 5v12"></path><path d="M9 21v-5h6v5"></path></svg>
                    <span>Construction</span>
                </a>
                <a href="/Advisor" class="sidebar-link @(controller == "Advisor" ? "active" : "")">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v4l3 2"></path></svg>
                    <span>Cost Advisor</span>
                </a>

                <div class="nav-group-title">Support</div>
                
                <a href="/Home/FAQ" class="sidebar-link @(action == "FAQ" ? "active" : "")">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M9.2 9.3a2.8 2.8 0 1 1 4.8 2c-.7.7-1.4 1.1-1.8 2"></path><circle cx="12" cy="16.8" r="0.8" fill="currentColor" stroke="none"></circle></svg>
                    <span>FAQs</span>
                </a>
                <a href="/Home/Contact" class="sidebar-link @(action == "Contact" ? "active" : "")">
                    <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 8 9 6 9-6"></path></svg>
                    <span>Contact</span>
                </a>
            </nav>
        </aside>

        <!-- ══════════════ MAIN AREA ══════════════ -->
        <main class="dash-main">
            <!-- Topbar -->
            <header class="dash-topbar">
                <div style="flex: 1;">
                    @await Component.InvokeAsync("ProjectSelector")
                </div>

                <div class="topbar-right">
                    <div class="user-profile">
                        <div class="user-avatar" style="display:flex;align-items:center;justify-content:center;background:#EFF6FF;">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="22" height="22" fill="#1D4ED8">
                                <path d="M256 288c79.5 0 144-64.5 144-144S335.5 0 256 0 112 64.5 112 144s64.5 144 144 144zm128 32h-55.1c-22.2 10.2-46.9 16-72.9 16s-50.6-5.8-72.9-16H128C57.3 320 0 377.3 0 448v16c0 26.5 21.5 48 48 48h416c26.5 0 48-21.5 48-48v-16c0-70.7-57.3-128-128-128z"/>
                            </svg>
                        </div>
                        <div class="user-info">
                            <h4>@(User.Identity?.Name ?? "BuildWise User")</h4>
                            <p>Project Manager</p>
                        </div>

                        <!-- Dropdown Menu -->
                        <div class="profile-menu">
                            <a asp-controller="Account" asp-action="Profile" class="profile-menu-item">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21a8 8 0 0 0-16 0"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                Profile
                            </a>
                            <form asp-controller="Account" asp-action="Logout" method="post" style="width: 100%;">
                                <button type="submit" class="profile-menu-item" style="width: 100%; border: none; background: none; text-align: left; color: #EF4444 !important;">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                                    Logout
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Content Area -->
            <div class="dash-content @ViewData["DashboardContentClass"]">
                @RenderBody()
            </div>
        </main>
    </div>

    <script>
        function formatPKR(value) {
            const amount = Number(value || 0);
            return 'PKR ' + amount.toLocaleString('en-IN', { maximumFractionDigits: 0 });
        }

        const sidebarNav = document.querySelector('.sidebar-nav');
        if (sidebarNav) {
            const sidebarScrollKey = 'buildwise.sidebar.scrollTop';
            const savedScrollTop = Number(sessionStorage.getItem(sidebarScrollKey) || 0);
            if (savedScrollTop > 0) {
                sidebarNav.scrollTop = savedScrollTop;
            }

            let scrollTimer;
            sidebarNav.addEventListener('scroll', function () {
                sessionStorage.setItem(sidebarScrollKey, String(sidebarNav.scrollTop));
                sidebarNav.classList.add('is-scrolling');
                clearTimeout(scrollTimer);
                scrollTimer = setTimeout(function () {
                    sidebarNav.classList.remove('is-scrolling');
                }, 800);
            });
        }
    </script>
    <script src="~/js/numeric-inputs.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
