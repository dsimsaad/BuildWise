<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - BuildWise</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/assets/css/dashboard.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
    @RenderSection("Styles", required: false)
</head>
<body class="dashboard-body">

    <div class="dash-wrapper">
        <!-- ══════════════ SIDEBAR ══════════════ -->
        <aside class="dash-sidebar">
            <div class="sidebar-header">
                <a href="/" style="text-decoration: none; display: flex; align-items: center; gap: 12px;">
                    <img src="~/logo.png" alt="BuildWise" class="sidebar-logo">
                    <span class="sidebar-brand">BuildWise</span>
                </a>
            </div>

            <nav class="sidebar-nav">
                <a href="/Home/Dashboard" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "Dashboard" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                    <span>Dashboard</span>
                </a>
                <a href="/Budget" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Budget" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                    <span>Budget & Expenses</span>
                </a>
                <a href="/Transaction" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Transaction" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                    <span>Transactions</span>
                </a>
                <a href="/Advisor" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Advisor" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    <span>Cost Advisor</span>
                </a>
                <a href="/Construction" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Construction" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                    <span>Construction</span>
                </a>

                <div style="margin-top: auto; padding-top: 20px; border-top: 1px solid var(--dash-border);">
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="sidebar-link" style="width: 100%; background: none; border: none; cursor: pointer; color: #ef4444;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                            <span>Logout</span>
                        </button>
                    </form>
                </div>
            </nav>
        </aside>

        <!-- ══════════════ MAIN AREA ══════════════ -->
        <main class="dash-main">
            <!-- Topbar -->
            <header class="dash-topbar">
                <div class="search-bar">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text" placeholder="Search...">
                </div>

                <div class="topbar-right">
                    <div class="notification-bell">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                        <span class="bell-dot"></span>
                    </div>

                    <div class="user-profile">
                        <img src="https://ui-avatars.com/api/?name=@(User.Identity?.Name ?? "User")&background=0f2557&color=fff" class="user-avatar" alt="User">
                        <div class="user-info">
                            <h4>@(User.Identity?.Name ?? "BuildWise User")</h4>
                            <p>Project Manager</p>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Content Area -->
            <div class="dash-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
