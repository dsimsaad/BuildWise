<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - BuildWise</title>
  <meta name="description" content="BuildWise helps you manage projects, track progress, organize teams, manage materials, and control budgets — all in one place." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <script src="https://cdn.lordicon.com/lordicon.js"></script>
  <link rel="stylesheet" href="~/assets/css/style.css">
</head>
<body>

<!-- ══════════════ NAVBAR ══════════════ -->
<nav>
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <img src="~/logo.png" alt="BuildWise Logo" style="width:36px;height:36px;object-fit:contain;" />
      <span class="logo-text">Build<span style="color: #1D4ED8;">Wise</span></span>
    </a>
    <ul class="nav-links">
      <li><a href="/" class="@((ViewContext.RouteData.Values["Action"]?.ToString() ?? "") == "Index" ? "active" : "")">Home</a></li>
      <li><a href="/Home/Features" class="@((ViewContext.RouteData.Values["Action"]?.ToString() ?? "") == "Features" ? "active" : "")">Features</a></li>
      <li><a href="/Home/FAQ" class="@((ViewContext.RouteData.Values["Action"]?.ToString() ?? "") == "FAQ" ? "active" : "")">FAQ</a></li>
      <li><a href="/Home/Contact" class="@((ViewContext.RouteData.Values["Action"]?.ToString() ?? "") == "Contact" ? "active" : "")">Contact</a></li>
    </ul>
    <div class="nav-right">
      @if (User.Identity?.IsAuthenticated == true)
      {
        <a href="/Home/Dashboard" class="btn-nav" style="margin-right: 10px; background: #1D4ED8;">Dashboard</a>
        <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
          <button type="submit" class="btn-nav" style="background: #f87171;">Logout</button>
        </form>
      }
      else
      {
        <a href="/Home/Login" class="btn-nav">Get Started</a>
      }
    </div>
    <button class="mobile-menu-btn" id="mobile-toggle">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
    </button>
  </div>
  <div class="mobile-nav-overlay" id="mobile-menu">
    <a href="/">Home</a>
    <a href="/Home/Features">Features</a>
    <a href="/Home/FAQ">FAQ</a>
    <a href="/Home/Contact">Contact</a>
    @if (User.Identity?.IsAuthenticated == true)
    {
      <a href="/Home/Dashboard">Dashboard</a>
      <form asp-controller="Account" asp-action="Logout" method="post">
        <button type="submit" class="btn-nav" style="width: 100%; margin-top: 10px; background: #f87171;">Logout</button>
      </form>
    }
    else
    {
      <a href="/Home/Login" class="btn-nav">Get Started</a>
    }
  </div>
</nav>

@RenderBody()

<!-- ══════════════ FOOTER ══════════════ -->
<footer>
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="nav-logo">
          <img src="~/logo.png" alt="BuildWise Logo" style="width:36px;height:36px;object-fit:contain;" />
          <span class="logo-text">Build<span style="color: #1D4ED8;">Wise</span></span>
        </a>
      </div>
      <div class="footer-col">
        <h4>Product</h4>
        <ul>
          <li><a href="/Home/Features">Features</a></li>
          <li><a href="#">Pricing</a></li>
          <li><a href="#">Updates</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Company</h4>
        <ul>
          <li><a href="#">About Us</a></li>
          <li><a href="#">Careers</a></li>
          <li><a href="/Home/Contact">Contact</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Support</h4>
        <ul>
          <li><a href="/Home/FAQ">FAQ</a></li>
          <li><a href="#">Help Center</a></li>
          <li><a href="#">Privacy Policy</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Follow Us</h4>
        <div class="social-icons">
          <a href="#" class="social-icon" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="#" class="social-icon" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
          <a href="#" class="social-icon" aria-label="Twitter">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg>
          </a>
          <a href="#" class="social-icon" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© 2026 BuildWise. All rights reserved.</p>
    </div>
  </div>
</footer>

<button class="back-to-top" id="backToTop" aria-label="Back to Top">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"></polyline></svg>
</button>

<script src="~/assets/js/main.js"></script>
</body>
</html>
