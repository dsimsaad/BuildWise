<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - BuildWise</title>
  <meta name="description" content="BuildWise helps you manage projects, track progress, organize teams, manage materials, and control budgets — all in one place." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/png" href="~/assets/images/logo-72.png" asp-append-version="true" />
  <link rel="shortcut icon" type="image/png" href="~/assets/images/logo-72.png" asp-append-version="true" />
  <link rel="stylesheet" href="~/assets/css/style.css" asp-append-version="true">
  @RenderSection("HeadScripts", required: false)
  @RenderSection("Styles", required: false)
</head>
<body>


<nav>
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <img src="~/assets/images/logo-72.png" alt="BuildWise Logo" width="36" height="36" style="width:36px;height:36px;object-fit:contain;" decoding="async" asp-append-version="true" />
      <span class="logo-text">Build<span style="color: #1D4ED8;">Wise</span></span>
    </a>
    <ul class="nav-links">
      <li><a href="/" class="@((ViewContext.RouteData.Values["Action"]?.ToString() ?? "") == "Index" ? "active" : "")">Home</a></li>
      <li><a href="/Home/Features" class="@((ViewContext.RouteData.Values["Action"]?.ToString() ?? "") == "Features" ? "active" : "")">Features</a></li>
      <li><a href="/Home/About" class="@((ViewContext.RouteData.Values["Action"]?.ToString() ?? "") == "About" ? "active" : "")">About</a></li>
      <li><a href="/Home/FAQ" class="@((ViewContext.RouteData.Values["Action"]?.ToString() ?? "") == "FAQ" ? "active" : "")">FAQ</a></li>
      <li><a href="/Home/Contact" class="@((ViewContext.RouteData.Values["Action"]?.ToString() ?? "") == "Contact" ? "active" : "")">Contact</a></li>
    </ul>
    <div class="nav-right">
        <a href="/Home/Login" class="btn-nav">Get Started</a>
    </div>
    <button class="mobile-menu-btn" id="mobile-toggle">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
    </button>
  </div>
  <div class="mobile-nav-overlay" id="mobile-menu">
    <a href="/">Home</a>
    <a href="/Home/Features">Features</a>
    <a href="/Home/About">About</a>
    <a href="/Home/FAQ">FAQ</a>
    <a href="/Home/Contact">Contact</a>
      <a href="/Home/Login" class="btn-nav">Get Started</a>
  </div>
</nav>

@RenderBody()


<footer>
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="nav-logo">
          <img src="~/assets/images/logo-72.png" alt="BuildWise Logo" width="36" height="36" style="width:36px;height:36px;object-fit:contain;" loading="lazy" decoding="async" asp-append-version="true" />
          <span class="logo-text">Build<span style="color: #1D4ED8;">Wise</span></span>
        </a>
      </div>
      <div class="footer-col">
        <h4>Product</h4>
        <ul>
          <li><a href="/Home/Features">Features</a></li>
          <li><a href="/Home/Login">Sign In</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Company</h4>
        <ul>
          <li><a href="/Home/About">About Us</a></li>
          <li><a href="/Home/Contact">Contact</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Support</h4>
        <ul>
          <li><a href="/Home/FAQ">FAQ</a></li>
          <li><a href="/Home/Contact">Contact Us</a></li>
          <li><a href="/Home/Privacy">Privacy Policy</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© 2026 BuildWise. All rights reserved.</p>
    </div>
  </div>
</footer>

<button class="back-to-top" id="backToTop" aria-label="Back to Top">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"></polyline></svg>
</button>

<script src="~/assets/js/main.js" asp-append-version="true" defer></script>
@RenderSection("Scripts", required: false)
</body>
</html>
