@{
    ViewData["Title"] = "Dashboard";
    Layout = null; // We are building a standalone dashboard experience
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - BuildWise</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/assets/css/dashboard.css">
</head>
<body class="dashboard-body">

    <div class="dash-wrapper">
        <!-- ══════════════ SIDEBAR ══════════════ -->
        <aside class="dash-sidebar">
            <div class="sidebar-header">
                <img src="~/logo.png" alt="BuildWise" class="sidebar-logo">
                <span class="sidebar-brand">BuildWise</span>
            </div>

            <nav class="sidebar-nav">
                <a href="#" class="sidebar-link active">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                    <span>Dashboard</span>
                </a>
                <a href="/Projects" class="sidebar-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                    <span>Projects</span>
                </a>
                <a href="/Workers" class="sidebar-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    <span>Workers</span>
                </a>
                <a href="/Budget" class="sidebar-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                    <span>Budget & Expenses</span>
                </a>
                <a href="/Transaction" class="sidebar-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                    <span>Transactions</span>
                </a>
                <a href="/Advisor" class="sidebar-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    <span>Cost Advisor</span>
                </a>
                <a href="/Construction" class="sidebar-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                    <span>Construction</span>
                </a>

                <div style="margin-top: auto; padding-top: 20px; border-top: 1px solid var(--dash-border);">
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="sidebar-link" style="width: 100%; background: none; border: none; cursor: pointer; color: #ef4444;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                            <span>Logout</span>
                        </button>
                    </form>
                </div>
            </nav>
        </aside>

        <!-- ══════════════ MAIN AREA ══════════════ -->
        <main class="dash-main">
            <!-- Topbar -->
            <header class="dash-topbar">
                <div class="search-bar">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text" placeholder="Search projects, tasks...">
                </div>

                <div class="topbar-right">
                    <div class="notification-bell">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                        <span class="bell-dot"></span>
                    </div>

                    <div class="user-profile">
                        <img src="https://ui-avatars.com/api/?name=@(User.Identity?.Name ?? "User")&background=0f2557&color=fff" class="user-avatar" alt="User">
                        <div class="user-info">
                            <h4>@(User.Identity?.Name ?? "BuildWise User")</h4>
                            <p>Project Manager</p>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Dashboard Content -->
            <div class="dash-content">
                <div class="content-header">
                    <h1>Dashboard</h1>
                    <div class="date-selector">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        <span>@DateTime.Now.ToString("MMM dd, yyyy")</span>
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    </div>
                </div>

                <!-- Stats Grid -->
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-header">
                            <span class="stat-label">Total Projects</span>
                            <div class="stat-icon" style="background: rgba(37, 99, 235, 0.1); color: #2563eb;">
                                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                            </div>
                        </div>
                        <h2 class="stat-value">6</h2>
                        <span class="stat-trend trend-up">2 in progress</span>
                    </div>

                    <div class="stat-card">
                        <div class="stat-header">
                            <span class="stat-label">Total Tasks</span>
                            <div class="stat-icon" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">
                                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                            </div>
                        </div>
                        <h2 class="stat-value">48</h2>
                        <span class="stat-trend trend-up">12 pending</span>
                    </div>

                    <div class="stat-card">
                        <div class="stat-header">
                            <span class="stat-label">Total Budget</span>
                            <div class="stat-icon" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6;">
                                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                            </div>
                        </div>
                        <h2 class="stat-value">₹ 2.45 Cr</h2>
                        <span class="stat-trend trend-up">66% utilized</span>
                    </div>

                    <div class="stat-card">
                        <div class="stat-header">
                            <span class="stat-label">Total Expenses</span>
                            <div class="stat-icon" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                            </div>
                        </div>
                        <h2 class="stat-value">₹ 1.62 Cr</h2>
                        <span class="stat-trend trend-up">66% of budget</span>
                    </div>
                </div>

                <!-- Main Content Grid -->
                <div class="main-grid">
                    <!-- Project Progress -->
                    <div class="dash-card">
                        <div class="card-header">
                            <h3>Project Progress</h3>
                            <a href="#" class="view-all">View all</a>
                        </div>
                        <div class="project-list">
                            <div class="project-item">
                                <div class="project-info">
                                    <img src="https://images.unsplash.com/photo-1590644365607-1c5a519a7a37?q=80&w=100&auto=format&fit=crop" class="project-img" alt="Project">
                                    <span class="project-name">Green Valley Apartments</span>
                                    <span class="project-pct">72%</span>
                                </div>
                                <div class="progress-container">
                                    <div class="progress-bar" style="width: 72%; background: #2563eb;"></div>
                                </div>
                            </div>
                            <div class="project-item">
                                <div class="project-info">
                                    <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=100&auto=format&fit=crop" class="project-img" alt="Project">
                                    <span class="project-name">Skyline Tower</span>
                                    <span class="project-pct">45%</span>
                                </div>
                                <div class="progress-container">
                                    <div class="progress-bar" style="width: 45%; background: #10b981;"></div>
                                </div>
                            </div>
                            <div class="project-item">
                                <div class="project-info">
                                    <img src="https://images.unsplash.com/photo-1503387762-592dee58c160?q=80&w=100&auto=format&fit=crop" class="project-img" alt="Project">
                                    <span class="project-name">Heritage Plaza</span>
                                    <span class="project-pct">30%</span>
                                </div>
                                <div class="progress-container">
                                    <div class="progress-bar" style="width: 30%; background: #f59e0b;"></div>
                                </div>
                            </div>
                            <div class="project-item">
                                <div class="project-info">
                                    <img src="https://images.unsplash.com/photo-1512917774080-9991f1c4c750?q=80&w=100&auto=format&fit=crop" class="project-img" alt="Project">
                                    <span class="project-name">Sunrise Villas</span>
                                    <span class="project-pct">60%</span>
                                </div>
                                <div class="progress-container">
                                    <div class="progress-bar" style="width: 60%; background: #3b82f6;"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Budget Overview -->
                    <div class="dash-card">
                        <div class="card-header">
                            <h3>Budget Overview</h3>
                        </div>
                        <div class="budget-overview">
                            <div class="donut-placeholder">
                                <div class="donut-inner">
                                    <span class="total-amount">₹ 2.45 Cr</span>
                                    <span class="label">Total Budget</span>
                                </div>
                            </div>
                            <div class="budget-legend">
                                <div class="legend-item">
                                    <span class="legend-dot" style="background: #2563eb;"></span>
                                    <span>Labor Cost: ₹ 1.10 Cr</span>
                                </div>
                                <div class="legend-item">
                                    <span class="legend-dot" style="background: #10b981;"></span>
                                    <span>Material Cost: ₹ 0.85 Cr</span>
                                </div>
                                <div class="legend-item">
                                    <span class="legend-dot" style="background: #f59e0b;"></span>
                                    <span>Equipment Cost: ₹ 0.30 Cr</span>
                                </div>
                                <div class="legend-item">
                                    <span class="legend-dot" style="background: #e2e8f0;"></span>
                                    <span>Others: ₹ 0.20 Cr</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Activities -->
                    <div class="dash-card">
                        <div class="card-header">
                            <h3>Recent Activities</h3>
                            <a href="#" class="view-all">View all</a>
                        </div>
                        <div class="activity-list">
                            <div class="activity-item">
                                <div class="activity-icon" style="color: #f59e0b;">
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
                                </div>
                                <div class="activity-content">
                                    <p class="activity-title">Site inspection completed</p>
                                    <p class="activity-desc">Green Valley Apartments</p>
                                </div>
                                <span class="activity-time">2h ago</span>
                            </div>
                            <div class="activity-item">
                                <div class="activity-icon" style="color: #2563eb;">
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                                </div>
                                <div class="activity-content">
                                    <p class="activity-title">Expense added: ₹ 45,000</p>
                                    <p class="activity-desc">Skyline Tower</p>
                                </div>
                                <span class="activity-time">5h ago</span>
                            </div>
                            <div class="activity-item">
                                <div class="activity-icon" style="color: #10b981;">
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
                                </div>
                                <div class="activity-content">
                                    <p class="activity-title">Materials delivered</p>
                                    <p class="activity-desc">Heritage Plaza</p>
                                </div>
                                <span class="activity-time">1d ago</span>
                            </div>
                            <div class="activity-item">
                                <div class="activity-icon" style="color: #6366f1;">
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
                                </div>
                                <div class="activity-content">
                                    <p class="activity-title">New team member added</p>
                                    <p class="activity-desc">Sunrise Villas</p>
                                </div>
                                <span class="activity-time">2d ago</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

</body>
</html>
