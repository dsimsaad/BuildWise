@using BuildWise.Models
@using System.Globalization
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_ModuleLayout";

    decimal totalBudget   = ViewBag.TotalBudget   ?? 0m;
    decimal totalExpenses = ViewBag.TotalExpenses  ?? 0m;
    int totalWorkers      = Convert.ToInt32(ViewBag.TotalWorkers ?? 0);
    int workersOnSite     = Convert.ToInt32(ViewBag.WorkersOnSite ?? 0);
    int workersInactive   = Convert.ToInt32(ViewBag.WorkersInactive ?? Math.Max(0, totalWorkers - workersOnSite));

    var recentExpenses  = ViewBag.RecentExpensesList as List<TransactionLog> ?? new();
    var monthlyExpenses = ViewBag.MonthlyExpenses as System.Collections.IEnumerable;
    var advisorTriggers = ViewBag.AdvisorTriggers as List<DashboardAdvisorTrigger> ?? new();
    var phases = ViewBag.Phases as List<Phase> ?? new();
    var phaseProgress = phases
        .Select(p => new
        {
            Name = string.IsNullOrWhiteSpace(p.CustomPhaseName) ? p.PhaseType.PhaseName : p.CustomPhaseName,
            TotalTasks = p.Tasks.Count,
            CompletedTasks = p.Tasks.Count(t => t.StatusId == 3),
            Progress = p.Tasks.Count > 0 ? Math.Round(p.Tasks.Count(t => t.StatusId == 3) * 100m / p.Tasks.Count, 0) : (p.IsCompleted ? 100m : 0m)
        })
        .ToList();
    decimal constructionProgress = phaseProgress.Any() ? Math.Round(phaseProgress.Average(p => p.Progress), 0) : 0;

    string FormatMoney(decimal val) =>
        $"PKR {val.ToString("N0", new CultureInfo("en-IN"))}";

    double budgetUsedPct = totalBudget > 0 ? (double)(totalExpenses / totalBudget * 100) : 0;
}

<!-- ══════════════════════════════════════════════
     PAGE HEADER
     ══════════════════════════════════════════════ -->
<div class="db-page-header">
    <div class="db-page-title-block">
        <h1 id="dashboardProjectTitle">@(ViewBag.ActiveProjectName ?? "Global Dashboard")</h1>
        <p class="db-subtitle">Overview of @(ViewBag.ActiveProjectName ?? "your projects and business performance")</p>
    </div>
    <a asp-controller="Home" asp-action="Dashboard" asp-route-overall="true"
       class="db-overall-btn">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
        </svg>
        Overall Stats
    </a>
</div>

<!-- ══════════════════════════════════════════════
     TOP STAT CARDS
     ══════════════════════════════════════════════ -->
<div class="db-kpi-row">

    <!-- Workforce Card -->
    <div class="db-kpi-card db-kpi-workforce">
        <div class="db-kpi-inner">
            <div class="db-kpi-icon db-kpi-icon--green">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
            </div>
            <div class="db-kpi-body">
                <span class="db-kpi-label">Workforce</span>
                <div class="db-kpi-value-row">
                    <span class="db-kpi-value" id="statTotalWorkers">@totalWorkers</span>
                    <span class="db-kpi-badge db-kpi-badge--green" id="statWorkersOnSite">@workersOnSite Active</span>
                    <span class="db-kpi-badge db-kpi-badge--red" id="statWorkersInactive">@workersInactive Inactive</span>
                </div>
            </div>
            <div class="db-kpi-more-wrap">
                <button class="db-kpi-more" data-menu="menuWorkers" title="Options">•••</button>
                <div class="db-kpi-dropdown" id="menuWorkers">
                    <a href="/Workers" class="db-kpi-dd-item">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                        View All Workers
                    </a>
                    <a href="/Workers/Create" class="db-kpi-dd-item">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        Add Worker
                    </a>
                    <div class="db-kpi-dd-sep"></div>
                    <a href="/Workers" class="db-kpi-dd-item">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                        Workforce Report
                    </a>
                </div>
            </div>
        </div>
        <div class="db-kpi-progress">
            <div class="db-kpi-progress-fill db-kpi-progress--green" id="workersProgressBar"
                 style="width:@(totalWorkers > 0 ? Math.Min(100, workersOnSite * 100 / totalWorkers) : 0)%"></div>
        </div>
    </div>

    <!-- Project Budget Card -->
    <div class="db-kpi-card db-kpi-budget">
        <div class="db-kpi-inner">
            <div class="db-kpi-icon db-kpi-icon--purple">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="1" x2="12" y2="23"/>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                </svg>
            </div>
            <div class="db-kpi-body">
                <span class="db-kpi-label">Project Budget</span>
                <span class="db-kpi-value db-kpi-value--lg" id="statTotalBudget">@FormatMoney(totalBudget)</span>
            </div>
            <div class="db-kpi-more-wrap">
                <button class="db-kpi-more" data-menu="menuBudget" title="Options">•••</button>
                <div class="db-kpi-dropdown" id="menuBudget">
                    <a href="/Budget" class="db-kpi-dd-item">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/><circle cx="16.5" cy="14" r="1.5"/></svg>
                        Manage Budget
                    </a>
                    <a href="/Projects" class="db-kpi-dd-item">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18"/><path d="M5 21V7h6v14"/><path d="M13 21V3h6v18"/></svg>
                        View Projects
                    </a>
                    <div class="db-kpi-dd-sep"></div>
                    <a href="/Advisor" class="db-kpi-dd-item">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 20V10M12 20V4M6 20v-6"/></svg>
                        Budget Analytics
                    </a>
                </div>
            </div>
        </div>
        <div class="db-kpi-progress">
            <div class="db-kpi-progress-fill db-kpi-progress--purple" style="width:100%;opacity:.15;"></div>
        </div>
    </div>

    <!-- Total Expenses Card -->
    <div class="db-kpi-card db-kpi-expenses">
        <div class="db-kpi-inner">
            <div class="db-kpi-icon db-kpi-icon--orange">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                </svg>
            </div>
            <div class="db-kpi-body">
                <span class="db-kpi-label">Total Expenses</span>
                <div class="db-kpi-value-row">
                    <span class="db-kpi-value db-kpi-value--lg" id="statTotalExpenses">@FormatMoney(totalExpenses)</span>
                    <span class="db-kpi-badge @(budgetUsedPct > 90 ? "db-kpi-badge--red" : "db-kpi-badge--green")"
                          id="statBudgetUsed">@budgetUsedPct.ToString("0")% Used</span>
                </div>
            </div>
            <div class="db-kpi-more-wrap">
                <button class="db-kpi-more" data-menu="menuExpenses" title="Options">•••</button>
                <div class="db-kpi-dropdown" id="menuExpenses">
                    <a href="/Transaction" class="db-kpi-dd-item">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 7h10"/><path d="M7 12h10"/><path d="M11 17h6"/><path d="M4 7h.01"/><path d="M4 12h.01"/><path d="M8 17h.01"/></svg>
                        All Transactions
                    </a>
                    <a href="/Budget" class="db-kpi-dd-item">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                        Add Expense
                    </a>
                    <div class="db-kpi-dd-sep"></div>
                    <a href="/Advisor" class="db-kpi-dd-item">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l3 2"/></svg>
                        Expense Insights
                    </a>
                </div>
            </div>
        </div>
        <div class="db-kpi-progress">
            <div class="db-kpi-progress-fill @(budgetUsedPct > 90 ? "db-kpi-progress--red" : "db-kpi-progress--orange")"
                 id="expenseProgressBar"
                 style="width:@(Math.Min(100,(int)budgetUsedPct))%"></div>
        </div>
    </div>

</div>

<!-- ══════════════════════════════════════════════
     MIDDLE ROW: Expense Distribution + Recent Expenses
     ══════════════════════════════════════════════ -->
<div class="db-mid-row">

    <!-- Left: Expense Distribution Donut -->
    <div class="db-card db-card--distribution">
        <div class="db-card-header">
            <span class="db-card-title">Expense Distribution</span>
            <a href="/Budget" class="db-card-link">Manage Budget →</a>
        </div>
        <div class="db-dist-body">
            <!-- Donut -->
            <div class="db-donut-wrap">
                <canvas id="expenseCategoryChart"></canvas>
                <div class="db-donut-center">
                    <span class="db-donut-sublabel" id="dashPieCenterLabel">TOTAL EXPENSES</span>
                    <strong class="db-donut-value" id="dashPieCenterValue">@FormatMoney(totalExpenses)</strong>
                    <small class="db-donut-meta" id="dashPieCenterMeta">0 categories</small>
                </div>
            </div>
            <!-- Category boxes — rendered by JS, 2-column grid to the right of donut -->
            <div class="db-cat-grid" id="dashboardCategoryBoxes">
                <div class="db-cat-empty">Loading categories…</div>
            </div>
        </div>
    </div>

    <!-- Right: Recent Expenses -->
    <div class="db-card db-card--recent">
        <div class="db-card-header">
            <span class="db-card-title">Recent Expenses</span>
            <a href="/Transaction" class="db-card-link">View All →</a>
        </div>
        <table class="db-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Amount</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="recentExpensesBody">
                @if (recentExpenses.Any())
                {
                    foreach (var exp in recentExpenses)
                    {
                        <tr class="db-table-row">
                            <td class="db-table-date">@exp.TransactionDate.ToString("MMM dd")</td>
                            <td class="db-table-cat">@exp.Category</td>
                            <td class="db-table-amount"><strong>@FormatMoney(exp.Amount)</strong></td>
                            <td class="db-table-chevron">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#CBD5E1" stroke-width="2">
                                    <polyline points="9 18 15 12 9 6"/>
                                </svg>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="db-table-empty">No expenses recorded yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

<!-- ══════════════════════════════════════════════
     BOTTOM ROW: Monthly Trend + Feature Cards
     ══════════════════════════════════════════════ -->
@if (ViewBag.SelectedProjectId != null)
{
    <div class="db-card db-construction-card">
        <div class="db-card-header">
            <span class="db-card-title">Construction Status</span>
            <a href="/Construction" class="db-card-link">Manage Progress</a>
        </div>
        <div class="db-construction-body">
            <div class="db-construction-stats">
                <div class="db-construction-stat">
                    <span>Project Progress</span>
                    <strong>@constructionProgress.ToString("0")%</strong>
                </div>
                <div class="db-construction-stat">
                    <span>Total Tasks</span>
                    <strong>@(ViewBag.TotalTasks ?? 0)</strong>
                </div>
                <div class="db-construction-stat">
                    <span>In Progress</span>
                    <strong>@(ViewBag.TasksInProgress ?? 0)</strong>
                </div>
                <div class="db-construction-stat">
                    <span>Overdue</span>
                    <strong class="db-stat-danger">@(ViewBag.TasksOverdue ?? 0)</strong>
                </div>
            </div>

            @if (phaseProgress.Any())
            {
                <div class="db-phase-grid">
                    @foreach (var phase in phaseProgress.Take(6))
                    {
                        <div class="db-phase-chip">
                            <div class="db-phase-chip-top">
                                <strong>@phase.Name</strong>
                                <span>@phase.Progress.ToString("0")%</span>
                            </div>
                            <div class="db-phase-track">
                                <div class="db-phase-fill" style="width:@phase.Progress%"></div>
                            </div>
                            <small>@phase.CompletedTasks/@phase.TotalTasks tasks complete</small>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="db-construction-empty">No construction phases have been created for this project yet.</p>
            }
        </div>
    </div>
}

<div class="db-card db-advisor-card">
    <div class="db-card-header">
        <span class="db-card-title">Cost Advisor Triggers</span>
        <a href="/Advisor" class="db-card-link">Open Advisor</a>
    </div>
    <div class="db-advisor-body">
        @if (advisorTriggers.Any())
        {
            <div class="db-advisor-trigger-grid">
                @foreach (var trigger in advisorTriggers)
                {
                    var severityClass = trigger.Severity.ToLowerInvariant();
                    <a href="@trigger.ActionUrl" class="db-advisor-trigger db-advisor-trigger--@severityClass">
                        <div class="db-advisor-trigger-mark"></div>
                        <div class="db-advisor-trigger-content">
                            <div class="db-advisor-trigger-top">
                                <strong>@trigger.Title</strong>
                                <span>@trigger.Severity</span>
                            </div>
                            <small>@trigger.Category</small>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="db-advisor-clear">
                <strong>No active cost triggers</strong>
                <p>Your current budget, spending, materials, and construction progress do not show immediate cost risks.</p>
            </div>
        }
    </div>
</div>

<div class="db-bottom-row">

    <!-- Monthly Spend Trend -->
    <div class="db-card db-card--trend">
        <div class="db-card-header">
            <span class="db-card-title">Monthly Spending Trend</span>
            <div class="db-trend-tabs">
                <button class="db-trend-tab active" data-period="all">All</button>
                <button class="db-trend-tab" data-period="6">6M</button>
                <button class="db-trend-tab" data-period="3">3M</button>
            </div>
        </div>
        <div class="db-chart-area">
            <canvas id="monthlyTrendChart"></canvas>
        </div>
    </div>

    <!-- Feature Quick-Access Cards -->
    <div class="db-feature-cards">

        <a href="/Budget" class="db-feat-card">
            <div class="db-feat-icon db-feat-icon--green">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
            </div>
            <div class="db-feat-body">
                <strong>Budget Overview</strong>
                <p>Track your project budget and expenses in real-time.</p>
            </div>
            <svg class="db-feat-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"/>
            </svg>
        </a>

        <a href="/Advisor" class="db-feat-card">
            <div class="db-feat-icon db-feat-icon--purple">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 20V10M12 20V4M6 20v-6"/>
                </svg>
            </div>
            <div class="db-feat-body">
                <strong>Smart Analytics</strong>
                <p>Get insights into spending patterns and category distribution.</p>
            </div>
            <svg class="db-feat-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"/>
            </svg>
        </a>

        <a href="/Transaction" class="db-feat-card">
            <div class="db-feat-icon db-feat-icon--orange">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                </svg>
            </div>
            <div class="db-feat-body">
                <strong>Stay Updated</strong>
                <p>Recent transactions and budget alerts at your fingertips.</p>
            </div>
            <svg class="db-feat-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"/>
            </svg>
        </a>

    </div>
</div>

<!-- ══════════════════════════════════════════════
     SCRIPTS
     ══════════════════════════════════════════════ -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // ── Design Tokens ──
    Chart.defaults.font.family = "'Inter', sans-serif";
    Chart.defaults.color = '#64748B';

    const PALETTE = ['#2563EB','#14B8A6','#F59E0B','#8B5CF6','#EF4444',
                     '#06B6D4','#84CC16','#F97316','#EC4899','#64748B',
                     '#22C55E','#A855F7','#3B82F6','#10B981'];

    // ─────────────────────────────────────────────
    // Helpers
    // ─────────────────────────────────────────────
    function normalizeCategoryData(items) {
        return (items || [])
            .map(i => ({ category: i.category ?? i.Category, total: Number(i.total ?? i.Total ?? i.amount ?? i.Amount ?? 0) }))
            .filter(i => i.category && i.total > 0);
    }
    function sumCategories(items) {
        return items.reduce((s, i) => s + Number(i.total || 0), 0);
    }
    function formatPKR(value) {
        return `PKR ${Number(value || 0).toLocaleString('en-PK', { maximumFractionDigits: 0 })}`;
    }

    // ─────────────────────────────────────────────
    // PIE CENTER
    // ─────────────────────────────────────────────
    let catData = normalizeCategoryData(@Html.Raw(Json.Serialize(ViewBag.CategoryExpenses)));
    let totalCatExp = sumCategories(catData);
    let activePieIdx = null;

    const pieCenterLabel = document.getElementById('dashPieCenterLabel');
    const pieCenterValue = document.getElementById('dashPieCenterValue');
    const pieCenterMeta  = document.getElementById('dashPieCenterMeta');

    function setPieCenter(idx) {
        if (idx === null || idx < 0 || !catData[idx]) {
            pieCenterLabel.textContent = 'TOTAL EXPENSES';
            pieCenterValue.textContent = formatPKR(totalCatExp);
            pieCenterMeta.textContent  = `${catData.length} ${catData.length === 1 ? 'category' : 'categories'}`;
            return;
        }
        const it   = catData[idx];
        const amt  = Number(it.total || 0);
        const pct  = totalCatExp > 0 ? (amt / totalCatExp * 100).toFixed(1) : '0.0';
        pieCenterLabel.textContent = it.category.toUpperCase();
        pieCenterValue.textContent = formatPKR(amt);
        pieCenterMeta.textContent  = `${pct}% allocation`;
    }

    // ─────────────────────────────────────────────
    // PIE CHART
    // ─────────────────────────────────────────────
    const pieCtx = document.getElementById('expenseCategoryChart').getContext('2d');
    const pieChart = new Chart(pieCtx, {
        type: 'doughnut',
        data: {
            labels: catData.map(c => c.category),
            datasets: [{
                data: catData.map(c => c.total),
                backgroundColor: catData.map((_, i) => PALETTE[i % PALETTE.length]),
                borderColor: '#FFFFFF',
                borderWidth: 3,
                hoverBorderWidth: 4,
                hoverOffset: 7,
                spacing: 2
            }]
        },
        options: {
            maintainAspectRatio: false,
            cutout: '68%',
            animation: { animateRotate: true, duration: 900 },
            plugins: {
                legend: { display: false },
                tooltip: { enabled: false }
            },
            onHover: (e, els) => activatePie(els.length ? els[0].index : null),
            onLeave: () => resetPie()
        }
    });

    // Always reset to total — called on mouse-out from both chart and category boxes
    function resetPie() {
        activePieIdx = null;
        syncCategoryBoxes(null);
        pieChart.setActiveElements([]);
        setPieCenter(null);
        pieChart.update('none'); // 'none' skips animation for instant reset
    }

    function syncCategoryBoxes(idx) {
        document.querySelectorAll('.db-cat-box').forEach(b => {
            b.classList.toggle('is-active', idx !== null && Number(b.dataset.idx) === idx);
        });
    }

    function activatePie(idx) {
        if (idx === null || idx === undefined) { resetPie(); return; }
        activePieIdx = idx;
        syncCategoryBoxes(idx);
        pieChart.setActiveElements([{ datasetIndex: 0, index: idx }]);
        setPieCenter(idx);
        pieChart.update();
    }

    // Explicit canvas mouseleave — reliable fallback for chart hover-out
    document.getElementById('expenseCategoryChart').addEventListener('mouseleave', resetPie);

    // ─────────────────────────────────────────────
    // CATEGORY BOXES
    // ─────────────────────────────────────────────
    function renderCategoryBoxes() {
        const wrap = document.getElementById('dashboardCategoryBoxes');
        if (!catData.length) {
            wrap.innerHTML = '<div class="db-cat-empty">No expense categories yet.</div>';
            return;
        }
        wrap.innerHTML = catData.map((it, i) => {
            const amt  = Number(it.total || 0);
            const pct  = totalCatExp > 0 ? (amt / totalCatExp * 100).toFixed(0) : '0';
            const col  = PALETTE[i % PALETTE.length];
            return `
                <button class="db-cat-box" data-idx="${i}" type="button">
                    <span class="db-cat-top">
                        <span class="db-cat-pill" style="background:${col}">${pct}%</span>
                        <strong class="db-cat-name">${it.category}</strong>
                    </span>
                    <span class="db-cat-amount">${formatPKR(amt)}</span>
                </button>`;
        }).join('');

        document.querySelectorAll('.db-cat-box').forEach(b => {
            const i = Number(b.dataset.idx);
            b.addEventListener('mouseenter', () => activatePie(i));
            b.addEventListener('focus',      () => activatePie(i));
            b.addEventListener('mouseleave', () => activatePie(null));
            b.addEventListener('blur',       () => activatePie(null));
        });
    }

    // ─────────────────────────────────────────────
    // MONTHLY TREND CHART
    // ─────────────────────────────────────────────
    let rawMonthly = @Html.Raw(Json.Serialize(ViewBag.MonthlyExpenses));

    function buildMonthlyDataset(raw, periods) {
        const normalized = (raw || [])
            .map(m => ({
                year: Number(m.year ?? m.Year ?? new Date().getFullYear()),
                month: Number(m.month ?? m.Month ?? 1),
                value: Number(m.total ?? m.Total ?? 0)
            }))
            .filter(m => m.month >= 1 && m.month <= 12)
            .sort((a, b) => (a.year - b.year) || (a.month - b.month));

        const byMonth = new Map(normalized.map(m => [`${m.year}-${m.month}`, m.value]));
        const end = normalized.length
            ? new Date(normalized[normalized.length - 1].year, normalized[normalized.length - 1].month - 1, 1)
            : new Date(new Date().getFullYear(), new Date().getMonth(), 1);
        const start = normalized.length
            ? new Date(normalized[0].year, normalized[0].month - 1, 1)
            : new Date(end.getFullYear(), end.getMonth(), 1);
        const monthSpan = (end.getFullYear() - start.getFullYear()) * 12 + (end.getMonth() - start.getMonth()) + 1;
        const timelineLength = periods || Math.max(6, monthSpan);

        return Array.from({ length: timelineLength }, (_, index) => {
            const date = new Date(end.getFullYear(), end.getMonth() - (timelineLength - 1 - index), 1);
            return {
                label: date.toLocaleString('default', { month: 'short' }),
                value: byMonth.get(`${date.getFullYear()}-${date.getMonth() + 1}`) || 0
            };
        });
    }

    let monthlyPeriod = null;
    let monthlyItems  = buildMonthlyDataset(rawMonthly, monthlyPeriod);

    const trendCtx = document.getElementById('monthlyTrendChart').getContext('2d');
    const gradient = trendCtx.createLinearGradient(0, 0, 0, 220);
    gradient.addColorStop(0, 'rgba(37,99,235,0.18)');
    gradient.addColorStop(1, 'rgba(37,99,235,0)');

    const trendChart = new Chart(trendCtx, {
        type: 'line',
        data: {
            labels: monthlyItems.map(m => m.label),
            datasets: [{
                label: 'Spending (PKR)',
                data: monthlyItems.map(m => m.value),
                borderColor: '#2563EB',
                backgroundColor: gradient,
                fill: monthlyItems.length > 1,
                tension: 0.35,
                borderWidth: 3,
                pointBackgroundColor: '#2563EB',
                pointBorderColor: '#FFFFFF',
                pointBorderWidth: 2,
                pointRadius: monthlyItems.length === 1 ? 5 : 4,
                pointHoverRadius: 6
            }]
        },
        options: {
            maintainAspectRatio: false,
            interaction: { mode: 'index', intersect: false },
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#0F172A',
                    padding: 12,
                    cornerRadius: 8,
                    callbacks: { label: ctx => `  ${formatPKR(ctx.parsed.y)}` }
                }
            },
            scales: {
                x: { grid: { display: false }, border: { display: false } },
                y: {
                    beginAtZero: true,
                    grid: { color: '#F1F5F9', drawBorder: false },
                    border: { display: false, dash: [4,4] },
                    ticks: { callback: v => v >= 1000 ? `${(v/1000).toFixed(0)}K` : v }
                }
            }
        }
    });

    function updateTrendChart(periods) {
        monthlyPeriod = periods;
        const items = buildMonthlyDataset(rawMonthly, periods);
        monthlyItems = items;
        trendChart.data.labels = items.map(m => m.label);
        trendChart.data.datasets[0].data = items.map(m => m.value);
        trendChart.data.datasets[0].fill = items.length > 1;
        trendChart.data.datasets[0].pointRadius = items.length === 1 ? 5 : 4;
        trendChart.update();
    }

    function updateMonthlyTrend(items) {
        rawMonthly = items || [];
        updateTrendChart(monthlyPeriod);
    }

    document.querySelectorAll('.db-trend-tab').forEach(btn => {
        btn.addEventListener('click', function () {
            document.querySelectorAll('.db-trend-tab').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            const p = this.dataset.period;
            updateTrendChart(p === 'all' ? null : Number(p));
        });
    });

    // ─────────────────────────────────────────────
    // STAT CARD LIVE UPDATE
    // ─────────────────────────────────────────────
    function updateStatCards(data) {
        const tb  = Number(data.totalBudget   || 0);
        const te  = Number(data.totalExpenses  || 0);
        const tw  = Number(data.totalWorkers   || 0);
        const ws  = Number(data.workersOnSite  || 0);
        const wi  = Number(data.workersInactive ?? Math.max(0, tw - ws));
        const pct = tb > 0 ? te / tb * 100 : 0;

        document.getElementById('statTotalWorkers').textContent  = tw;
        document.getElementById('statWorkersOnSite').textContent = `${ws} Active`;
        document.getElementById('statWorkersInactive').textContent = `${wi} Inactive`;
        document.getElementById('workersProgressBar').style.width = `${tw > 0 ? Math.min(100, ws * 100 / tw) : 0}%`;
        document.getElementById('statTotalBudget').textContent   = formatPKR(tb);
        document.getElementById('statTotalExpenses').textContent = formatPKR(te);
        const badgeEl = document.getElementById('statBudgetUsed');
        badgeEl.textContent = `${pct.toFixed(0)}% Used`;
        badgeEl.className = `db-kpi-badge ${pct > 90 ? 'db-kpi-badge--red' : 'db-kpi-badge--green'}`;
        document.getElementById('expenseProgressBar').style.width = `${Math.min(100, pct)}%`;
    }

    function updateExpenseChart(items) {
        catData = normalizeCategoryData(items);
        totalCatExp = sumCategories(catData);
        activePieIdx = null;
        pieChart.data.labels = catData.map(c => c.category);
        pieChart.data.datasets[0].data = catData.map(c => c.total);
        pieChart.data.datasets[0].backgroundColor = catData.map((_, i) => PALETTE[i % PALETTE.length]);
        pieChart.setActiveElements([]);
        pieChart.update();
        renderCategoryBoxes();
        setPieCenter(null);
    }

    function updateRecentExpenses(items) {
        const tbody = document.getElementById('recentExpensesBody');
        if (!items || !items.length) {
            tbody.innerHTML = '<tr><td colspan="4" class="db-table-empty">No expenses recorded yet.</td></tr>';
            return;
        }
        tbody.innerHTML = items.map(it => {
            const dv  = it.transactionDate ?? it.TransactionDate ?? it.expenseDate ?? it.ExpenseDate;
            const cat = it.category ?? it.Category ?? '';
            const amt = Number(it.amount ?? it.Amount ?? 0);
            const dt  = new Date(dv).toLocaleDateString(undefined, { month: 'short', day: '2-digit' });
            return `<tr class="db-table-row">
                <td class="db-table-date">${dt}</td>
                <td class="db-table-cat">${cat}</td>
                <td class="db-table-amount"><strong>${formatPKR(amt)}</strong></td>
                <td class="db-table-chevron"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#CBD5E1" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg></td>
            </tr>`;
        }).join('');
    }

    // ─────────────────────────────────────────────
    // LIVE REFRESH
    // ─────────────────────────────────────────────
    async function refreshDashboard() {
        try {
            const overall = new URLSearchParams(window.location.search).get('overall') === 'true';
            const res = await fetch(`/Home/DashboardData${overall ? '?overall=true' : ''}`, { cache: 'no-store' });
            if (!res.ok) return;
            const data = await res.json();
            updateStatCards(data);
            // Only update the expense chart if the API actually returned categories.
            // This prevents the live-refresh from wiping server-rendered category boxes
            // when the API response differs from the initial page-load data.
            const apiCats = data.categoryExpenses || [];
            if (apiCats.length > 0) {
                updateExpenseChart(apiCats);
            }
            updateMonthlyTrend(data.monthlyExpenses || []);
            updateRecentExpenses(data.recentExpenses || []);
        } catch {}
    }

    // ─────────────────────────────────────────────
    // KPI DROPDOWN MENUS
    // ─────────────────────────────────────────────
    document.querySelectorAll('.db-kpi-more').forEach(btn => {
        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            const menuId = this.dataset.menu;
            const menu   = document.getElementById(menuId);
            const isOpen = menu.classList.contains('is-open');
            // close all
            document.querySelectorAll('.db-kpi-dropdown').forEach(m => m.classList.remove('is-open'));
            document.querySelectorAll('.db-kpi-more').forEach(b => b.classList.remove('is-active'));
            // toggle clicked
            if (!isOpen) {
                menu.classList.add('is-open');
                this.classList.add('is-active');
            }
        });
    });

    // close menus on outside click
    document.addEventListener('click', () => {
        document.querySelectorAll('.db-kpi-dropdown').forEach(m => m.classList.remove('is-open'));
        document.querySelectorAll('.db-kpi-more').forEach(b => b.classList.remove('is-active'));
    });

    // ─────────────────────────────────────────────
    // INIT
    // ─────────────────────────────────────────────
    // Render category boxes immediately from server-side data — no waiting for API
    renderCategoryBoxes();
    setPieCenter(null);
    // Delay the first refresh so server-rendered boxes are visible before any update
    setTimeout(refreshDashboard, 2000);
    setInterval(refreshDashboard, 15000);
</script>
