@using BuildWise.Models
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_ModuleLayout";

    // Data from ViewBag
    decimal totalBudget = ViewBag.TotalBudget ?? 0m;
    decimal totalExpenses = ViewBag.TotalExpenses ?? 0m;
    int totalProjects = ViewBag.TotalProjects ?? 0;
    int activeProjects = ViewBag.ActiveProjects ?? 0;
    int totalWorkers = ViewBag.TotalWorkers ?? 0;
    int totalTasks = ViewBag.TotalTasks ?? 0;

    // Projects status
    int projNotStarted = ViewBag.ProjectsNotStarted ?? 0;
    int projInProgress = ViewBag.ProjectsInProgress ?? 0;
    int projCompleted = ViewBag.ProjectsCompleted ?? 0;
    int projOnHold = ViewBag.ProjectsOnHold ?? 0;

    // Tasks summary
    int tasksToDo = ViewBag.TasksToDo ?? 0;
    int tasksInProgress = ViewBag.TasksInProgress ?? 0;
    int tasksCompleted = ViewBag.TasksCompleted ?? 0;
    int tasksOverdue = ViewBag.TasksOverdue ?? 0;

    // Workers summary
    int workersOnSite = ViewBag.WorkersOnSite ?? 0;
    int workersOffSite = ViewBag.WorkersOffSite ?? 0;
    int workersOnLeave = ViewBag.WorkersOnLeave ?? 0;

    var projects = ViewBag.Projects as List<VwProjectDashboard> ?? new();
    var recentExpenses = ViewBag.RecentExpensesList as List<VwExpenseHistory> ?? new();

    string FormatCrore(decimal val)
    {
        if (val >= 10_000_000) return $"₹ {val / 10_000_000:0.##} Cr";
        if (val >= 100_000) return $"₹ {val / 100_000:0.##} L";
        return $"₹ {val:N0}";
    }

    double budgetUsedPct = totalBudget > 0 ? (double)(totalExpenses / totalBudget * 100) : 0;
}

<div class="content-header">
    <div>
        <h1>@(ViewBag.ActiveProjectName ?? "Global Dashboard")</h1>
        <p class="text-muted" style="margin-top: 4px; font-size: 0.9rem;">Overview of @(ViewBag.ActiveProjectName ?? "your projects and business performance")</p>
    </div>
    <div class="date-selector" onclick="document.getElementById('dashDate').showPicker()" style="position: relative;">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        <span id="dateDisplay">@DateTime.Now.ToString("MMM dd, yyyy")</span>
        <input type="date" id="dashDate" style="position: absolute; opacity: 0; pointer-events: none; width: 0; height: 0;" onchange="updateDateDisplay(this.value)">
        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
    </div>
</div>

<!-- Stats Grid -->
<div class="stats-grid grid-4">
    @if (ViewBag.SelectedProjectId == null)
    {
        <div class="stat-card">
            <div class="stat-header">
                <div class="stat-icon-box" style="background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#1D4ED8" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Total Projects</span>
                    <div style="display:flex; align-items:baseline; gap:8px;">
                        <h2 class="stat-value">@totalProjects</h2>
                        <span class="stat-trend trend-up">@(projInProgress) Active</span>
                    </div>
                </div>
            </div>
            <div class="progress-mini"><div class="progress-mini-bar" style="width: @(totalProjects > 0 ? (projCompleted * 100 / totalProjects) : 0)%; background: #1D4ED8;"></div></div>
        </div>
    }
    else
    {
        <div class="stat-card">
            <div class="stat-header">
                <div class="stat-icon-box" style="background: linear-gradient(135deg, #F0FDF4 0%, #DCFCE7 100%);">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#10B981" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Project Status</span>
                    <div style="display:flex; align-items:baseline; gap:8px;">
                        <h2 class="stat-value">@(projCompleted > 0 ? "Done" : "Active")</h2>
                        <span class="stat-trend trend-up">@((totalTasks > 0 ? (tasksCompleted * 100 / totalTasks) : 0))% Progress</span>
                    </div>
                </div>
            </div>
            <div class="progress-mini"><div class="progress-mini-bar" style="width: @((totalTasks > 0 ? (tasksCompleted * 100 / totalTasks) : 0))%; background: #10B981;"></div></div>
        </div>
    }

    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon-box" style="background: linear-gradient(135deg, #ECFDF5 0%, #D1FAE5 100%);">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#10B981" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </div>
            <div class="stat-info">
                <span class="stat-label">Workforce</span>
                <div style="display:flex; align-items:baseline; gap:8px;">
                    <h2 class="stat-value">@totalWorkers</h2>
                    <span class="stat-trend trend-up">@workersOnSite On-Site</span>
                </div>
            </div>
        </div>
        <div class="progress-mini"><div class="progress-mini-bar" style="width: @(totalWorkers > 0 ? (workersOnSite * 100 / totalWorkers) : 0)%; background: #10B981;"></div></div>
    </div>

    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon-box" style="background: linear-gradient(135deg, #F5F3FF 0%, #EDE9FE 100%);">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#8B5CF6" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
            </div>
            <div class="stat-info">
                <span class="stat-label">Project Budget</span>
                <div style="display:flex; align-items:baseline; gap:8px;">
                    <h2 class="stat-value">@FormatCrore(totalBudget)</h2>
                </div>
            </div>
        </div>
        <div class="progress-mini"><div class="progress-mini-bar" style="width: 100%; background: #8B5CF6; opacity: 0.2;"></div></div>
    </div>

    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon-box" style="background: linear-gradient(135deg, #FFF7ED 0%, #FFEDD5 100%);">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#F97316" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
            </div>
            <div class="stat-info">
                <span class="stat-label">Total Expenses</span>
                <div style="display:flex; align-items:baseline; gap:8px;">
                    <h2 class="stat-value">@FormatCrore(totalExpenses)</h2>
                    <span class="stat-trend @(budgetUsedPct > 90 ? "trend-down" : "trend-up")">@budgetUsedPct.ToString("0")% Used</span>
                </div>
            </div>
        </div>
        <div class="progress-mini"><div class="progress-mini-bar" style="width: @(Math.Min(100, (int)budgetUsedPct))%; background: #F97316;"></div></div>
    </div>
</div>

<!-- Charts Row -->
<div class="dashboard-row grid-3">
    <!-- Project/Phase Status Chart -->
    <div class="dash-card">
        <div class="card-header">
            <h3>@(ViewBag.SelectedProjectId != null ? "Phase Completion" : "Project Status")</h3>
            <div class="card-actions">
                <span class="dot-menu">•••</span>
            </div>
        </div>
        <div class="chart-container-relative">
            <canvas id="statusChart"></canvas>
            <div class="chart-center-text">
                <span class="center-value">@(ViewBag.SelectedProjectId != null ? ViewBag.TotalTasks : totalProjects)</span>
                <span class="center-label">@(ViewBag.SelectedProjectId != null ? "Tasks" : "Projects")</span>
            </div>
        </div>
        <div class="chart-legend-modern">
            @if (ViewBag.SelectedProjectId != null)
            {
                <div class="leg-item"><span class="dot" style="background: #94A3B8;"></span> <span>To Do (@tasksToDo)</span></div>
                <div class="leg-item"><span class="dot" style="background: #1D4ED8;"></span> <span>Active (@tasksInProgress)</span></div>
                <div class="leg-item"><span class="dot" style="background: #10B981;"></span> <span>Done (@tasksCompleted)</span></div>
            }
            else
            {
                <div class="leg-item"><span class="dot" style="background: #94A3B8;"></span> <span>New (@projNotStarted)</span></div>
                <div class="leg-item"><span class="dot" style="background: #1D4ED8;"></span> <span>Active (@projInProgress)</span></div>
                <div class="leg-item"><span class="dot" style="background: #10B981;"></span> <span>Done (@projCompleted)</span></div>
            }
        </div>
    </div>

    <!-- Spending Trend -->
    <div class="dash-card grid-col-span-2">
        <div class="card-header">
            <h3>Cash Flow Analysis</h3>
            <div class="card-tabs">
                <button class="tab-btn active">6 Months</button>
                <button class="tab-btn">1 Year</button>
            </div>
        </div>
        <div class="chart-container-large">
            <canvas id="cashFlowChart"></canvas>
        </div>
    </div>
</div>

<!-- Second Row -->
<div class="dashboard-row grid-2">
    <!-- Recent Projects or Phases -->
    <div class="dash-card">
        <div class="card-header">
            <h3>@(ViewBag.SelectedProjectId != null ? "Project Phases" : "Active Projects")</h3>
            <a href="/Projects" class="btn-link">Manage All →</a>
        </div>
        <div class="table-responsive-clean">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Progress</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.SelectedProjectId != null)
                    {
                        var phases = ViewBag.Phases as List<Phase> ?? new();
                        foreach (var ph in phases)
                        {
                            var total = ph.Tasks?.Count ?? 0;
                            var completed = ph.Tasks?.Count(t => t.StatusId == 3) ?? 0;
                            var pct = total > 0 ? (completed * 100 / total) : 0;
                            <tr>
                                <td>
                                    <div class="name-cell">
                                        <div class="circle-icon">P</div>
                                        <div class="name-info">
                                            <strong>@(ph.PhaseType?.PhaseName ?? ph.CustomPhaseName ?? "Phase " + ph.Sequence)</strong>
                                            <span>@(ph.StartDate?.ToString("MMM dd") ?? "Not Started")</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="bar-cell">
                                        <span>@pct%</span>
                                        <div class="bar-wrap"><div class="bar-fill" style="width: @pct%;"></div></div>
                                    </div>
                                </td>
                                <td><span class="status-tag @(pct == 100 ? "tag-green" : "tag-blue")">@(pct == 100 ? "Completed" : "Active")</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        foreach (var p in projects)
                        {
                            var pct = p.PhaseProgressPct ?? 0;
                            <tr>
                                <td>
                                    <div class="name-cell">
                                        <div class="circle-icon" style="background:#EFF6FF; color:#1D4ED8;">P</div>
                                        <div class="name-info">
                                            <strong>@p.ProjectName</strong>
                                            <span>Target: @p.ExpectedEndDate?.ToString("MMM dd")</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="bar-cell">
                                        <span>@pct.ToString("0")%</span>
                                        <div class="bar-wrap"><div class="bar-fill" style="width: @pct.ToString("0")%;"></div></div>
                                    </div>
                                </td>
                                <td><span class="status-tag @(p.IsCompleted ? "tag-green" : "tag-blue")">@(p.IsCompleted ? "Completed" : "Active")</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Expense Breakdown -->
    <div class="dash-card">
        <div class="card-header">
            <h3>Expense Distribution</h3>
            <a href="/Budget" class="btn-link">Details →</a>
        </div>
        <div class="expense-content">
            <div class="chart-side">
                <canvas id="expenseCategoryChart"></canvas>
            </div>
            <div class="legend-side">
                @foreach (var cat in ViewBag.CategoryExpenses as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>())
                {
                    <div class="exp-item">
                        <div class="exp-left">
                            <span class="dot"></span>
                            <span class="cat-name">@cat.Category</span>
                        </div>
                        <span class="cat-val">@FormatCrore(cat.Total)</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Professional Chart Themes
    const colors = {
        primary: '#1D4ED8',
        success: '#10B981',
        warning: '#F59E0B',
        danger: '#EF4444',
        muted: '#94A3B8',
        bg: '#F8FAFC'
    };

    Chart.defaults.font.family = "'Inter', sans-serif";
    Chart.defaults.color = '#64748B';

    // 1. Status Chart
    const statusCtx = document.getElementById('statusChart').getContext('2d');
    new Chart(statusCtx, {
        type: 'doughnut',
        data: {
            datasets: [{
                data: @(ViewBag.SelectedProjectId != null 
                    ? $"[{tasksToDo}, {tasksInProgress}, {tasksCompleted}]" 
                    : $"[{projNotStarted}, {projInProgress}, {projCompleted}]"),
                backgroundColor: [colors.muted, colors.primary, colors.success],
                borderWidth: 0,
                hoverOffset: 10,
                cutout: '82%'
            }]
        },
        options: {
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            animation: { animateRotate: true, duration: 1500 }
        }
    });

    // 2. Cash Flow Chart
    const flowCtx = document.getElementById('cashFlowChart').getContext('2d');
    const monthlyData = @Html.Raw(Json.Serialize(ViewBag.MonthlyExpenses));
    const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    
    const labels = monthlyData.length > 0 ? monthlyData.map(m => months[m.month - 1]) : months.slice(0,6);
    const data = monthlyData.length > 0 ? monthlyData.map(m => m.total) : [0,0,0,0,0,0];

    const gradient = flowCtx.createLinearGradient(0, 0, 0, 300);
    gradient.addColorStop(0, 'rgba(29, 78, 216, 0.1)');
    gradient.addColorStop(1, 'rgba(29, 78, 216, 0)');

    new Chart(flowCtx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [{
                label: 'Monthly Spending',
                data: data,
                borderColor: colors.primary,
                backgroundColor: gradient,
                fill: true,
                tension: 0.45,
                borderWidth: 3,
                pointRadius: 4,
                pointBackgroundColor: '#fff',
                pointBorderColor: colors.primary,
                pointBorderWidth: 2
            }]
        },
        options: {
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: { 
                    beginAtZero: true, 
                    grid: { display: true, color: '#f1f5f9' },
                    ticks: { callback: v => '₹' + (v >= 100000 ? (v/100000).toFixed(1) + 'L' : v) }
                },
                x: { grid: { display: false } }
            }
        }
    });

    // 3. Category Distribution
    const catCtx = document.getElementById('expenseCategoryChart').getContext('2d');
    const catData = @Html.Raw(Json.Serialize(ViewBag.CategoryExpenses));
    
    new Chart(catCtx, {
        type: 'doughnut',
        data: {
            labels: catData.map(c => c.category),
            datasets: [{
                data: catData.map(c => c.total),
                backgroundColor: [colors.primary, colors.success, colors.warning, colors.danger, '#8B5CF6'],
                borderWidth: 0,
                cutout: '75%'
            }]
        },
        options: {
            maintainAspectRatio: false,
            plugins: { legend: { display: false } }
        }
    });
</script>
