@using BuildWise.Models
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_ModuleLayout";

    // Data from ViewBag
    decimal totalBudget = ViewBag.TotalBudget ?? 0m;
    decimal totalExpenses = ViewBag.TotalExpenses ?? 0m;
    int totalProjects = ViewBag.TotalProjects ?? 0;
    int activeProjects = ViewBag.ActiveProjects ?? 0;
    int totalWorkers = ViewBag.TotalWorkers ?? 0;
    int totalTasks = ViewBag.TotalTasks ?? 0;

    // Projects status
    int projNotStarted = ViewBag.ProjectsNotStarted ?? 0;
    int projInProgress = ViewBag.ProjectsInProgress ?? 0;
    int projCompleted = ViewBag.ProjectsCompleted ?? 0;
    int projOnHold = ViewBag.ProjectsOnHold ?? 0;

    // Tasks summary
    int tasksToDo = ViewBag.TasksToDo ?? 0;
    int tasksInProgress = ViewBag.TasksInProgress ?? 0;
    int tasksCompleted = ViewBag.TasksCompleted ?? 0;
    int tasksOverdue = ViewBag.TasksOverdue ?? 0;

    // Workers summary
    int workersOnSite = ViewBag.WorkersOnSite ?? 0;
    int workersOffSite = ViewBag.WorkersOffSite ?? 0;
    int workersOnLeave = ViewBag.WorkersOnLeave ?? 0;

    var projects = ViewBag.Projects as List<VwProjectDashboard> ?? new();
    var recentExpenses = ViewBag.RecentExpensesList as List<VwExpenseHistory> ?? new();

    string FormatCrore(decimal val)
    {
        if (val >= 10_000_000) return $"₹ {val / 10_000_000:0.##} Cr";
        if (val >= 100_000) return $"₹ {val / 100_000:0.##} L";
        return $"₹ {val:N0}";
    }

    double budgetUsedPct = totalBudget > 0 ? (double)(totalExpenses / totalBudget * 100) : 0;
}

<div class="content-header">
    <div>
        <h1>Dashboard</h1>
        <p class="text-muted" style="margin-top: 4px; font-size: 0.9rem;">Overview of your projects and business performance</p>
    </div>
    <div class="date-selector" onclick="document.getElementById('dashDate').showPicker()" style="position: relative;">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        <span id="dateDisplay">@DateTime.Now.ToString("MMM dd, yyyy")</span>
        <input type="date" id="dashDate" style="position: absolute; opacity: 0; pointer-events: none; width: 0; height: 0;" onchange="updateDateDisplay(this.value)">
        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
    </div>
</div>

<!-- Stats Grid -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon-box" style="background: #EFF6FF;">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#1D4ED8" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
            </div>
            <div class="stat-info">
                <span class="stat-label">Total Projects</span>
                <div style="display:flex; align-items:baseline; gap:8px;">
                    <h2 class="stat-value">@totalProjects</h2>
                    <span class="stat-trend trend-up"><svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><path d="M7 14l5-5 5 5H7z"/></svg> 20%</span>
                </div>
            </div>
        </div>
        <p class="stat-subtext">@activeProjects in progress</p>
    </div>

    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon-box" style="background: #ECFDF5;">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#10B981" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </div>
            <div class="stat-info">
                <span class="stat-label">Total Workers</span>
                <div style="display:flex; align-items:baseline; gap:8px;">
                    <h2 class="stat-value">@totalWorkers</h2>
                    <span class="stat-trend trend-up"><svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><path d="M7 14l5-5 5 5H7z"/></svg> 12%</span>
                </div>
            </div>
        </div>
        <p class="stat-subtext">@workersOnSite active</p>
    </div>

    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon-box" style="background: #F5F3FF;">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#8B5CF6" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
            </div>
            <div class="stat-info">
                <span class="stat-label">Total Budget</span>
                <div style="display:flex; align-items:baseline; gap:8px;">
                    <h2 class="stat-value">@FormatCrore(totalBudget)</h2>
                    <span class="stat-trend trend-up"><svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><path d="M7 14l5-5 5 5H7z"/></svg> 18%</span>
                </div>
            </div>
        </div>
        <p class="stat-subtext">75% of total allocation</p>
    </div>

    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon-box" style="background: #FFF7ED;">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#F59E0B" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
            </div>
            <div class="stat-info">
                <span class="stat-label">Total Expenses</span>
                <div style="display:flex; align-items:baseline; gap:8px;">
                    <h2 class="stat-value">@FormatCrore(totalExpenses)</h2>
                    <span class="stat-trend trend-up"><svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><path d="M7 14l5-5 5 5H7z"/></svg> 15%</span>
                </div>
            </div>
        </div>
        <p class="stat-subtext">@budgetUsedPct.ToString("0")% of total budget</p>
    </div>
</div>

<!-- Charts Row -->
<div class="dashboard-row grid-3">
    <!-- Project Progress Chart -->
    <div class="dash-card">
        <div class="card-header">
            <h3>Project Progress</h3>
            <a href="/Projects" class="view-all">View all</a>
        </div>
        <div class="chart-container-relative">
            <canvas id="projectProgressChart"></canvas>
            <div class="chart-center-text">
                <span class="center-value">@totalProjects</span>
                <span class="center-label">Total Projects</span>
            </div>
        </div>
        <div class="chart-legend-grid">
            <div class="legend-item-row">
                <span class="dot" style="background: #94A3B8;"></span>
                <span class="name">Not Started</span>
                <span class="val">@projNotStarted</span>
                <span class="pct">@((totalProjects > 0 ? (projNotStarted * 100.0 / totalProjects) : 0).ToString("0"))%</span>
            </div>
            <div class="legend-item-row">
                <span class="dot" style="background: #1D4ED8;"></span>
                <span class="name">In Progress</span>
                <span class="val">@projInProgress</span>
                <span class="pct">@((totalProjects > 0 ? (projInProgress * 100.0 / totalProjects) : 0).ToString("0"))%</span>
            </div>
            <div class="legend-item-row">
                <span class="dot" style="background: #F59E0B;"></span>
                <span class="name">On Hold</span>
                <span class="val">@projOnHold</span>
                <span class="pct">0%</span>
            </div>
            <div class="legend-item-row">
                <span class="dot" style="background: #10B981;"></span>
                <span class="name">Completed</span>
                <span class="val">@projCompleted</span>
                <span class="pct">@((totalProjects > 0 ? (projCompleted * 100.0 / totalProjects) : 0).ToString("0"))%</span>
            </div>
        </div>
    </div>

    <!-- Budget Overview Line Chart -->
    <div class="dash-card">
        <div class="card-header">
            <h3>Budget Overview</h3>
            <a href="/Budget" class="view-all">View all</a>
        </div>
        <div class="chart-container">
            <canvas id="budgetSpentChart"></canvas>
        </div>
    </div>

    <!-- Expenses by Category Chart -->
    <div class="dash-card">
        <div class="card-header">
            <h3>Expenses by Category</h3>
            <a href="/Budget" class="view-all">View all</a>
        </div>
        <div class="chart-container-relative">
            <canvas id="categoryExpenseChart"></canvas>
            <div class="chart-center-text">
                <span class="center-value">@FormatCrore(totalExpenses)</span>
                <span class="center-label">Total</span>
            </div>
        </div>
        <div class="chart-legend-grid">
            @foreach (var cat in ViewBag.CategoryExpenses as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>())
            {
                <div class="legend-item-row">
                    <span class="dot" style="background: #1D4ED8;"></span>
                    <span class="name">@cat.Category</span>
                    <span class="val">@FormatCrore(cat.Total)</span>
                    <span class="pct">@((totalExpenses > 0 ? (cat.Total * 100.0 / (double)totalExpenses) : 0).ToString("0"))%</span>
                </div>
            }
        </div>
    </div>
</div>

<!-- Tables Row -->
<div class="dashboard-row grid-2">
    <!-- Recent Projects Table -->
    <div class="dash-card">
        <div class="card-header">
            <h3>Recent Projects</h3>
            <a href="/Projects" class="view-all">View all</a>
        </div>
        <div class="table-responsive">
            <table class="dash-table">
                <thead>
                    <tr>
                        <th>Project Name</th>
                        <th>Status</th>
                        <th>Progress</th>
                        <th>Budget</th>
                        <th>Due Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in projects)
                    {
                        var pct = p.PhaseProgressPct ?? 0;
                        <tr>
                            <td>
                                <div class="project-cell">
                                    <div class="icon-sm" style="background:#EFF6FF; color:#1D4ED8;">
                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/></svg>
                                    </div>
                                    @p.ProjectName
                                </div>
                            </td>
                            <td><span class="badge @(p.IsCompleted ? "badge-success" : "badge-primary")">@(p.IsCompleted ? "Completed" : "In Progress")</span></td>
                            <td>
                                <div class="prog-row">
                                    <span class="prog-val">@pct.ToString("0")%</span>
                                    <div class="prog-bar-container"><div class="prog-bar" style="width: @pct.ToString("0")%;"></div></div>
                                </div>
                            </td>
                            <td>@FormatCrore(p.TotalBudget)</td>
                            <td>
                                <div class="date-cell">
                                    @p.ExpectedEndDate?.ToString("MMM dd, yyyy")
                                    <span class="date-meta">@(p.IsCompleted ? "Completed" : "15 days left")</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Recent Expenses Table -->
    <div class="dash-card">
        <div class="card-header">
            <h3>Recent Expenses</h3>
            <a href="/Budget" class="view-all">View all</a>
        </div>
        <div class="table-responsive">
            <table class="dash-table">
                <thead>
                    <tr>
                        <th>Description</th>
                        <th>Category</th>
                        <th>Amount</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var exp in recentExpenses)
                    {
                        <tr>
                            <td>@exp.Description</td>
                            <td><span class="badge badge-soft-blue">@exp.CategoryName</span></td>
                            <td class="font-bold">@FormatCrore(exp.Amount)</td>
                            <td class="text-muted">@exp.ExpenseDate.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Bottom Summary Row -->
<div class="dashboard-row grid-2">
    <!-- Tasks Overview -->
    <div class="dash-card summary-card">
        <div class="summary-header">
            <div class="icon-box-lg" style="background: #F5F3FF; color: #8B5CF6;">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            </div>
            <div class="summary-info">
                <h2 class="summary-value">@totalTasks</h2>
                <span class="summary-label">Total Tasks</span>
            </div>
            <a href="/Workers" class="view-all">View all</a>
        </div>
        <div class="summary-stats">
            <div class="s-item">
                <span class="s-val">@tasksToDo</span>
                <span class="s-lab"><span class="dot" style="background:#94A3B8;"></span> To Do</span>
            </div>
            <div class="s-item">
                <span class="s-val">@tasksInProgress</span>
                <span class="s-lab"><span class="dot" style="background:#1D4ED8;"></span> In Progress</span>
            </div>
            <div class="s-item">
                <span class="s-val">@tasksCompleted</span>
                <span class="s-lab"><span class="dot" style="background:#10B981;"></span> Completed</span>
            </div>
            <div class="s-item">
                <span class="s-val" style="color: #EF4444;">@tasksOverdue</span>
                <span class="s-lab"><span class="dot" style="background:#EF4444;"></span> Overdue</span>
            </div>
        </div>
    </div>

    <!-- Active Workers -->
    <div class="dash-card summary-card">
        <div class="summary-header">
            <div class="icon-box-lg" style="background: #ECFDF5; color: #10B981;">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </div>
            <div class="summary-info">
                <h2 class="summary-value">@totalWorkers</h2>
                <span class="summary-label">Active Workers</span>
            </div>
            <a href="/Workers" class="view-all">View all</a>
        </div>
        <div class="summary-stats">
            <div class="s-item">
                <span class="s-val">@workersOnSite</span>
                <span class="s-lab"><span class="dot" style="background:#10B981;"></span> On Site</span>
            </div>
            <div class="s-item">
                <span class="s-val">@workersOffSite</span>
                <span class="s-lab"><span class="dot" style="background:#F59E0B;"></span> Off Site</span>
            </div>
            <div class="s-item">
                <span class="s-val">@workersOnLeave</span>
                <span class="s-lab"><span class="dot" style="background:#EF4444;"></span> On Leave</span>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    function updateDateDisplay(val) {
        if (!val) return;
        const date = new Date(val);
        const options = { month: 'short', day: '2-digit', year: 'numeric' };
        document.getElementById('dateDisplay').innerText = date.toLocaleDateString('en-US', options);
    }

    // Chart common defaults
    Chart.defaults.font.family = "'Inter', sans-serif";
    Chart.defaults.color = '#64748B';

    // 1. Project Progress Doughnut
    new Chart(document.getElementById('projectProgressChart'), {
        type: 'doughnut',
        data: {
            datasets: [{
                data: [@projNotStarted, @projInProgress, @projOnHold, @projCompleted],
                backgroundColor: ['#94A3B8', '#1D4ED8', '#F59E0B', '#10B981'],
                borderWidth: 0,
                cutout: '80%'
            }]
        },
        options: {
            plugins: { legend: { display: false } },
            maintainAspectRatio: false
        }
    });

    // 2. Budget vs Spent Line Chart
    new Chart(document.getElementById('budgetSpentChart'), {
        type: 'line',
        data: {
            labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
            datasets: [
                {
                    label: 'Budget',
                    data: [1, 1.2, 1.5, 1.8, 2.2, 2.45], // Mock historical growth
                    borderColor: '#1D4ED8',
                    backgroundColor: 'rgba(29, 78, 216, 0.05)',
                    fill: true,
                    tension: 0.4
                },
                {
                    label: 'Spent',
                    data: [0.8, 0.9, 1.1, 1.2, 1.4, 1.62],
                    borderColor: '#10B981',
                    backgroundColor: 'rgba(16, 185, 129, 0.05)',
                    fill: true,
                    tension: 0.4
                }
            ]
        },
        options: {
            plugins: { legend: { position: 'bottom' } },
            maintainAspectRatio: false,
            scales: {
                y: {
                    ticks: { callback: value => '₹' + value + 'Cr' }
                }
            }
        }
    });

    // 3. Category Expenses Doughnut
    new Chart(document.getElementById('categoryExpenseChart'), {
        type: 'doughnut',
        data: {
            datasets: [{
                data: [45, 32, 18, 5], // Mock values for demo
                backgroundColor: ['#1D4ED8', '#10B981', '#F59E0B', '#EF4444'],
                borderWidth: 0,
                cutout: '80%'
            }]
        },
        options: {
            plugins: { legend: { display: false } },
            maintainAspectRatio: false
        }
    });
</script>
