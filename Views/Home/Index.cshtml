                        <div style="display: flex; align-items: center; gap: 6px; font-size: 0.6875rem;"><div style="width: 8px; height: 8px; border-radius: 50%; background: #60A5FA;"></div> Material Cost<br><span style="margin-left: 14px; font-weight: 600;">₹ 0.85 Cr</span></div>
                        <div style="display: flex; align-items: center; gap: 6px; font-size: 0.6875rem;"><div style="width: 8px; height: 8px; border-radius: 50%; background: #93C5FD;"></div> Equipment<br><span style="margin-left: 14px; font-weight: 600;">₹ 0.30 Cr</span></div>
                    </div>
                </div>
            </div>

            <!-- Recent Activities -->
            <div style="border: 1px solid #E2E8F0; border-radius: 12px; padding: 16px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <div style="font-weight: 600; font-size: 0.875rem;">Recent Activities</div>
                    <div style="font-size: 0.6875rem; color: #64748B;">View all</div>
                </div>
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div style="display: flex; gap: 12px; align-items: flex-start;">
                        <div style="width: 24px; height: 24px; background: #FFFBEB; color: #F59E0B; border-radius: 6px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg></div>
                        <div style="flex: 1;">
                            <div style="font-size: 0.75rem; font-weight: 500;">Site inspection completed</div>
                            <div style="font-size: 0.6875rem; color: #64748B;">Green Valley Apartments</div>
                        </div>
                        <div style="font-size: 0.625rem; color: #94A3B8;">2h ago</div>
                    </div>
                    <div style="display: flex; gap: 12px; align-items: flex-start;">
                        <div style="width: 24px; height: 24px; background: #F1F5F9; color: #0F172A; border-radius: 6px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg></div>
                        <div style="flex: 1;">
                            <div style="font-size: 0.75rem; font-weight: 500;">Expense added: ₹ 45,000</div>
                            <div style="font-size: 0.6875rem; color: #64748B;">Skyline Tower</div>
                        </div>
                        <div style="font-size: 0.625rem; color: #94A3B8;">5h ago</div>
                    </div>
                    <div style="display: flex; gap: 12px; align-items: flex-start;">
                        <div style="width: 24px; height: 24px; background: #EFF6FF; color: #1D4ED8; border-radius: 6px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg></div>
                        <div style="flex: 1;">
                            <div style="font-size: 0.75rem; font-weight: 500;">New team member added</div>
                            <div style="font-size: 0.6875rem; color: #64748B;">Sunrise Villas</div>
                        </div>
                        <div style="font-size: 0.625rem; color: #94A3B8;">2d ago</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
  </div>


<!-- ══════════════ LOGOS BAR ══════════════ -->
