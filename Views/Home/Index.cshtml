                    <div style="background: #F5F3FF; color: #8B5CF6; width: 36px; height: 36px; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                    </div>
                    <div style="font-size: 0.75rem; color: #64748B;">Total Budget</div>
                </div>
                <div style="font-size: 1.5rem; font-weight: 700; color: #0F172A; margin-bottom: 4px;">₹ 2.45 Cr</div>
                <div style="font-size: 0.75rem; color: #0F172A; font-weight: 500;">66% utilized</div>
            </div>
            <div style="border: 1px solid #E2E8F0; border-radius: 12px; padding: 16px;">
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                    <div style="background: #FFFBEB; color: #F59E0B; width: 36px; height: 36px; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                    </div>
                    <div style="font-size: 0.75rem; color: #64748B;">Total Expenses</div>
                </div>
                <div style="font-size: 1.5rem; font-weight: 700; color: #0F172A; margin-bottom: 4px;">₹ 1.62 Cr</div>
                <div style="font-size: 0.75rem; color: #0F172A; font-weight: 500;">66% of budget</div>
            </div>
        </div>

        <!-- 3 Columns -->
        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px;">
            <!-- Progress -->
            <div style="border: 1px solid #E2E8F0; border-radius: 12px; padding: 16px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
