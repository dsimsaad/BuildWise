                    </div>
                    <div>
                        <div style="display: flex; justify-content: space-between; font-size: 0.75rem; margin-bottom: 6px;">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <div style="width: 24px; height: 24px; background: #E2E8F0; border-radius: 4px;"></div>
                                <span style="font-weight: 500;">Skyline Tower</span>
                            </div>
                            <span>45%</span>
                        </div>
                        <div style="height: 6px; background: #F1F5F9; border-radius: 3px; overflow: hidden;"><div style="height: 100%; width: 45%; background: #1D4ED8;"></div></div>
                    </div>
                    <div>
                        <div style="display: flex; justify-content: space-between; font-size: 0.75rem; margin-bottom: 6px;">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <div style="width: 24px; height: 24px; background: #E2E8F0; border-radius: 4px;"></div>
                                <span style="font-weight: 500;">Heritage Plaza</span>
                            </div>
                            <span>30%</span>
                        </div>
                        <div style="height: 6px; background: #F1F5F9; border-radius: 3px; overflow: hidden;"><div style="height: 100%; width: 30%; background: #1D4ED8;"></div></div>
                    </div>
                </div>
            </div>

            <!-- Budget Chart -->
            <div style="border: 1px solid #E2E8F0; border-radius: 12px; padding: 16px;">
                <div style="font-weight: 600; font-size: 0.875rem; margin-bottom: 16px;">Budget Overview</div>
