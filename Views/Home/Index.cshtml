@{
    ViewData["Title"] = "Home Page";
    Layout = "_MarketingLayout";
}

<!-- ══════════════ HERO ══════════════ -->
<section class="hero">
  <!-- Background Decorative Elements -->
  <div class="bg-shape shape-1"></div>
  <div class="bg-shape shape-2"></div>
  <div class="bg-shape shape-3"></div>
  <div class="bg-shape shape-4"></div>
  <div class="dot-pattern dots-1"></div>
  <div class="dot-pattern dots-2"></div>
  <div class="dot-pattern dots-3"></div>
  <div class="dot-pattern dots-4"></div>

  <div class="hero-inner reveal" id="hero-header">
    <div class="hero-eyebrow-wrap">
        <span class="hero-eyebrow">Construction Management Made Simple</span>
    </div>
    <h1>Track Your Construction Site.<br>Without the Chaos.</h1>
    <p class="hero-sub">BuildWise helps you manage projects, track progress, organize teams, manage materials, and control budgets — all in one place.</p>
    
    <div class="hero-buttons">
      <a href="/Home/Login" class="btn-primary">Start Tracking Now &nbsp;→</a>
      <a href="#" class="btn-outline">
        <div class="play-icon-simple">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
        </div>
        View Demo
      </a>
    </div>

    <div class="hero-badges">
      <span class="hero-badge">
        <div class="check-icon-simple">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        Easy to Use
      </span>
      <span class="hero-badge">
        <div class="check-icon-simple">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        Real-time Updates
      </span>
      <span class="hero-badge">
        <div class="check-icon-simple">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        Secure &amp; Reliable
      </span>
    </div>
  </div>

  <!-- Dashboard Mockup (Matching the provided design) -->
  <div class="hero-dashboard-mockup reveal" style="max-width: 1100px; margin: 60px auto 0; background: white; border-radius: 20px; box-shadow: 0 24px 64px -12px rgba(15, 23, 42, 0.15); border: 1px solid #E2E8F0; overflow: hidden; display: flex; text-align: left;">
    
    <!-- Mockup Sidebar -->
    <div style="width: 240px; border-right: 1px solid #E2E8F0; padding: 24px 16px; background: #FAFAF9;">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 32px; padding: 0 8px;">
            <img src="/logo.png" alt="BuildWise" style="width: 28px; height: 28px;">
            <span style="font-weight: 700; color: #0F172A; font-size: 1.125rem;">BuildWise</span>
        </div>
        <div style="display: flex; flex-direction: column; gap: 4px;">
            <div style="display: flex; align-items: center; gap: 12px; padding: 10px 12px; background: #EFF6FF; color: #1D4ED8; border-radius: 8px; font-weight: 600; font-size: 0.875rem;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
