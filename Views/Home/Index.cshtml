@{
    ViewData["Title"] = "Home Page";
    Layout = "_MarketingLayout";
}


<section class="hero">
  
  <div class="bg-shape shape-1"></div>
  <div class="bg-shape shape-2"></div>
  <div class="bg-shape shape-3"></div>
  <div class="bg-shape shape-4"></div>
  <div class="dot-pattern dots-1"></div>
  <div class="dot-pattern dots-2"></div>
  <div class="dot-pattern dots-3"></div>
  <div class="dot-pattern dots-4"></div>

  <div class="hero-inner reveal" id="hero-header">
    <div class="hero-eyebrow-wrap">
        <span class="hero-eyebrow">Construction Management Made Simple</span>
    </div>
    <h1>Track Your Construction Site.<br>Without the Chaos.</h1>
    <p class="hero-sub">BuildWise helps you manage projects, track progress, organize teams, manage materials, and control budgets - all in one place.</p>

    <div class="hero-buttons">
      <a href="/Home/Login" class="btn-primary">Start Tracking Now &nbsp;&rarr;</a>
      <a href="/Home/Features" class="btn-outline">
        <div class="play-icon-simple">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12h18"></path>
            <path d="M13 5l7 7-7 7"></path>
          </svg>
        </div>
        Explore Features
      </a>
    </div>

    <div class="hero-badges">
      <span class="hero-badge">
        <div class="check-icon-simple">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        Project Tracking
      </span>
      <span class="hero-badge">
        <div class="check-icon-simple">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        Budget Summaries
      </span>
      <span class="hero-badge">
        <div class="check-icon-simple">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        Material Records
      </span>
    </div>
  </div>

  
  <div class="hero-dashboard-mockup reveal">
    <img src="~/assets/images/dashboard-current.png" alt="BuildWise dashboard summary screen" width="1440" height="920" loading="lazy" fetchpriority="low" decoding="async" asp-append-version="true" />
  </div>
</section>


<section class="features-section">
  <div class="features-inner">
    <span class="section-eyebrow">Why BuildWise?</span>
    <h2 class="section-title reveal">Practical Tools for Construction Tracking</h2>
    <div class="features-grid">
      
      <div class="feature-card reveal">
        <div class="feature-icon-wrap">
          <lord-icon
              src="https://cdn.lordicon.com/kdduutaw.json"
              stroke="bold"
              colors="primary:#1E40AF,secondary:#1D4ED8"
              style="width:32px;height:32px">
          </lord-icon>
        </div>
        <h3>Projects &amp; Properties</h3>
        <p>Create projects, connect them with properties, and keep basic site information organized.</p>
        <div class="feature-bullets">
          <span class="bullet-tag">Project Records</span>
          <span class="bullet-tag">Property Details</span>
          <span class="bullet-tag">Status Tracking</span>
        </div>
      </div>

      
      <div class="feature-card reveal">
        <div class="feature-icon-wrap">
          <lord-icon
              src="https://cdn.lordicon.com/wjyqkiew.json"
              stroke="bold"
              colors="primary:#1E40AF,secondary:#1D4ED8"
              style="width:32px;height:32px">
          </lord-icon>
        </div>
        <h3>Budgets &amp; Expenses</h3>
        <p>Record budget items and expenses so project spending is easier to review and compare.</p>
        <div class="feature-bullets">
          <span class="bullet-tag">Budget Items</span>
          <span class="bullet-tag">Expense Logs</span>
          <span class="bullet-tag">Spending Summary</span>
        </div>
      </div>

      
      <div class="feature-card reveal">
        <div class="feature-icon-wrap">
          <lord-icon
              src="https://cdn.lordicon.com/lvrxlmju.json"
              stroke="bold"
              colors="primary:#1e3a8a"
              style="width:32px;height:32px">
          </lord-icon>
        </div>
        <h3>Workers &amp; Wages</h3>
        <p>Manage worker records, daily wage values, active status, and project assignments.</p>
        <div class="feature-bullets">
          <span class="bullet-tag">Worker List</span>
          <span class="bullet-tag">Daily Wages</span>
          <span class="bullet-tag">Assignments</span>
        </div>
      </div>

      
      <div class="feature-card reveal">
        <div class="feature-icon-wrap">
          <lord-icon
              src="https://cdn.lordicon.com/hmpomorl.json"
              stroke="bold"
              colors="primary:#1E40AF,secondary:#1D4ED8"
              style="width:32px;height:32px">
          </lord-icon>
        </div>
        <h3>Materials &amp; Phases</h3>
        <p>Track material purchases and construction phases with tasks connected to project progress.</p>
        <div class="feature-bullets">
          <span class="bullet-tag">Purchases</span>
          <span class="bullet-tag">Phase Tasks</span>
          <span class="bullet-tag">Progress View</span>
        </div>
      </div>

      <div class="feature-card reveal">
        <div class="feature-icon-wrap">
          <lord-icon
              src="https://cdn.lordicon.com/hmpomorl.json"
              stroke="bold"
              colors="primary:#1E40AF,secondary:#1D4ED8"
              style="width:32px;height:32px">
          </lord-icon>
        </div>
        <h3>Dashboard Summaries</h3>
        <p>Review project progress, workers, properties, budgets, expenses, and recent activity from the dashboard.</p>
        <div class="feature-bullets">
          <span class="bullet-tag">KPIs</span>
          <span class="bullet-tag">Charts</span>
          <span class="bullet-tag">Reports</span>
        </div>
      </div>

      <div class="feature-card reveal">
        <div class="feature-icon-wrap">
          <lord-icon
              src="https://cdn.lordicon.com/jeuxydnh.json"
              stroke="bold"
              colors="primary:#1E40AF,secondary:#1D4ED8"
              style="width:32px;height:32px">
          </lord-icon>
        </div>
        <h3>Cost Advisor Checks</h3>
        <p>Use advisor checks to review budget usage and project spending patterns from stored data.</p>
        <div class="feature-bullets">
          <span class="bullet-tag">Budget Usage</span>
          <span class="bullet-tag">Alerts</span>
          <span class="bullet-tag">Advisor Page</span>
        </div>
      </div>
    </div>
  </div>
</section>


<section class="cta-section">
  <div class="cta-inner reveal">
    <svg class="cta-crane" viewBox="0 0 64 64" fill="none" stroke="rgba(255,255,255,0.8)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="28" y="32" width="8" height="24" rx="1"/>
      <line x1="32" y1="32" x2="32" y2="8"/>
      <line x1="32" y1="8" x2="56" y2="8"/>
      <line x1="32" y1="8" x2="14" y2="20"/>
      <line x1="56" y1="8" x2="56" y2="20"/>
      <line x1="48" y1="20" x2="56" y2="20"/>
      <rect x="20" y="52" width="24" height="4" rx="1"/>
    </svg>
    <div class="cta-text">
      <h2>Ready to take control of your construction site?</h2>
      <p>Start organizing projects, budgets, expenses, workers, materials, and progress in one workspace.</p>
    </div>
    <a href="/Home/Login" class="btn-cta">Get Started Now &nbsp;&rarr;</a>
  </div>
</section>
