@{
    ViewData["Title"] = "features";
    Layout = "_MarketingLayout";
}


  <!-- ── HERO ── -->
  <section class="feat-hero">
    <div class="hero-inner reveal">
      <span class="hero-eyebrow">Precision Project Management</span>
      <h1>Stop Cost Overruns <br>Before They Even Start.</h1>
      <p>Moving your construction management from paper to digital isn't just an upgrade — it's a profit strategy. Track
        every bag of cement and every labor hour in real-time.</p>
      <div class="hero-btns">
        <a href="/Home/Login" class="btn-hero-primary">Explore Features &nbsp;→</a>
        <a href="#" class="btn-hero-outline">
          <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" />
            <polygon points="10 8 16 12 10 16 10 8" />
          </svg>
          Watch Product Demo
        </a>
      </div>
    </div>
  </section>

  <!-- ── FEATURES GROUP 1 ── -->
  <section class="feat-section">
    <div class="feat-section-inner">
      <div class="section-head">
        <span class="section-eyebrow">Core Features</span>
        <h2 class="reveal">Everything You Need to Scale</h2>
        <p>BuildWise brings clarity to every corner of your construction site — from labor hours to material costs.</p>
      </div>
      <div class="feat-grid">

        <div class="feat-card reveal">
          <div class="feat-card-icon">
            <lord-icon src="https://cdn.lordicon.com/kdduutaw.json" stroke="bold"
              colors="primary:#1E40AF,secondary:#1D4ED8" style="width:38px;height:38px"></lord-icon>
          </div>
          <h3>Digital Attendance</h3>
          <p>Ditch the registers. Log worker check-ins and check-outs with location verification and photo evidence to
            eliminate ghost labor.</p>
          <div class="feat-card-links">
            <span class="bullet-tag">Overtime Tracking</span>
            <span class="bullet-tag">Muster Reports</span>
          </div>
        </div>

        <div class="feat-card reveal">
          <div class="feat-card-icon">
            <lord-icon src="https://cdn.lordicon.com/wjyqkiew.json" stroke="bold"
              colors="primary:#1E40AF,secondary:#1D4ED8" style="width:38px;height:38px"></lord-icon>
          </div>
          <h3>Wage Management</h3>
          <p>Calculate daily and weekly payouts automatically based on attendance. Manage advances and deductions
            without manual errors.</p>
          <div class="feat-card-links">
            <span class="bullet-tag">Advance Tracking</span>
            <span class="bullet-tag">Payroll Auto-gen</span>
          </div>
        </div>

        <div class="feat-card reveal">
          <div class="feat-card-icon">
            <lord-icon src="https://cdn.lordicon.com/lvrxlmju.json" stroke="bold"
              colors="primary:#1e3a8a" style="width:38px;height:38px"></lord-icon>
          </div>
          <h3>Material Intelligence</h3>
          <p>Monitor supply deliveries and usage. Get notified when material wastage exceeds project benchmarks to
            protect your margins.</p>
          <div class="feat-card-links">
            <span class="bullet-tag">Supplier Comparison</span>
            <span class="bullet-tag">Leak Detection</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── FEATURES GROUP 2 ── -->
  <section class="feat-section">
    <div class="feat-section-inner">
      <div class="section-head">
        <span class="section-eyebrow">Advanced Tools</span>
        <h2 class="reveal">Built for Growth & Scale</h2>
        <p>From financial forecasting to multi-site management, BuildWise gives you the intelligence to stay ahead.</p>
      </div>
      <div class="feat-grid">

        <div class="feat-card reveal">
          <div class="feat-card-icon">
            <lord-icon src="https://cdn.lordicon.com/hmpomorl.json" stroke="bold"
              colors="primary:#1E40AF,secondary:#1D4ED8" style="width:38px;height:38px"></lord-icon>
          </div>
          <h3>Financial Analytics</h3>
          <p>Visual dashboards showing Labor vs Material vs Overhead costs. Know exactly if you're making a profit on
            every project.</p>
          <div class="feat-card-links">
            <span class="bullet-tag">P&L Forecasts</span>
            <span class="bullet-tag">Tax Reporting</span>
          </div>
        </div>

        <div class="feat-card reveal">
          <div class="feat-card-icon">
            <lord-icon src="https://cdn.lordicon.com/jeuxydnh.json" stroke="bold"
              colors="primary:#1E40AF,secondary:#1D4ED8" style="width:38px;height:38px"></lord-icon>
          </div>
          <h3>Project Milestones</h3>
          <p>Set construction phases and track progress against timelines. Automatically link labor costs to specific
            milestones reached.</p>
          <div class="feat-card-links">
            <span class="bullet-tag">Gantt Views</span>
            <span class="bullet-tag">Delayed Alerts</span>
          </div>
        </div>

        <div class="feat-card reveal">
          <div class="feat-card-icon">
            <lord-icon src="https://cdn.lordicon.com/dicvhxpz.json" stroke="bold"
              colors="primary:#1E40AF,secondary:#1D4ED8" style="width:38px;height:38px"></lord-icon>
          </div>
          <h3>Multi-Project View</h3>
          <p>Managing multiple sites? See real-time data from all your construction projects in a single, unified
            executive command center.</p>
          <div class="feat-card-links">
            <span class="bullet-tag">Resource Usage</span>
            <span class="bullet-tag">Cross-site Benchmarking</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="feat-cta reveal">
    <h2>Ready to take control of your construction sites?</h2>
    <p>Join over 500+ contractors who have reduced their material wastage by 15% using BuildWise.</p>
    <div class="cta-btns">
      <a href="/Home/Login" class="cta-primary">Get Started Now &nbsp;→</a>
      <a href="/Home/Contact" class="cta-outline">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10" />
          <polygon points="10 8 16 12 10 16 10 8" />
        </svg>
        Book a Demo
      </a>
    </div>
  </section>

  <!-- ══════════════ FOOTER ══════════════ -->
  
