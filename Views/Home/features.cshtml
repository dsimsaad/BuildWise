@{
    ViewData["Title"] = "Features";
    Layout = "_MarketingLayout";
}

<section class="feat-hero">
  <div class="hero-inner reveal">
    <span class="hero-eyebrow">BuildWise Features</span>
    <h1>Manage Construction Work From One Place.</h1>
    <p>BuildWise focuses on the practical records a construction project needs: projects, properties, budgets, expenses, workers, materials, phases, tasks, and dashboard summaries.</p>
    <div class="hero-btns">
      <a href="/Home/Login" class="btn-hero-primary">Get Started &nbsp;&rarr;</a>
      <a href="/Home/Contact" class="btn-hero-outline">
        <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a4 4 0 0 1-4 4H7l-4 4V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z" />
        </svg>
        Contact Us
      </a>
    </div>
  </div>
</section>

<section class="feat-section">
  <div class="feat-section-inner">
    <div class="section-head">
      <span class="section-eyebrow">Core Records</span>
      <h2 class="reveal">Keep Project Information Organized</h2>
      <p>Use structured pages for the main parts of a construction project instead of scattered notes and spreadsheets.</p>
    </div>
    <div class="feat-grid">

      <div class="feat-card reveal">
        <div class="feat-card-icon">
          <lord-icon src="https://cdn.lordicon.com/jeuxydnh.json" stroke="bold"
            colors="primary:#1E40AF,secondary:#1D4ED8" style="width:38px;height:38px"></lord-icon>
        </div>
        <h3>Projects &amp; Properties</h3>
        <p>Create projects, assign property details, track status, and keep location, area, and notes in one place.</p>
        <div class="feat-card-links">
          <span class="bullet-tag">Project List</span>
          <span class="bullet-tag">Property Details</span>
        </div>
      </div>

      <div class="feat-card reveal">
        <div class="feat-card-icon">
          <lord-icon src="https://cdn.lordicon.com/hmpomorl.json" stroke="bold"
            colors="primary:#1E40AF,secondary:#1D4ED8" style="width:38px;height:38px"></lord-icon>
        </div>
        <h3>Budgets &amp; Expenses</h3>
        <p>Set budget records, add expense items, and compare planned amounts with actual project spending.</p>
        <div class="feat-card-links">
          <span class="bullet-tag">Budget Items</span>
          <span class="bullet-tag">Expense History</span>
        </div>
      </div>

      <div class="feat-card reveal">
        <div class="feat-card-icon">
          <lord-icon src="https://cdn.lordicon.com/kdduutaw.json" stroke="bold"
            colors="primary:#1E40AF,secondary:#1D4ED8" style="width:38px;height:38px"></lord-icon>
        </div>
        <h3>Workers &amp; Wages</h3>
        <p>Maintain worker profiles, daily wage rates, active status, and project assignments for site teams.</p>
        <div class="feat-card-links">
          <span class="bullet-tag">Worker Records</span>
          <span class="bullet-tag">Daily Wages</span>
        </div>
      </div>

    </div>
  </div>
</section>

<section class="feat-section">
  <div class="feat-section-inner">
    <div class="section-head">
      <span class="section-eyebrow">Project Tracking</span>
      <h2 class="reveal">Follow Materials, Phases, and Progress</h2>
      <p>BuildWise connects construction activity with financial and project tracking views.</p>
    </div>
    <div class="feat-grid">

      <div class="feat-card reveal">
        <div class="feat-card-icon">
          <lord-icon src="https://cdn.lordicon.com/wjyqkiew.json" stroke="bold"
            colors="primary:#1E40AF,secondary:#1D4ED8" style="width:38px;height:38px"></lord-icon>
        </div>
        <h3>Materials</h3>
        <p>Manage the material catalog and record material purchases with quantity, unit, cost, and supplier details when available.</p>
        <div class="feat-card-links">
          <span class="bullet-tag">Catalog</span>
          <span class="bullet-tag">Purchases</span>
        </div>
      </div>

      <div class="feat-card reveal">
        <div class="feat-card-icon">
          <lord-icon src="https://cdn.lordicon.com/lvrxlmju.json" stroke="bold"
            colors="primary:#1e3a8a" style="width:38px;height:38px"></lord-icon>
        </div>
        <h3>Construction Phases</h3>
        <p>Add phases, create tasks, update completion status, and use task progress to understand project movement.</p>
        <div class="feat-card-links">
          <span class="bullet-tag">Phases</span>
          <span class="bullet-tag">Tasks</span>
        </div>
      </div>

      <div class="feat-card reveal">
        <div class="feat-card-icon">
          <lord-icon src="https://cdn.lordicon.com/dicvhxpz.json" stroke="bold"
            colors="primary:#1E40AF,secondary:#1D4ED8" style="width:38px;height:38px"></lord-icon>
        </div>
        <h3>Dashboard &amp; Reports</h3>
        <p>Review dashboard KPIs, recent expenses, progress summaries, budget usage, and downloadable project reports.</p>
        <div class="feat-card-links">
          <span class="bullet-tag">Dashboard</span>
          <span class="bullet-tag">PDF Reports</span>
        </div>
      </div>

    </div>
  </div>
</section>

<section class="feat-cta reveal">
  <h2>Organize your construction data clearly.</h2>
  <p>Use BuildWise to keep project records, costs, workers, materials, and progress connected in one workspace.</p>
  <div class="cta-btns">
    <a href="/Home/Login" class="cta-primary">Get Started &nbsp;&rarr;</a>
    <a href="/Home/Contact" class="cta-outline">
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a4 4 0 0 1-4 4H7l-4 4V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z" />
      </svg>
      Contact Us
    </a>
  </div>
</section>
