@{
    ViewData["Title"] = "Contact";
    ViewData["DashboardContentClass"] = "marketing-page-content";
    Layout = User.Identity?.IsAuthenticated == true ? "_ModuleLayout" : "_MarketingLayout";
}

@section Styles {
  @if (User.Identity?.IsAuthenticated == true)
  {
    <style>
      .dash-content.marketing-page-content { padding: 0; background: #F8FAFC; }
      .contact-section { padding: 48px 28px 64px; }
      .contact-wrapper { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 32px; align-items: start; }
      .contact-info, .contact-form-card { background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 3px; box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04); }
      .contact-info { padding: 32px; }
      .contact-eyebrow { display: inline-flex; color: #1D4ED8; background: #EFF6FF; border: 1px solid #DBEAFE; border-radius: 3px; padding: 5px 10px; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 16px; }
      .contact-info h1 { margin: 0 0 12px; color: #0F172A; font-size: 2rem; font-weight: 800; letter-spacing: -0.3px; }
      .contact-info > p { margin: 0 0 28px; color: #64748B; line-height: 1.7; }
      .details-card { border-top: 1px solid #E2E8F0; padding-top: 22px; }
      .details-card h3 { margin: 0 0 16px; font-size: 1rem; color: #0F172A; }
      .detail-item { display: flex; gap: 12px; align-items: center; padding: 12px 0; }
      .detail-icon { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; background: #EFF6FF; color: #1D4ED8; border-radius: 3px; }
      .detail-icon svg { width: 18px; height: 18px; }
      .detail-text strong { display: block; color: #0F172A; font-size: 0.84rem; }
      .detail-text a { color: #1D4ED8; text-decoration: none; font-weight: 600; font-size: 0.9rem; }
      .contact-form-card { padding: 32px; }
      .contact-form-card h2 { margin: 0 0 22px; color: #0F172A; font-size: 1.25rem; }
      .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
      .input-group { display: grid; gap: 7px; margin-bottom: 14px; }
      .input-group label { color: #1E3A8A; font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.055em; }
      .input-group input, .input-group textarea { width: 100%; border: 1px solid #C9D9EE; background: #F8FBFF; border-radius: 3px; padding: 11px 13px; color: #0F172A; font: inherit; box-sizing: border-box; }
      .input-group textarea { min-height: 128px; resize: vertical; }
      .input-group input:focus, .input-group textarea:focus { outline: none; background: #FFFFFF; border-color: #1D4ED8; box-shadow: inset 3px 0 0 #1D4ED8, 0 0 0 3px rgba(29, 78, 216, 0.08); }
      .btn-submit { border: 0; background: #1D4ED8; color: #FFFFFF; border-radius: 3px; padding: 11px 18px; font-weight: 800; cursor: pointer; }
      .btn-submit:hover { background: #1E40AF; }
      @@media (max-width: 860px) {
        .contact-wrapper, .form-row { grid-template-columns: 1fr; }
      }
    </style>
  }
}

@section Scripts {
  @if (User.Identity?.IsAuthenticated == true)
  {
    <script>
      document.querySelector(".contact-form")?.addEventListener("submit", event => {
        event.preventDefault();
        const form = event.currentTarget;
        const btn = form.querySelector(".btn-submit");
        if (!btn) return;
        const originalText = btn.innerHTML;
        btn.innerHTML = "Message Sent";
        btn.disabled = true;
        form.reset();
        setTimeout(() => {
          btn.innerHTML = originalText;
          btn.disabled = false;
        }, 1400);
      });
    </script>
  }
}


<!-- ── CONTACT SECTION ── -->
<section class="contact-section">
  <div class="contact-wrapper">
    <!-- Left Column -->
    <div class="contact-info reveal">
      <span class="contact-eyebrow">Get in Touch</span>
      <h1>Contact Us</h1>
      <p>We are available for questions, feedback, or collaboration opportunities. Let us know how we can help!</p>
      
      <div class="details-card">
        <h3>Contact Details</h3>
        
        <div class="detail-item">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <div class="detail-text">
            <strong>Phone</strong>
            <a href="tel:+923360714515">+923360714515</a>
          </div>
        </div>

        <div class="detail-item">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <div class="detail-text">
            <strong>Email</strong>
            <a href="mailto:buildwise.help@gmail.com">buildwise.help@gmail.com</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column -->
    <div class="contact-form-card reveal">
      <h2>Send us a message</h2>
      <form class="contact-form">
        <div class="form-row">
          <div class="input-group">
            <label>First Name</label>
            <input type="text" placeholder="First Name">
          </div>
          <div class="input-group">
            <label>Last Name</label>
            <input type="text" placeholder="Last Name">
          </div>
        </div>
        <div class="input-group">
          <label>Email</label>
          <input type="email" placeholder="you@example.com">
        </div>
        <div class="input-group">
          <label>Subject</label>
          <input type="text" placeholder="How can we help?">
        </div>
        <div class="input-group">
          <label>Message</label>
          <textarea placeholder="Type your message here..."></textarea>
        </div>
        <button type="submit" class="btn-submit">Send Message &nbsp;→</button>
      </form>
    </div>
  </div>
</section>

