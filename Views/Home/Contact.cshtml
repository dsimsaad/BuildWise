@{
    ViewData["Title"] = "Contact";
    ViewData["DashboardContentClass"] = "marketing-page-content";
    Layout = User.Identity?.IsAuthenticated == true ? "_ModuleLayout" : "_MarketingLayout";
}

@section Styles {
  @if (User.Identity?.IsAuthenticated == true)
  {
    <style>
      .dash-content.marketing-page-content { padding: 0; background: #F8FAFC; }
      .contact-section { padding: 76px 28px 80px; background: #f8faff; position: relative; }
      .contact-wrapper { max-width: 1100px; margin: 0 auto; display: flex; gap: 64px; align-items: flex-start; }
      .contact-info { flex: 0 0 320px; }
      .contact-eyebrow { display: inline-block; font-size: 11px; font-weight: 800; letter-spacing: 1px; color: #1D4ED8; text-transform: uppercase; margin-bottom: 16px; background: #EFF6FF; padding: 6px 16px; border-radius: 100px; }
      .contact-info h1 { font-size: 48px; font-weight: 800; color: #0f172a; letter-spacing: -1.5px; line-height: 1.1; margin: 0 0 16px; }
      .contact-info > p { font-size: 15px; color: #64748b; line-height: 1.7; margin: 0 0 40px; }
      .details-card { background: #fff; border-radius: 16px; padding: 28px; box-shadow: 0 4px 18px rgba(15,37,87,0.05); border: 1px solid #eaf0f8; }
      .details-card h3 { font-size: 16px; font-weight: 700; color: #0f172a; margin: 0 0 24px; }
      .detail-item { display: flex; align-items: flex-start; gap: 16px; margin-bottom: 20px; padding: 0; }
      .detail-item:last-child { margin-bottom: 0; }
      .detail-icon { width: 40px; height: 40px; border-radius: 10px; background: #EFF6FF; display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: #1D4ED8; }
      .detail-icon svg { width: 18px; height: 18px; }
      .detail-text strong { display: block; font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px; }
      .detail-text a { font-size: 14px; color: #0f172a; font-weight: 500; text-decoration: none; overflow-wrap: anywhere; }
      .detail-text a:hover { color: #1D4ED8; }
      .contact-form-card { flex: 1; background: #fff; border-radius: 18px; padding: 44px; box-shadow: 0 8px 28px rgba(15,37,87,0.07); border: 1px solid #eaf0f8; }
      .contact-form-card h2 { font-size: 24px; font-weight: 700; color: #0f172a; margin: 0 0 32px; }
      .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
      .input-group { display: grid; gap: 8px; margin-bottom: 16px; }
      .input-group label { color: #1E3A8A; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.055em; }
      .input-group input, .input-group textarea { width: 100%; border: 1px solid #C9D9EE; background: #F8FBFF; border-radius: 10px; padding: 12px 14px; color: #0F172A; font: inherit; box-sizing: border-box; }
      .input-group textarea { min-height: 128px; resize: vertical; }
      .input-group input:focus, .input-group textarea:focus { outline: none; background: #FFFFFF; border-color: #1D4ED8; box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.08); }
      .btn-submit { width: 100%; background: #1D4ED8; color: #fff; border: none; border-radius: 12px; padding: 16px; font-size: 15px; font-weight: 700; cursor: pointer; transition: all .2s ease; font-family: 'Inter', sans-serif; letter-spacing: 0.2px; margin-top: 12px; }
      .btn-submit:hover { background: #1E40AF; transform: translateY(-1px); box-shadow: 0 10px 24px rgba(29, 78, 216, 0.22); }
      .reveal { opacity: 1; transform: none; }
      @@media (max-width: 900px) {
        .contact-wrapper { flex-direction: column; gap: 48px; }
        .contact-info { flex: 1; width: 100%; }
        .form-row { grid-template-columns: 1fr; }
      }
    </style>
  }
}

@section Scripts {
  @if (User.Identity?.IsAuthenticated == true)
  {
    <script>
      document.querySelector(".contact-form")?.addEventListener("submit", event => {
        event.preventDefault();
        const form = event.currentTarget;
        const btn = form.querySelector(".btn-submit");
        if (!btn) return;
        const originalText = btn.innerHTML;
        btn.innerHTML = "Message Sent!";
        btn.disabled = true;
        btn.style.background = "#059669";
        form.reset();
        setTimeout(() => {
          btn.innerHTML = originalText;
          btn.style.background = "";
          btn.disabled = false;
        }, 1800);
      });
    </script>
  }
}


<!-- ── CONTACT SECTION ── -->
<section class="contact-section">
  <div class="contact-wrapper">
    <!-- Left Column -->
    <div class="contact-info reveal">
      <span class="contact-eyebrow">Get in Touch</span>
      <h1>Contact Us</h1>
      <p>We are available for questions, feedback, or collaboration opportunities. Let us know how we can help!</p>
      
      <div class="details-card">
        <h3>Contact Details</h3>
        
        <div class="detail-item">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <div class="detail-text">
            <strong>Phone</strong>
            <a href="tel:+923360714515">+923360714515</a>
          </div>
        </div>

        <div class="detail-item">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <div class="detail-text">
            <strong>Email</strong>
            <a href="mailto:buildwise.help@gmail.com">buildwise.help@gmail.com</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column -->
    <div class="contact-form-card reveal">
      <h2>Send us a message</h2>
      <form class="contact-form">
        <div class="form-row">
          <div class="input-group">
            <label>First Name</label>
            <input type="text" placeholder="First Name">
          </div>
          <div class="input-group">
            <label>Last Name</label>
            <input type="text" placeholder="Last Name">
          </div>
        </div>
        <div class="input-group">
          <label>Email</label>
          <input type="email" placeholder="you@example.com">
        </div>
        <div class="input-group">
          <label>Subject</label>
          <input type="text" placeholder="How can we help?">
        </div>
        <div class="input-group">
          <label>Message</label>
          <textarea placeholder="Type your message here..."></textarea>
        </div>
        <button type="submit" class="btn-submit">Send Message &nbsp;→</button>
      </form>
    </div>
  </div>
</section>

