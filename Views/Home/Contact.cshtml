@{
    ViewData["Title"] = "Contact";
    Layout = User.Identity?.IsAuthenticated == true ? "_ModuleLayout" : "_MarketingLayout";
}


<!-- ── CONTACT SECTION ── -->
<section class="contact-section">
  <div class="contact-wrapper">
    <!-- Left Column -->
    <div class="contact-info reveal">
      <span class="contact-eyebrow">Get in Touch</span>
      <h1>Contact Us</h1>
      <p>We are available for questions, feedback, or collaboration opportunities. Let us know how we can help!</p>
      
      <div class="details-card">
        <h3>Contact Details</h3>
        
        <div class="detail-item">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <div class="detail-text">
            <strong>Phone</strong>
            <span>(123) 34567890</span>
          </div>
        </div>

        <div class="detail-item">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <div class="detail-text">
            <strong>Email</strong>
            <span>hello@buildwise.com</span>
          </div>
        </div>

        <div class="detail-item">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </div>
          <div class="detail-text">
            <strong>Website</strong>
            <span>buildwise.com</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column -->
    <div class="contact-form-card reveal">
      <h2>Send us a message</h2>
      <form class="contact-form">
        <div class="form-row">
          <div class="input-group">
            <label>First Name</label>
            <input type="text" placeholder="First Name">
          </div>
          <div class="input-group">
            <label>Last Name</label>
            <input type="text" placeholder="Last Name">
          </div>
        </div>
        <div class="input-group">
          <label>Email</label>
          <input type="email" placeholder="you@example.com">
        </div>
        <div class="input-group">
          <label>Subject</label>
          <input type="text" placeholder="How can we help?">
        </div>
        <div class="input-group">
          <label>Message</label>
          <textarea placeholder="Type your message here..."></textarea>
        </div>
        <button type="submit" class="btn-submit">Send Message &nbsp;→</button>
      </form>
    </div>
  </div>
</section>

