@{
    ViewData["Title"] = "About Us";
    ViewData["DashboardContentClass"] = "marketing-page-content";
    Layout = User.Identity?.IsAuthenticated == true ? "_ModuleLayout" : "_MarketingLayout";
}

@section Styles {
  <link rel="stylesheet" href="~/assets/css/marketing-pages.css" asp-append-version="true" />
}

<section class="simple-page-hero">
  <div class="simple-page-inner reveal">
    <span class="simple-page-eyebrow">About BuildWise</span>
    <h1>Construction project management made clearer.</h1>
    <p>BuildWise is a student project built to help users manage construction projects, properties, budgets, expenses, workers, materials, and progress in one place.</p>
  </div>
</section>

<section class="simple-page-body">
  <div class="simple-page-grid">
    <article class="simple-info-card reveal">
      <div class="simple-card-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 21h18"></path>
          <path d="M5 21V7h6v14"></path>
          <path d="M13 21V3h6v18"></path>
        </svg>
      </div>
      <h2>What BuildWise Does</h2>
      <p>BuildWise gives construction users a structured workspace for project records. Users can create projects, connect properties, manage budgets, record expenses, track materials, maintain worker records, and follow construction phases and tasks.</p>
      <div class="simple-info-tags">
        <span>Project Records</span>
        <span>Cost Tracking</span>
      </div>
    </article>

    <article class="simple-info-card reveal">
      <div class="simple-card-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 19V5"></path>
          <path d="M4 19h16"></path>
          <path d="m7 14 4-4 3 3 5-6"></path>
        </svg>
      </div>
      <h2>Why It Exists</h2>
      <p>Construction work can become difficult to manage when project details, costs, and progress are stored separately. BuildWise brings those records together so project information is easier to review and update.</p>
      <div class="simple-info-tags">
        <span>Clear Records</span>
        <span>Less Scattered Work</span>
      </div>
    </article>

    <article class="simple-info-card reveal">
      <div class="simple-card-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="16" rx="2"></rect>
          <path d="M7 8h10"></path>
          <path d="M7 12h5"></path>
          <path d="M7 16h8"></path>
        </svg>
      </div>
      <h2>Project Focus</h2>
      <p>The platform focuses on practical construction tracking: dashboard summaries, budgets, expense history, materials, workers, properties, construction phases, and downloadable reports based on stored project data.</p>
      <div class="simple-info-tags">
        <span>Dashboard Summaries</span>
        <span>Reports</span>
      </div>
    </article>
  </div>
</section>
